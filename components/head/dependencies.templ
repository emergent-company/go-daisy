package head

import (
	"github.com/emergent-company/go-daisy/components/behaviors"
	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/staticfs"
)

// Dependencies emits the page's CSS/JS tags.
//
// Every tag carries the render-context CSP nonce (templ.WithNonce) so a host can
// serve a strict `script-src 'nonce-…'` policy. Without a nonce in the context
// the output is byte-identical to the pre-CSP version.
templ Dependencies(props DepsProps) {
	{{ nonce := templ.GetNonce(ctx) }}
	@ui.ThemeScript()
	@behaviors.Tag()
	@templ.Raw(staticfs.Stylesheet("/css/app.css"))
	@templ.Raw(staticfs.ScriptNonce("/js/htmx.js", nonce))
	if props.Alpine {
		@templ.Raw(staticfs.ScriptNonce("/js/alpine.js", nonce))
	}
	if props.Morph {
		@templ.Raw(staticfs.ScriptNonce("/js/morph.js", nonce))
	}
	if props.SSE {
		@templ.Raw(staticfs.ScriptNonce("/js/hx-sse.js", nonce))
	}
	if props.WS {
		@templ.Raw(staticfs.ScriptNonce("/js/hx-ws.js", nonce))
	}
}
