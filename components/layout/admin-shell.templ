package layout

import (
	"github.com/emergent-company/go-daisy/devmode"
)

// AdminShellProps configures the application shell extracted from the Nexus
// reference app. The layout is a horizontal flex row: a fixed sidebar column on
// the left, a growing content column (sticky topbar above the content pane) in
// the middle, and an optional end drawer (rightbar) rendered after the shell.
//
// Sidebar and Content are required. Topbar and Rightbar are optional slots —
// a nil value skips that region.
type AdminShellProps struct {
	Sidebar  templ.Component // required, rendered as the left column
	Topbar   templ.Component // optional, sticky above content
	Rightbar templ.Component // optional, end drawer/drawer-like slot
	Content  templ.Component // required, main content
	Class    string
	Attrs    templ.Attributes
}

// AdminShell renders the app-shell foundation.
//
// The structure mirrors cmd/nexus/internal/shell/shell.templ NexusShell: an
// outer flex shell, a hidden sidebar-toggle checkbox and backdrop label, the
// sidebar slot, a growing content column carrying the topbar and content pane,
// and the rightbar slot. The shared CSS in components/css/custom.css styles the
// `_layout-sidebar`, `_layout-topbar` and `layout-content` hooks; the sidebar
// and topbar slots are expected to carry those ids.
templ AdminShell(props AdminShellProps) {
	<div class={ "flex h-screen overflow-hidden", props.Class }
		{ devmode.Attrs(ctx, "layout/AdminShell")... }
		{ props.Attrs... }
	>
		<input type="checkbox" id="_layout-sidebar-toggle-trigger" class="hidden" aria-label="Toggle layout sidebar"/>
		<label for="_layout-sidebar-toggle-trigger" id="_layout-sidebar-backdrop"></label>
		@props.Sidebar
		<div class="flex min-w-0 grow flex-col overflow-auto">
			if props.Topbar != nil {
				@props.Topbar
			}
			<div id="layout-content">@props.Content</div>
		</div>
	</div>
	if props.Rightbar != nil {
		@props.Rightbar
	}
}
