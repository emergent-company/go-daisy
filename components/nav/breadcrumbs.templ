package nav

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

// breadcrumbItem renders a single breadcrumb <li> for ElementBoundary wrapping.
templ breadcrumbItem(item BreadcrumbItem) {
	<li
		class={ templ.KV("font-medium text-base-content", item.Active) }
	>
		if item.Href != "" {
			<a href={ templ.URL(item.Href) } class={ templ.KV("inline-flex items-center gap-1", item.Icon != "") }>
				if item.Icon != "" {
					@ui.IconSpan(item.Icon, "size-4")
				}
				{ item.Label }
			</a>
		} else {
			<span class={ templ.KV("inline-flex items-center gap-1", item.Icon != "") }>
				if item.Icon != "" {
					@ui.IconSpan(item.Icon, "size-4")
				}
				{ item.Label }
			</span>
		}
	</li>
}

// BreadcrumbsProps configures BreadcrumbsWithProps. Compact collapses the trail
// to `p-0 text-sm` and drops the forced full-width; HideOnMobile adds
// `hidden sm:inline` so the trail only shows at the sm breakpoint.
type BreadcrumbsProps struct {
	Items        []BreadcrumbItem
	Divider      BreadcrumbsDivider
	Compact      bool             // p-0 text-sm, no forced width
	HideOnMobile bool             // hidden sm:inline
	Attrs        templ.Attributes // spread last on the root div
}

// Breadcrumbs renders a DaisyUI breadcrumb navigation trail.
templ Breadcrumbs(items []BreadcrumbItem, divider BreadcrumbsDivider) {
	@BreadcrumbsWithProps(BreadcrumbsProps{Items: items, Divider: divider})
}

// BreadcrumbsWithProps renders a DaisyUI breadcrumb navigation trail with
// Compact and HideOnMobile options. With zero values the output is
// byte-identical to Breadcrumbs.
templ BreadcrumbsWithProps(props BreadcrumbsProps) {
	{{ style := ""
	if props.Divider == BreadcrumbsDividerSlash {
		style = "--breadcrumbs-separator: '/'"
	}
	if !props.Compact {
		if style != "" {
			style += "; "
		}
		style += "width: 100%"
	} }}
	<div class={ "breadcrumbs text-sm", templ.KV("p-0", props.Compact), templ.KV("hidden sm:inline", props.HideOnMobile) }
		if style != "" {
			style={ style }
		}
		{ devmode.Attrs(ctx, "nav/Breadcrumbs")... }
		{ props.Attrs... }>
		<ul>
			for _, item := range props.Items {
				@devmode.ElementBoundary("BreadcrumbItem", breadcrumbItem(item), item)
			}
		</ul>
	</div>
}
