package nav

import (
	"strconv"

	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

// SearchTriggerProps configures the search trigger pair: a desktop pill button
// and a mobile square icon button, both opening a search dialog by id.
type SearchTriggerProps struct {
	DialogID    string // default "search-modal"
	Placeholder string // default "Search"
	Class       string
	Attrs       templ.Attributes
}

// searchTriggerDialogID resolves the dialog id, defaulting to "search-modal"
// (the id used by SearchModal's "minimal" style).
func searchTriggerDialogID(p SearchTriggerProps) string {
	if p.DialogID != "" {
		return p.DialogID
	}
	return "search-modal"
}

// searchTriggerPlaceholder resolves the pill label, defaulting to "Search".
func searchTriggerPlaceholder(p SearchTriggerProps) string {
	if p.Placeholder != "" {
		return p.Placeholder
	}
	return "Search"
}

// SearchTrigger renders the desktop pill + mobile square search button pair.
templ SearchTrigger(props SearchTriggerProps) {
	<div class={ "inline-flex items-center gap-3", props.Class }
		{ devmode.Attrs(ctx, "nav/SearchTrigger")... }
		{ props.Attrs... }
	>
		<button class="btn btn-outline btn-sm btn-ghost border-line-strong hidden h-9 w-48 justify-start gap-2 md:flex" onclick={ templ.JSUnsafeFuncCall("document.getElementById(" + strconv.Quote(searchTriggerDialogID(props)) + ")?.showModal()") }>
			@ui.IconSpan("lucide--search", "size-4 shrink-0")
			<span class="text-muted truncate text-sm font-normal">{ searchTriggerPlaceholder(props) }</span>
		</button>
		<button class="btn btn-outline btn-sm btn-square btn-ghost border-line-strong flex size-9 md:hidden" aria-label="Search" onclick={ templ.JSUnsafeFuncCall("document.getElementById(" + strconv.Quote(searchTriggerDialogID(props)) + ")?.showModal()") }>
			@ui.IconSpan("lucide--search", "size-4")
		</button>
	</div>
}
