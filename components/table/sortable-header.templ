package table

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
)

// SortableTableHeaderProps configures a sortable <th> cell.
//
// Column is the sort key. Leave it empty to render a plain, non-sortable
// header. If Column is set but Sort has no base path, the header also renders
// as plain text rather than as a broken link. Class is applied to the <th>;
// LinkAttrs is applied to the <a>, which lets callers add HTMX attributes or
// data-* hooks without changing the component.
//
// Align and Numeric match TableHeadCellProps: pass the same values to the
// column's body cells (TableCellWithProps) so the column stays aligned. When
// the column is end-aligned the link spans the cell and the direction icon
// leads the label, so the indicator never sits between the text and the cell's
// right edge.
type SortableTableHeaderProps struct {
	Label     string
	Column    string
	Sort      SortContext
	FirstDir  SortDir
	Align     TableAlign
	Numeric   bool
	Class     string
	LinkAttrs templ.Attributes
	Attrs     templ.Attributes
}

// SortableTableHeader renders a sortable column header.
//
// The header is a real link, so it works without JavaScript. When the column is
// active the linked <th> carries aria-sort="ascending" or aria-sort="descending";
// inactive headers omit the attribute entirely. The direction cycles
// first -> opposite -> none; "none" removes the sort parameters and returns to
// the handler's natural row order.
templ SortableTableHeader(props SortableTableHeaderProps) {
	if href := props.Sort.Href(props.Column, props.FirstDir); href != "" {
		<th { sortableHeaderAttrs(props)... }>
			@sortableHeaderLink(props, href)
		</th>
	} else {
		<th { sortableHeaderAttrs(props)... }>
			{ props.Label }
		</th>
	}
}

// sortableHeaderLink renders the anchor and direction icon for a header.
templ sortableHeaderLink(props SortableTableHeaderProps, href string) {
	<a
		href={ templ.URL(href) }
		aria-label={ props.ariaLabel() }
		class={ "inline-flex items-center gap-1 rounded-sm hover:text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary", templ.KV("w-full justify-end", props.endAligned()) }
		{ props.LinkAttrs... }
	>
		if props.endAligned() {
			@sortableHeaderIcon(props)
			<span>{ props.Label }</span>
		} else {
			<span>{ props.Label }</span>
			@sortableHeaderIcon(props)
		}
	</a>
}

// sortableHeaderIcon renders the direction indicator for the sort link.
templ sortableHeaderIcon(props SortableTableHeaderProps) {
	if props.Sort.Active(props.Column) {
		if props.Sort.Params.Dir == SortAsc {
			@ui.IconSpan("lucide--chevron-up", "size-3.5")
		} else {
			@ui.IconSpan("lucide--chevron-down", "size-3.5")
		}
	} else {
		@ui.IconSpan("lucide--chevrons-up-down", "size-3.5 opacity-30")
	}
}
