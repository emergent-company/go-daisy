package form

import (
	"github.com/emergent-company/go-daisy/devmode"

	ui "github.com/emergent-company/go-daisy/components/ui"
)

var clipboardScriptOnce = templ.NewOnceHandle()

// ClipboardCopyItem holds one copy-able field for the ClipboardCopy component.
type ClipboardCopyItem struct {
	// ID must be unique on the page.
	ID string
	// Label is the section heading shown above the field.
	Label string
	// Value is the text to copy.
	Value string
	// ButtonLabel is the copy button text (default "Copy").
	ButtonLabel string
	// ButtonClass is extra DaisyUI classes for the button (e.g. "btn-primary").
	ButtonClass string
	// Mono renders the value in a monospace <code> badge instead of an <input>.
	// Because Mono inlines the value into the button's onclick attribute, it is
	// unsuitable for secrets revealed on demand — anything that must not appear
	// in the initial HTML belongs in the input variant (or a bespoke flow).
	Mono bool
}

// ClipboardCopy renders one or more click-to-copy fields with visual feedback.
// Uses navigator.clipboard with an execCommand('copy') textarea fallback for
// non-secure contexts — no library needed. A successful copy shows a transient
// check; a rejected write shows a distinct failure state.
templ ClipboardCopy(items []ClipboardCopyItem) {
	<div class="space-y-4" { devmode.Attrs(ctx, "form/ClipboardCopy")... }>
		for _, item := range items {
			<div>
				if item.Label != "" {
					<p class="text-xs text-muted mb-2 font-semibold uppercase">{ item.Label }</p>
				}
				<div class={ ui.Row }>
					if item.Mono {
						<code class="bg-base-200 text-base-content px-3 py-1.5 rounded text-sm font-mono flex-1">{ item.Value }</code>
					} else {
						<input
							id={ item.ID }
							type="text"
							value={ item.Value }
							readonly
							class="input input-sm flex-1 font-mono text-sm"
						/>
					}
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Style: ui.ButtonStyleOutline, Size: ui.ButtonSM, ExtraClass: item.ButtonClass, OnClick: clipboardOnClick(item.ID, item.Value, item.Mono)}) {
						@ui.IconSpan("lucide--copy", "size-4")
						if item.ButtonLabel != "" {
							{ item.ButtonLabel }
						} else {
							Copy
						}
					}
				</div>
			</div>
		}
	</div>
	@clipboardScript()
}

// clipboardOnClick returns the button's onclick script. The button element is
// passed explicitly as `this` so the handler never relies on the implicit
// global `event` (a non-standard property absent in some contexts).
func clipboardOnClick(id string, value string, mono bool) templ.ComponentScript {
	if mono {
		return templ.JSFuncCall("clipboardCopyText", value, templ.JSExpression("this"))
	}
	return templ.JSFuncCall("clipboardCopyInput", id, templ.JSExpression("this"))
}

templ clipboardScript() {
	@clipboardScriptOnce.Once() {
		<script { nonceAttrs(ctx)... }>
	gdOnce('clipboardInit', function () {
	  function clipboardFlash(btn, html) {
	    var orig = btn.innerHTML;
	    btn.innerHTML = html;
	    btn.disabled = true;
	    setTimeout(function() { btn.innerHTML = orig; btn.disabled = false; }, 2000);
	  }
	  function clipboardFail(btn) {
	    var orig = btn.innerHTML;
	    btn.innerHTML = '✗ Copy failed';
	    btn.classList.add('btn-error');
	    btn.disabled = true;
	    setTimeout(function() {
	      btn.innerHTML = orig;
	      btn.disabled = false;
	      btn.classList.remove('btn-error');
	    }, 2000);
	  }
	  function clipboardFallback(text) {
	    var ta = document.createElement('textarea');
	    ta.value = text;
	    ta.setAttribute('readonly', '');
	    ta.style.position = 'fixed';
	    ta.style.left = '-9999px';
	    document.body.appendChild(ta);
	    ta.select();
	    var ok = false;
	    try { ok = document.execCommand('copy'); } catch (e) {}
	    document.body.removeChild(ta);
	    return ok;
	  }
	  function clipboardWrite(text, btn, successHtml) {
	    if (navigator.clipboard && navigator.clipboard.writeText) {
	      navigator.clipboard.writeText(text).then(function() {
	        clipboardFlash(btn, successHtml);
	      }).catch(function() {
	        clipboardFail(btn);
	      });
	    } else if (clipboardFallback(text)) {
	      clipboardFlash(btn, successHtml);
	    } else {
	      clipboardFail(btn);
	    }
	  }
	  window.clipboardCopyInput = function(inputId, btn) {
	    var el = document.getElementById(inputId);
	    if (!el || !btn) return;
	    clipboardWrite(el.value, btn, '✓ Copied!');
	  };
	  window.clipboardCopyText = function(text, btn) {
	    if (!btn) return;
	    clipboardWrite(text, btn, '✓');
	  };
	});
	</script>
	}
}
