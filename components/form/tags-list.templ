package form

import (
	alpine "github.com/emergent-company/go-daisy/components/alpine"
	"github.com/emergent-company/go-daisy/devmode"
)

// TagListProps configures an Alpine-managed tag input with add/remove.
// Submits as name[0], name[1], ... hidden inputs. Suggestions optionally
// wires a <datalist> of existing values onto the text input for autocomplete.
type TagListProps struct {
	ID             string
	Name           string
	Values         []string
	Suggestions    []string
	Placeholder    string
	AddActionLabel string
	Disabled       bool
	Class          string
	Attrs          templ.Attributes
}

templ TagList(props TagListProps) {
	{{
		placeholder := props.Placeholder
		if placeholder == "" {
			placeholder = "Add a tag..."
		}
		addLabel := props.AddActionLabel
		if addLabel == "" {
			addLabel = "Add"
		}
		// Autocomplete: point the input at a <datalist> of suggestions (only
		// emitted when suggestions are present).
		inputAttrs := templ.Attributes{}
		if len(props.Suggestions) > 0 {
			inputAttrs["list"] = props.ID + "-suggestions"
		}
	}}
	<div
		x-data={ alpine.TagListData(props.Values) }
		class={ templ.KV(props.Class, props.Class != "") }
		{ devmode.Attrs(ctx, "form/TagList")... }
		{ props.Attrs... }
	>
		<div class="flex flex-wrap gap-1.5 mb-2">
			<template x-for="(tag, idx) in tags" :key="idx">
				<span class="badge badge-sm gap-1 pr-0.5">
					<span x-text="tag"></span>
					<button
						type="button"
						class="btn btn-xs btn-ghost btn-square p-0 w-4 h-4 min-h-0"
						@click="removeTag(idx)"
						aria-label="Remove tag"
					>&times;</button>
					<input type="hidden" :name={ "`" + props.Name + "[${idx}]`" } x-model="tag"/>
				</span>
			</template>
		</div>
		if !props.Disabled {
			<div class="flex gap-2">
				<input
					type="text"
					id={ props.ID }
					class="input input-bordered input-sm flex-1"
					x-model="input"
					placeholder={ placeholder }
					@keydown="handleKeydown($event)"
					{ inputAttrs... }
				/>
				<button
					type="button"
					class="btn btn-sm btn-outline"
					@click="addTag()"
				>{ addLabel }</button>
			</div>
			if len(props.Suggestions) > 0 {
				<datalist id={ props.ID + "-suggestions" }>
					for _, s := range props.Suggestions {
						<option value={ s }/>
					}
				</datalist>
			}
		}
	</div>
}
