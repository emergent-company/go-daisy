package form

import (
	alpine "github.com/emergent-company/go-daisy/components/alpine"
	"github.com/emergent-company/go-daisy/devmode"
)

// ComboboxMode is the selection mode for a combobox.
type ComboboxMode string

const (
	ComboboxSingle   ComboboxMode = "single"
	ComboboxMultiple ComboboxMode = "multiple"
)

// ComboboxOption is a single option in a combobox.
type ComboboxOption struct {
	Value    string
	Label    string
	Disabled bool
}

// ComboboxSource holds either static options or a lazy-load endpoint.
type ComboboxSource struct {
	Static       []ComboboxOption
	LazyEndpoint string
}

// ComboboxProps configures a combobox component.
type ComboboxProps struct {
	ID             string
	Name           string
	Label          string
	Placeholder    string
	Mode           ComboboxMode
	Source         ComboboxSource
	Selected       []string
	EnableSearch   bool
	EnableClearAll bool
	Disabled       bool
	Class          string
	Attrs          templ.Attributes
}

func comboboxPlaceholder(p string) string {
	if p == "" {
		return "Select..."
	}
	return p
}

func comboboxLabels(opts []ComboboxOption) map[string]string {
	m := make(map[string]string, len(opts))
	for _, o := range opts {
		m[o.Value] = o.Label
	}
	return m
}

func comboboxSearchFilter(opt ComboboxOption) string {
	return `search === '' || ` + "`" + opt.Label + "`.toLowerCase().includes(search.toLowerCase())"
}

func comboboxSelectExpr(value string) string {
	return "selectItem('" + value + "')"
}

// comboboxTrigger is the visible control. It is a <div role="button"> so it can
// be focusable and label-addressable (a <div> cannot be targeted by <label
// for>, hence aria-labelledby), and because role=button makes its descendants
// presentational the clear-all button and the chevron live outside it in
// comboboxAdornments. Arrow navigation between options is handled by the root
// keydown listener once the popover is open.
templ comboboxTrigger(props ComboboxProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
			aria-controls={ props.ID + "-listbox" }
			if props.Label != "" {
				aria-labelledby={ props.ID + "-label" }
			}
		}
		role="button"
		aria-haspopup="listbox"
		:aria-expanded={ "open ? 'true' : 'false'" }
		if props.Disabled {
			tabindex="-1"
			aria-disabled="true"
		} else {
			tabindex="0"
		}
		@click="toggle()"
		@keydown.enter.prevent="open || toggle()"
		@keydown.space.prevent="open || toggle()"
		@keydown.arrow-down.prevent="open || toggle()"
		@keydown.escape="open = false"
		class={ "flex items-center justify-between w-full py-2 ps-3 border border-line-strong bg-base-100 rounded-btn cursor-pointer",
			templ.KV("pe-16", props.EnableClearAll && !props.Disabled),
			templ.KV("pe-9", !props.EnableClearAll || props.Disabled),
			templ.KV("opacity-50 pointer-events-none", props.Disabled) }
	>
		if props.Mode == ComboboxSingle {
			<span
				class={ "text-sm truncate", templ.KV("text-subtle", len(props.Selected) == 0) }
				x-text={ "selected.length ? (labels[selected[0]] || selected[0]) : '" + comboboxPlaceholder(props.Placeholder) + "'" }
			>{ comboboxPlaceholder(props.Placeholder) }</span>
		} else {
			<span
				class={ "text-sm truncate", templ.KV("text-subtle", len(props.Selected) == 0) }
				x-text={ "selected.length ? selected.length + ' selected' : '" + comboboxPlaceholder(props.Placeholder) + "'" }
			>{ comboboxPlaceholder(props.Placeholder) }</span>
		}
	</div>
}

// comboboxAdornments renders the clear-all control and the chevron as a layer
// above the trigger rather than as trigger children: role=button makes its
// descendants presentational in the accessibility tree, which would hide a
// nested <button>.
templ comboboxAdornments(props ComboboxProps) {
	<div class="pointer-events-none absolute right-3 top-1/2 flex -translate-y-1/2 items-center gap-1">
		if props.EnableClearAll && !props.Disabled {
			<button
				type="button"
				class="btn btn-ghost btn-xs btn-circle pointer-events-auto"
				x-show="selected.length > 0"
				@click="clearAll()"
				aria-label="Clear all"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
			</button>
		}
		<svg xmlns="http://www.w3.org/2000/svg" class={ "size-4 transition-transform", templ.KV("rotate-180", false) } :class="{ 'rotate-180': open }" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
	</div>
}

templ comboboxHiddenInputs(props ComboboxProps) {
	if props.Mode == ComboboxMultiple {
		<template x-for="(v, idx) in selected" :key="v">
			<input type="hidden" :name={ `'` + props.Name + `[]'` } :value="v"/>
		</template>
	} else {
		<input type="hidden" name={ props.Name } :value="selected[0] || ''"/>
	}
}

templ comboboxPopoverSearch(props ComboboxProps) {
	if props.EnableSearch {
		if props.Source.LazyEndpoint != "" {
			<input
				type="text"
				name="q"
				class="input input-sm w-full mb-1"
				placeholder="Search..."
				x-model="search"
				hx-get={ props.Source.LazyEndpoint }
				hx-target={ "next .combobox-options-inner" }
				hx-trigger="keyup changed delay:200ms"
				hx-include="closest .combobox-popover"
			/>
		} else {
			<input
				type="text"
				class="input input-sm w-full mb-1"
				placeholder="Search..."
				x-model="search"
			/>
		}
	}
}

templ comboboxStaticOption(opt ComboboxOption, props ComboboxProps) {
	if props.EnableSearch {
		<div
			role="option"
			data-value={ opt.Value }
			class={ "flex items-center justify-between px-3 py-2 text-sm cursor-pointer hover:bg-base-200",
				templ.KV("opacity-50 cursor-not-allowed", opt.Disabled) }
			:class="{ 'bg-base-200': activeIndex >= 0 && getVisibleIndex($el) === activeIndex }"
			x-show={ comboboxSearchFilter(opt) }
			:aria-selected={ "isSelected('" + opt.Value + "')" }
			if opt.Disabled {
				aria-disabled="true"
			} else {
				@click={ comboboxSelectExpr(opt.Value) }
			}
		>
			<span>{ opt.Label }</span>
			if props.Mode == ComboboxMultiple {
				<span x-show={ "isSelected('" + opt.Value + "')" }>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
				</span>
			}
		</div>
	} else {
		<div
			role="option"
			data-value={ opt.Value }
			class={ "flex items-center justify-between px-3 py-2 text-sm cursor-pointer hover:bg-base-200",
				templ.KV("opacity-50 cursor-not-allowed", opt.Disabled) }
			:class="{ 'bg-base-200': activeIndex >= 0 && activeIndex === getVisibleIndex($el) }"
			:aria-selected={ "isSelected('" + opt.Value + "')" }
			if opt.Disabled {
				aria-disabled="true"
			} else {
				@click={ comboboxSelectExpr(opt.Value) }
			}
		>
			<span>{ opt.Label }</span>
			if props.Mode == ComboboxMultiple {
				<span x-show={ "isSelected('" + opt.Value + "')" }>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
				</span>
			}
		</div>
	}
}

templ comboboxStaticOptions(props ComboboxProps) {
	<div
		class="combobox-options-inner"
		if props.ID != "" {
			id={ props.ID + "-listbox" }
		}
		role="listbox"
		if props.Mode == ComboboxMultiple {
			aria-multiselectable="true"
		}
	>
		for _, opt := range props.Source.Static {
			@comboboxStaticOption(opt, props)
		}
	</div>
}

templ comboboxLazyOptions(props ComboboxProps) {
	<div
		class="combobox-options-inner"
		if props.ID != "" {
			id={ props.ID + "-listbox" }
		}
		role="listbox"
		if props.Mode == ComboboxMultiple {
			aria-multiselectable="true"
		}
		hx-get={ props.Source.LazyEndpoint }
		hx-trigger="load"
		hx-swap="innerHTML"
	>
		<div class="px-3 py-2 text-sm text-subtle">Loading...</div>
	</div>
}

// Combobox renders an Alpine-powered searchable select with client-side or
// server-side option loading, keyboard navigation, and single/multi mode.
templ Combobox(props ComboboxProps) {
	<div
		class={ "w-full", templ.KV(props.Class, props.Class != "") }
		{ alpine.XData(alpine.ComboboxState(props.Selected, comboboxLabels(props.Source.Static)))... }
		x-init={ alpine.ComboboxInit(props.Mode == ComboboxMultiple) }
		{ devmode.Attrs(ctx, "form/Combobox")... }
		{ props.Attrs... }
	>
		if props.Label != "" {
			// A <div> is not a labelable element, so <label for> cannot associate
			// with the trigger. The label carries an id and the trigger points at
			// it with aria-labelledby instead.
			if props.ID != "" {
				@Label(LabelProps{ID: props.ID + "-label"}) { { props.Label } }
			} else {
				@Label(LabelProps{}) { { props.Label } }
			}
		}
		<div class="relative w-full">
			@comboboxTrigger(props)
			@comboboxAdornments(props)
			<div
				class="combobox-popover absolute z-50 mt-1 w-full bg-base-100 edge-line rounded-box shadow-lg max-h-60 overflow-auto p-1"
				x-show="open"
				x-transition
				@click.outside="open = false"
				x-trap.noscroll="open"
				style="display:none"
			>
				@comboboxPopoverSearch(props)
				if len(props.Source.Static) > 0 {
					@comboboxStaticOptions(props)
				} else if props.Source.LazyEndpoint != "" {
					@comboboxLazyOptions(props)
				}
			</div>
		</div>
		@comboboxHiddenInputs(props)
	</div>
}
