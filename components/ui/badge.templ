package ui

import "github.com/emergent-company/go-daisy/devmode"

// BadgeIntent maps a semantic intent to a DaisyUI badge class.
type BadgeIntent string

const (
	BadgeSuccess   BadgeIntent = "badge-success"
	BadgeError     BadgeIntent = "badge-error"
	BadgeWarning   BadgeIntent = "badge-warning"
	BadgeInfo      BadgeIntent = "badge-info"
	BadgeNeutral   BadgeIntent = "badge-neutral"
	BadgeGhost     BadgeIntent = "badge-ghost"
	BadgePrimary   BadgeIntent = "badge-primary"
	BadgeSecondary BadgeIntent = "badge-secondary"
	BadgeAccent    BadgeIntent = "badge-accent"
)

// BadgeStyle controls the visual style variant of a badge.
type BadgeStyle string

const (
	BadgeStyleDefault BadgeStyle = ""
	BadgeStyleOutline BadgeStyle = "badge-outline"
	BadgeStyleSoft    BadgeStyle = "badge-soft"
	BadgeStyleDash    BadgeStyle = "badge-dash"
)

// BadgeSize controls the size of a badge.
type BadgeSize string

const (
	BadgeSizeXS BadgeSize = "badge-xs"
	BadgeSizeSM BadgeSize = "badge-sm"
	BadgeSizeMD BadgeSize = "badge-md"
)

// BadgeProps configures a Badge component.
type BadgeProps struct {
	Label    string
	Variant  BadgeIntent
	Style    BadgeStyle
	Size     BadgeSize
	Icon     string           // Lucide icon suffix, e.g. "lucide--circle-check"
	Dot      bool             // when true, renders a status dot prefix (uses Variant to colour it)
	Animate  bool             // when true, adds animate-pulse to the icon/dot span
	MaxWidth string           // optional Tailwind max-width class (e.g. "max-w-24"); enables truncation with ellipsis
	Href     string           // when non-empty, renders an <a href> instead of a <span>
	// Position is an optional positioning class list for indicator composition,
	// e.g. "indicator-item indicator-top indicator-end". Appended to the badge's
	// own classes so the badge can be placed as a DaisyUI indicator overlay.
	Position string
	// DirectLabel, when true, renders Label as the element's direct text content
	// (no nested label <span>). Useful for badges whose count is read from the
	// element's text node directly (e.g. a tab-count badge `>5<`).
	DirectLabel bool
	// Color is an arbitrary CSS colour applied via inline style (text + a
	// translucent background/border via color-mix). When set it replaces the
	// Variant tone class (matching the reference typeNameChip behaviour).
	Color string
	// Glyph renders a text/emoji glyph prefix instead of the icon (and dot)
	// when non-empty.
	Glyph string
	// LabelClass is an optional extra class on the label span, e.g.
	// "text-base-content" to restore contrast when Color is set.
	LabelClass string
	Attrs      templ.Attributes // optional extra HTML attributes, e.g. {"data-testid": "status-badge"}
}

// StatusIntentFor maps a status string to a BadgeIntent.
// Exported so callers (e.g. gallery seed) can use the same mapping.
func StatusIntentFor(status string) BadgeIntent {
	switch status {
	case "active", "open", "completed", "approved":
		return BadgeSuccess
	case "closed", "rejected", "cancelled", "deleted":
		return BadgeError
	case "pending", "in_progress", "review":
		return BadgeWarning
	case "draft":
		return BadgeGhost
	default:
		return BadgeNeutral
	}
}

// Badge renders a DaisyUI badge.
// Set Dot=true to show a coloured status dot prefix (colour matches Variant).
// Set Icon to show a Lucide icon prefix instead of (or in addition to) a dot.
// Set MaxWidth to a Tailwind max-width class (e.g. "max-w-24") to enable label truncation.
// Set Href to render a link-styled badge (<a href> instead of <span>).
// Set Position to a positioning class list (e.g. "indicator-item indicator-top indicator-end").
// Set DirectLabel to render Label as the element's direct text content.
templ Badge(props BadgeProps) {
	if props.Href != "" {
		<a href={ templ.URL(props.Href) } class={ "badge gap-1", templ.KV(string(props.Variant), props.Variant != "" && props.Color == ""), templ.KV(string(props.Style), props.Style != ""), templ.KV(string(props.Size), props.Size != ""), templ.KV("overflow-hidden", props.MaxWidth != ""), props.MaxWidth, props.Position }
			if props.Color != "" {
				style={ accentStyle(props.Color) }
			}
			{ devmode.Attrs(ctx, "ui/Badge")... } { props.Attrs... }>
			@badgeContent(props)
		</a>
	} else {
		<span class={ "badge gap-1", templ.KV(string(props.Variant), props.Variant != "" && props.Color == ""), templ.KV(string(props.Style), props.Style != ""), templ.KV(string(props.Size), props.Size != ""), templ.KV("overflow-hidden", props.MaxWidth != ""), props.MaxWidth, props.Position }
			if props.Color != "" {
				style={ accentStyle(props.Color) }
			}
			{ devmode.Attrs(ctx, "ui/Badge")... } { props.Attrs... }>
			@badgeContent(props)
		</span>
	}
}

// badgeContent renders the prefix (dot/glyph/icon) and the label body shared by
// both the <span> and <a> variants of Badge.
templ badgeContent(props BadgeProps) {
	if props.Dot {
		<span class={ templ.KV("animate-pulse", props.Animate), dotClass(props.Variant) }></span>
	} else if props.Glyph != "" {
		<span class="shrink-0 leading-none text-[13px]" aria-hidden="true">{ props.Glyph }</span>
	} else if props.Icon != "" {
		@IconSpan(props.Icon, "size-3 shrink-0")
	}
	if props.DirectLabel {
		{ props.Label }
	} else {
		<span class={ templ.KV("truncate", props.MaxWidth != ""), props.LabelClass }>{ props.Label }</span>
	}
}

// dotClass maps a BadgeIntent to its corresponding DaisyUI status-dot class.
func dotClass(intent BadgeIntent) string {
	switch intent {
	case BadgeSuccess:
		return "status status-success status-xs"
	case BadgeError:
		return "status status-error status-xs"
	case BadgeWarning:
		return "status status-warning status-xs"
	case BadgeInfo:
		return "status status-info status-xs"
	case BadgePrimary:
		return "status status-primary status-xs"
	case BadgeSecondary:
		return "status status-secondary status-xs"
	case BadgeAccent:
		return "status status-accent status-xs"
	default:
		return "status status-neutral status-xs"
	}
}

// StatusBadge maps a string status value to an appropriately coloured Badge.
// Kept as a convenience wrapper for callers that receive raw status strings.
templ StatusBadge(status string) {
	@Badge(BadgeProps{Label: status, Variant: StatusIntentFor(status), Size: BadgeSizeSM})
}
