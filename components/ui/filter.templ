package ui

import "github.com/emergent-company/go-daisy/devmode"

// FilterCardProps configures a FilterCard form wrapper.
type FilterCardProps struct {
	Action string
	Method string // defaults to "get"
	Target string // hx-target selector
	Swap   string // hx-swap strategy
	// Inline renders the bar without a card wrapper.
	Inline bool
}

func (p FilterCardProps) method() string {
	if p.Method == "" {
		return "get"
	}
	return p.Method
}

// FilterCard renders a filter form. When props.Inline is false (default) it
// wraps the form in a card; when true it renders a plain horizontal flex bar
// (equivalent to the former CompactFilterBar).
templ FilterCard(props FilterCardProps) {
	if props.Inline {
		<form
			class="flex flex-wrap gap-3 items-end mb-4"
			method={ props.method() }
			action={ templ.URL(props.Action) }
			if props.Target != "" {
				hx-get={ props.Action }
				hx-target={ props.Target }
				if props.Swap != "" {
					hx-swap={ props.Swap }
				}
			}
			{ devmode.Attrs(ctx, "ui/FilterCard")... }
		>
			{ children... }
			<div class="flex gap-2">
				@Button(ButtonProps{Type: ButtonTypeSubmit, Variant: ButtonPrimary, Size: ButtonSM}) { Filter }
				@Button(ButtonProps{Type: ButtonTypeLink, Href: props.Action, Variant: ButtonGhost, Size: ButtonSM}) { Clear }
			</div>
		</form>
	} else {
		<div class="card bg-base-100 shadow-sm edge-line mb-4" { devmode.Attrs(ctx, "ui/FilterCard")... }>
			<div class="card-body p-4">
				<form
					method={ props.method() }
					action={ templ.URL(props.Action) }
					if props.Target != "" {
						hx-get={ props.Action }
						hx-target={ props.Target }
						if props.Swap != "" {
							hx-swap={ props.Swap }
						}
					}
				>
					<div class="flex flex-wrap gap-3 items-end">
						{ children... }
						<div class="flex gap-2">
							@Button(ButtonProps{Type: ButtonTypeSubmit, Variant: ButtonPrimary, Size: ButtonSM}) { Filter }
							@Button(ButtonProps{Type: ButtonTypeLink, Href: props.Action, Variant: ButtonGhost, Size: ButtonSM}) { Clear }
						</div>
					</div>
				</form>
			</div>
		</div>
	}
}
