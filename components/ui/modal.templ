package ui

import "github.com/emergent-company/go-daisy/devmode"

// ModalProps configures a native <dialog class="modal"> shell.
type ModalProps struct {
	// ID is the dialog element id (used by showModal()/close() and any
	// data-testid targeting).
	ID string
	// BoxID is an optional id on the modal-box element ("" omits it).
	BoxID string
	// BoxClass is the modal-box extra class, e.g. "max-w-sm". Empty = plain
	// "modal-box" (DaisyUI default max-width).
	BoxClass string
	// Attrs are optional extra attributes on the <dialog> element, e.g.
	// auto-open attributes or {"data-testid": "confirm-modal"}.
	Attrs templ.Attributes
}

// Modal renders a native <dialog class="modal"> shell: a modal-box (with
// configurable class/id) and the standard method="dialog" backdrop form.
// Children are the modal-box content. hx-boost is disabled so HTMX does not
// intercept the dialog's form submission.
//
// Open via document.getElementById(id).showModal() (or an auto-open attribute)
// — the shell is not pre-opened.
templ Modal(props ModalProps) {
	<dialog id={ props.ID } class="modal" hx-boost="false" { devmode.Attrs(ctx, "ui/Modal")... } { props.Attrs... }>
		<div { modalBoxAttrs(props.BoxID)... } class={ "modal-box", templ.KV(props.BoxClass, props.BoxClass != "") }>
			{ children... }
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
}
