package ui

import (
	"strconv"
	"strings"

	"github.com/emergent-company/go-daisy/devmode"
	"github.com/emergent-company/go-daisy/staticfs"
)

// ResizableProps configures a two-pane split view with a draggable handle.
type ResizableProps struct {
	// ID is the root element id (optional, useful for tests).
	ID string
	// Orientation is "" / "horizontal" for side-by-side panes, or "vertical"
	// for stacked panes.
	Orientation string
	// Initial is the first pane's share, e.g. "50%". Defaults to "50%".
	Initial string
	// Min and Max clamp the first pane, e.g. "20%" and "80%".
	Min string
	Max string
	// PersistKey, when set, stores the split in localStorage under this key.
	PersistKey string
	// Class is appended to the root classes.
	Class string
	Attrs templ.Attributes

	// Start and End are the two panes, in order.
	Start templ.Component
	End   templ.Component
}

var resizableOnce = templ.NewOnceHandle()

// ResizableScript loads the resizable runtime once per page.
templ ResizableScript() {
	@resizableOnce.Once() {
		@templ.Raw(staticfs.ScriptNonce("/js/go-daisy-resizable.js", templ.GetNonce(ctx)))
	}
}

// splitPercent normalises a "NN%" value to its number, defaulting when the
// value is missing or malformed.
func splitPercent(value string, fallback int) string {
	v := strings.TrimSuffix(strings.TrimSpace(value), "%")
	if v == "" {
		return strconv.Itoa(fallback)
	}
	for _, r := range v {
		if (r < '0' || r > '9') && r != '.' {
			return strconv.Itoa(fallback)
		}
	}
	return v
}

// Resizable renders a two-pane split view. The divider is draggable with the
// pointer, resizable with the keyboard (arrows, Home/End, Shift for coarse
// steps), and reset to Initial on double-click.
//
// Implementation lives in go-daisy-resizable.js; ARIA follows the "window
// splitter" pattern: role="separator" with aria-valuenow/min/max on the handle.
templ Resizable(props ResizableProps) {
	{{ orientation := "horizontal"
	initial := splitPercent(props.Initial, 50)
	min := splitPercent(props.Min, 10)
	max := splitPercent(props.Max, 90)
	if props.Orientation == "vertical" {
		orientation = "vertical"
	} }}
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		data-gd-resizable
		data-orientation={ orientation }
		data-initial={ initial }
		data-min={ min }
		data-max={ max }
		if props.PersistKey != "" {
			data-persist={ props.PersistKey }
		}
		style={ "--gd-split:" + initial + "%" }
		class={ "flex h-full w-full overflow-hidden", templ.KV("flex-col", orientation == "vertical"), props.Class }
		{ devmode.Attrs(ctx, "ui/Resizable")... }
		{ props.Attrs... }
	>
		<div data-gd-resizable-start class="min-h-0 min-w-0 overflow-auto" style="flex:0 0 var(--gd-split)">
			@props.Start
		</div>
		<div
			role="separator"
			tabindex="0"
			data-gd-resizable-handle
			aria-orientation={ ternary(orientation == "vertical", "horizontal", "vertical") }
			aria-valuemin={ min }
			aria-valuemax={ max }
			aria-valuenow={ initial }
			aria-label="Resize panels"
			class={ "group relative shrink-0 bg-base-300 outline-none transition-colors hover:bg-primary focus-visible:bg-primary",
				templ.KV("h-1.5 w-full cursor-row-resize", orientation == "vertical"),
				templ.KV("h-full w-1.5 cursor-col-resize", orientation != "vertical") }
		></div>
		<div class="min-h-0 min-w-0 flex-1 overflow-auto">
			@props.End
		</div>
		@ResizableScript()
	</div>
}
