package ui

import "github.com/emergent-company/go-daisy/devmode"

// EmptyNoteSize selects the note's type scale.
type EmptyNoteSize string

const (
	// EmptyNoteSizeSM is the zero-value default: text-sm.
	EmptyNoteSizeSM EmptyNoteSize = ""
	// EmptyNoteSizeXS is the compact scale: text-xs.
	EmptyNoteSizeXS EmptyNoteSize = "xs"
)

// EmptyNoteProps configures an EmptyNote.
type EmptyNoteProps struct {
	// ID sets the paragraph's id attribute. Empty omits it.
	ID string
	// Hidden renders the note hidden so client code can reveal it later (the
	// modal's duplicate empty note). The note is invisible until un-hidden.
	Hidden bool
	// Size selects the type scale: text-sm (default) or text-xs ("xs").
	Size EmptyNoteSize
	// Icon, when non-empty, renders a leading lucide icon and switches the note
	// to a flex row with a 1.5 gap between the icon and the copy.
	Icon string
	// IconClass is the leading icon's class list. Default "size-3.5 shrink-0";
	// append a colour class (e.g. "text-warning") to recolour the icon.
	IconClass string
	// Class is extra CSS classes appended to the note's class list — the
	// caller owns outer spacing (margins), so "mt-2" and friends go here.
	Class string
	// Attrs are extra attributes spread onto the paragraph.
	Attrs templ.Attributes
}

// EmptyNote renders one muted paragraph of empty-state or hint copy — the
// one-line "No items yet" / helper note. It is deliberately distinct from
// EmptyState: a note is left-aligned prose (optionally led by an icon), not the
// centered icon+title+description+action placeholder EmptyState draws.
//
//	@ui.EmptyNote() { No other agents to delegate to. }
//
// Note copy — including links and inline markup — is passed as children.
//
// The zero value emits <p class="text-base-content/40 text-sm">…</p>. The muted
// foreground is the de-emphasised text step; it is expressed with the
// text-base-content/40 opacity utility rather than a named muted token, because
// go-daisy ships no foreground ladder (consumers that define one can append
// their own step through Class).
templ EmptyNote(props ...EmptyNoteProps) {
	{{ var p EmptyNoteProps
	if len(props) > 0 { p = props[0] }
	size := "text-sm"
	if p.Size == EmptyNoteSizeXS { size = "text-xs" }
	cls := "text-base-content/40"
	if p.Hidden { cls += " hidden" }
	if p.Icon != "" { cls += " flex items-center gap-1.5" }
	cls += " " + size
	if p.Class != "" { cls += " " + p.Class }
	iconClass := p.IconClass
	if iconClass == "" { iconClass = "size-3.5 shrink-0" } }}
	<p
		if p.ID != "" { id={ p.ID } }
		class={ cls }
		{ devmode.Attrs(ctx, "ui/EmptyNote")... }
		{ p.Attrs... }
	>
		if p.Icon != "" {
			@IconSpan(p.Icon, iconClass)
		}
		{ children... }
	</p>
}
