package ui

import "github.com/emergent-company/go-daisy/devmode"

// SectionProps configures the optional aspects of a Section.
type SectionProps struct {
	// Margin is the section wrapper's margin class, e.g. "mt-6" (detail pages)
	// or "mb-8" (list pages). Default "" (no margin).
	Margin string
	// CardClass is the card wrapper's class. Default "" (CardRaw provides its
	// own outline — the house edge, so callers no longer need to add a
	// card-border class).
	CardClass string
	// BodyClass is the card body's padding class, e.g. "p-0" (lists) or "p-5"
	// (forms). Default "".
	BodyClass string
	// Empty switches the section to the empty-state branch: when true, the
	// ui.Empty card (default bordered card, no padding) is rendered instead of
	// the children. Gate it on the caller's own condition, e.g.
	// Empty: len(items) == 0. When false, the children render in the card.
	Empty bool
	// EmptyIcon, EmptyTitle and EmptyDesc populate the empty-state card when
	// Empty is true. Ignored otherwise.
	EmptyIcon  string
	EmptyTitle string
	EmptyDesc  string
	// Raw renders the children directly in the <section> without the CardRaw
	// wrapper — for sections whose branches are not carded (e.g. an error
	// Alert). Ignored when Empty is true.
	Raw bool
	// Rows wraps the children in a divide-y divide-line container inside the
	// card body, for list rows separated by hairlines.
	Rows bool
	// Titleless skips the <h2> heading, rendering only the card body (and any
	// empty state). Useful for bare list sections with no title.
	Titleless bool
	// Wrapperless omits the <section> element (and the <h2> heading) entirely,
	// rendering the card path directly. Use it when you need a bare card with no
	// section chrome — e.g. a CardRaw(CardRawProps{Class: "overflow-hidden", BodyClass: "p-0"})
	// wrapping a divide-y row list — which the titled section layout cannot
	// express. When Wrapperless is true:
	//
	//   - No <section> and no <h2> are emitted (Titleless is implied).
	//   - The card path renders CardRaw with CardClass and BodyClass, and when
	//     Rows is true the children are wrapped in
	//     <div class="divide-y divide-line"> exactly as the card path does.
	//   - Margin is applied to the card element instead of the now-absent section
	//     wrapper, so outer spacing is preserved.
	//   - Empty is still honoured: when Empty is true, the default empty-state
	//     card (bordered, no body padding) renders without a section wrapper.
	//     As with the non-wrapperless Empty branch, CardClass and BodyClass are
	//     ignored, but Margin still applies to the card.
	//   - Raw is ignored: Raw's purpose is to skip the card inside a section, and
	//     with no section there is nothing for it to skip. The card path always
	//     renders.
	//
	// Default false reproduces today's <section>-wrapped output byte-for-byte.
	Wrapperless bool
}

// Section renders a titled card section: an <h2> header followed by a DaisyUI
// card body. This is the standard title+box layout used across Alfred's
// gateway pages:
//
//	@ui.Section("Object types", ui.SectionProps{
//		Margin:    "mt-6",
//		CardClass: "overflow-hidden",
//		BodyClass: "p-0",
//		Empty:     len(types) == 0,
//		EmptyIcon: "lucide--box", EmptyTitle: "No object types", EmptyDesc: "None compiled yet.",
//	}) { rows }
//
// When Empty is true the section renders ui.Empty instead of its children.
templ Section(title string, props SectionProps) {
	if props.Wrapperless {
		if props.Empty {
			@CardRaw(CardRawProps{Class: props.Margin}) {
				@Empty(props.EmptyIcon, props.EmptyTitle, props.EmptyDesc)
			}
		} else {
			{{ cardClass := props.CardClass
			if props.CardClass != "" && props.Margin != "" { cardClass += " " }
			cardClass += props.Margin }}
			@CardRaw(CardRawProps{Class: cardClass, BodyClass: props.BodyClass}) {
				if props.Rows {
					<div class="divide-y divide-line">
						{ children... }
					</div>
				} else {
					{ children... }
				}
			}
		}
	} else {
		<section class={ templ.KV(props.Margin, props.Margin != "") } { devmode.Attrs(ctx, "ui/Section")... }>
			if !props.Titleless {
				<h2 class="mb-3 text-lg font-semibold tracking-tight">{ title }</h2>
			}
			if props.Empty {
				@CardRaw(CardRawProps{}) {
					@Empty(props.EmptyIcon, props.EmptyTitle, props.EmptyDesc)
				}
			} else if props.Raw {
				{ children... }
			} else {
				@CardRaw(CardRawProps{Class: props.CardClass, BodyClass: props.BodyClass}) {
					if props.Rows {
						<div class="divide-y divide-line">
							{ children... }
						</div>
					} else {
						{ children... }
					}
				}
			}
		</section>
	}
}
