package ui

import "github.com/emergent-company/go-daisy/devmode"

// CardSurface selects the card's background surface. The zero value renders the
// default "bg-base-100"; a non-zero value REPLACES that default class rather
// than stacking a second bg-* class on top of it.
//
// Surface is deliberately an OPEN class passthrough: unlike CardElement and
// CardBorder (which are structural, closed enums), a caller may legitimately
// want an arbitrary background utility (bg-red-500, a gradient, a custom tone),
// so the value is emitted verbatim with no validation. The named constants are
// convenience defaults, not an exhaustive set.
type CardSurface string

const (
	// CardSurfaceBase100 is the zero-value default surface.
	CardSurfaceBase100 CardSurface = ""
	// CardSurfaceBase200 is one step up the base ladder.
	CardSurfaceBase200 CardSurface = "bg-base-200"
	// CardSurfaceBase300 is two steps up the base ladder.
	CardSurfaceBase300 CardSurface = "bg-base-300"
	// CardSurfaceNeutral uses the neutral surface tone.
	CardSurfaceNeutral CardSurface = "bg-neutral"
	// CardSurfaceGhost renders a transparent surface.
	CardSurfaceGhost CardSurface = "bg-transparent"
)

// CardElement selects the HTML element CardRaw renders. The zero value renders a
// <div>. It is a CLOSED enum (unlike CardSurface): unknown values panic in
// devmode and fall back to <div> outside devmode.
type CardElement string

const (
	// CardElementDiv is the zero-value default element.
	CardElementDiv CardElement = ""
	// CardElementA renders an <a> (link card).
	CardElementA CardElement = "a"
	// CardElementButton renders a <button> (interactive card).
	CardElementButton CardElement = "button"
	// CardElementSection renders a <section>.
	CardElementSection CardElement = "section"
	// CardElementArticle renders an <article>.
	CardElementArticle CardElement = "article"
	// CardElementLi renders an <li> (list-item card).
	CardElementLi CardElement = "li"
)

// CardBorder selects the card outline. The zero value renders the default house
// edge "edge-line"; CardBorderStrong uses the emphasised line-strong step and
// CardBorderNone removes the outline. It is a CLOSED enum (unlike
// CardSurface): unknown values panic in devmode and fall back to the default
// outline outside devmode.
//
// The outline width follows the theme's `--border` token (1px, 2px under
// `prefers-contrast: more`), so a card keeps the high-contrast width that
// daisyUI's `.card-border` provided. That is why the emitted class is
// `edge-line` and not `border border-line`: Tailwind's `border` utility pins
// the width to 1px (issue #79).
type CardBorder string

const (
	// CardBorderLine is the zero-value default outline (edge-line).
	CardBorderLine CardBorder = ""
	// CardBorderStrong uses the emphasised line-strong step (edge-line-strong).
	CardBorderStrong CardBorder = "strong"
	// CardBorderNone removes the outline entirely.
	CardBorderNone CardBorder = "none"
)

// CardRawProps configures CardRaw.
type CardRawProps struct {
	Class      string           // additional CSS classes on the card root (appended)
	BodyClass  string           // additional CSS classes on the card body
	Surface    CardSurface      // zero = bg-base-100; a non-zero surface replaces it (open passthrough)
	As         CardElement      // zero = <div>; unknown values panic in devmode, else fall back to <div>
	Border     CardBorder       // zero = edge-line; CardBorderNone removes it; unknown panics in devmode
	Attrs      templ.Attributes // spread last on the card root
}

// CardRaw renders a bare DaisyUI card shell with configurable card and body CSS classes.
// Use this when Card or CardCompact don't fit the layout (e.g. custom padding, flex body).
// Surface selects the background (zero = bg-base-100), As selects the element
// (zero = <div>), and Border selects the outline (zero = edge-line, whose width
// comes from the theme's --border token so it thickens under
// prefers-contrast: more).
templ CardRaw(props CardRawProps) {
	{{ as := cardElement(props.As, ctx)
	surface := cardSurfaceClass(props.Surface)
	border := cardBorderClass(props.Border, ctx) }}
	if as == CardElementA {
		<a class={ "card", surface, border, templ.KV(props.Class, props.Class != "") } { devmode.Attrs(ctx, "ui/CardRaw")... } { props.Attrs... }>
			<div class={ "card-body", templ.KV(props.BodyClass, props.BodyClass != "") }>{ children... }</div>
		</a>
	} else if as == CardElementButton {
		<button type="button" class={ "card", surface, border, templ.KV(props.Class, props.Class != "") } { devmode.Attrs(ctx, "ui/CardRaw")... } { props.Attrs... }>
			<div class={ "card-body", templ.KV(props.BodyClass, props.BodyClass != "") }>{ children... }</div>
		</button>
	} else if as == CardElementSection {
		<section class={ "card", surface, border, templ.KV(props.Class, props.Class != "") } { devmode.Attrs(ctx, "ui/CardRaw")... } { props.Attrs... }>
			<div class={ "card-body", templ.KV(props.BodyClass, props.BodyClass != "") }>{ children... }</div>
		</section>
	} else if as == CardElementArticle {
		<article class={ "card", surface, border, templ.KV(props.Class, props.Class != "") } { devmode.Attrs(ctx, "ui/CardRaw")... } { props.Attrs... }>
			<div class={ "card-body", templ.KV(props.BodyClass, props.BodyClass != "") }>{ children... }</div>
		</article>
	} else if as == CardElementLi {
		<li class={ "card", surface, border, templ.KV(props.Class, props.Class != "") } { devmode.Attrs(ctx, "ui/CardRaw")... } { props.Attrs... }>
			<div class={ "card-body", templ.KV(props.BodyClass, props.BodyClass != "") }>{ children... }</div>
		</li>
	} else {
		<div class={ "card", surface, border, templ.KV(props.Class, props.Class != "") } { devmode.Attrs(ctx, "ui/CardRaw")... } { props.Attrs... }>
			<div class={ "card-body", templ.KV(props.BodyClass, props.BodyClass != "") }>{ children... }</div>
		</div>
	}
}

// Card renders a DaisyUI card with optional title.
// attrs is optional; pass nil when not needed.
// compact is an optional variadic param — when true, uses tighter padding (p-3 gap-2).
// Backward-compatible: callers omitting compact default to false.
//
// The outline is the house edge (edge-line): its width comes from the theme's
// --border token, so it thickens for prefers-contrast: more instead of staying
// at Tailwind's fixed 1px `border` (issue #79).
templ Card(title string, attrs templ.Attributes, compact ...bool) {
	{{ isCompact := false
	if len(compact) > 0 { isCompact = compact[0] } }}
	<div class="card bg-base-100 edge-line shadow-sm" { devmode.Attrs(ctx, "ui/Card")... } { attrs... }>
		<div class={ "card-body", templ.KV("p-4", !isCompact), templ.KV("p-3 gap-2", isCompact) }>
			if title != "" {
				<h2 class="card-title text-base font-semibold text-base-content mb-3">{ title }</h2>
			}
			{ children... }
		</div>
	</div>
}

// CardBodyText renders a simple paragraph used as card body placeholder content.
templ CardBodyText(text string) {
	<p class="text-sm text-label" { devmode.Attrs(ctx, "ui/CardBodyText")... }>{ text }</p>
}

// CardPlaceholder renders a small labelled card placeholder for examples and gallery stories.
templ CardPlaceholder(label string) {
	<div class="card bg-base-100 edge-line w-32 h-16 flex items-center justify-center text-sm text-subtle" { devmode.Attrs(ctx, "ui/CardPlaceholder")... }>{ label }</div>
}

// CardCompact renders a compact DaisyUI card with tighter padding.
// Deprecated: use Card("", nil, true) instead.
// attrs is optional; pass nil when not needed.
templ CardCompact(attrs templ.Attributes) {
	@Card("", attrs, true) {
		{ children... }
	}
}

// StatTrend indicates whether a metric is trending up, down, or neutral.
type StatTrend string

const (
	StatTrendUp      StatTrend = "up"
	StatTrendDown    StatTrend = "down"
	StatTrendNeutral StatTrend = ""
)

// statTrendIntent maps a StatTrend to the appropriate BadgeIntent.
func statTrendIntent(t StatTrend) BadgeIntent {
	switch t {
	case StatTrendUp:
		return BadgeSuccess
	case StatTrendDown:
		return BadgeError
	default:
		return BadgeNeutral
	}
}

// statTrendIcon returns the Lucide icon name for a given trend direction.
func statTrendIcon(t StatTrend) string {
	switch t {
	case StatTrendUp:
		return "lucide--chevron-up"
	case StatTrendDown:
		return "lucide--chevron-down"
	default:
		return ""
	}
}

// StatCardMinimalItem holds data for a single StatCardMinimal cell.
type StatCardMinimalItem struct {
	Label string
	Value string
	// Trend direction and percentage label (e.g. "12.3%").
	Trend      StatTrend
	TrendLabel string
	// ComparisonLabel is optional text shown after the trend badge (e.g. "vs. $494.16 last period").
	// When empty, defaults to "vs last month".
	ComparisonLabel string
	// Icon is a Lucide icon suffix, e.g. "lucide--briefcase".
	// When set, StatCardMinimal renders as the icon-corner style with a
	// floating icon badge and a soft trend pill; otherwise as the minimal layout.
	Icon string
	// IconColor is a Tailwind text-* class for the icon colour.
	IconColor string
	// Attrs are optional extra HTML attributes on the card root, e.g. {"data-testid": "stat-revenue"}.
	Attrs templ.Attributes
}

// StatCardMinimal renders a KPI stat card with a trend indicator (↑↓).
// When item.Icon is set, it renders as the icon-corner style with a
// floating icon badge and a soft trend pill; otherwise as the minimal layout.
templ StatCardMinimal(item StatCardMinimalItem) {
	if item.Icon != "" {
		<div class="card bg-base-100 relative shadow-sm edge-line" { devmode.Attrs(ctx, "ui/StatCardMinimal")... } { item.Attrs... }>
			<div class="card-body gap-2">
				<p class="text-2xl/none font-semibold">{ item.Value }</p>
				<p class="text-muted mt-1 text-sm font-medium">{ item.Label }</p>
			if item.TrendLabel != "" {
				<div class="mt-5 flex items-center gap-2">
					@BadgeWithBoundary(statTrendIntent(item.Trend), BadgeStyleSoft, BadgeSizeSM, false, statTrendIcon(item.Trend), item.TrendLabel)
					if item.ComparisonLabel != "" {
						<p class="text-muted text-sm">{ item.ComparisonLabel }</p>
					} else {
						<p class="text-muted text-sm">vs last month</p>
					}
				</div>
			}
		</div>
		<div class="absolute -end-3 -top-3 rounded-full bg-gradient-to-bl from-transparent to-base-200/60 p-1.5">
			<div class="bg-base-100 flex items-center justify-center rounded-full p-2 shadow">
				@IconSpan(item.Icon, "size-5", item.IconColor)
			</div>
		</div>
		</div>
	} else {
		@CardRaw(CardRawProps{Attrs: item.Attrs}) {
			<p class="eyebrow">{ item.Label }</p>
			<div class="mt-4 flex items-end justify-between gap-2 text-sm">
				<p class="text-2xl/none font-semibold">{ item.Value }</p>
			if item.TrendLabel != "" {
				@BadgeWithBoundary(statTrendIntent(item.Trend), BadgeStyleSoft, BadgeSizeSM, false, statTrendIcon(item.Trend), item.TrendLabel)
			}
			</div>
		}
	}
}
