package ui

import (
	"github.com/emergent-company/go-daisy/devmode"
)

// Account is one identity in an AccountMenu: the signed-in account, or one of
// the cached accounts the visitor can switch to.
type Account struct {
	// Sub is the account's stable id and the value the switch form posts. An
	// empty Sub is skipped in the switch list, because the form would post
	// nothing to switch to.
	Sub string
	// Name is the display name (the account row's primary line).
	Name string
	// Email is the account row's secondary line. Empty omits it.
	Email string
	// Picture is an avatar image URL. Empty falls back to initials.
	Picture string
}

// AccountMenuProps configures the topbar account menu.
type AccountMenuProps struct {
	// Class is appended to the root element's classes (and to the signed-out
	// link), e.g. a scroll constraint on a narrow header.
	Class string
	// SignedIn renders the avatar trigger and its menu. When false the menu
	// renders SignInPath instead (or nothing at all when that is empty too).
	SignedIn bool
	// Active is the signed-in account, shown in the "Signed in as" row.
	Active Account
	// Others are the cached accounts the visitor can switch to. Empty omits
	// the "Switch account" section entirely.
	Others []Account
	// SignInPath is the sign-in entry point, rendered only when SignedIn is
	// false. Empty means the app has no sign-in surface and renders nothing.
	SignInPath string
	// SwitchPath receives the POST that swaps the active account (form field
	// "sub"). Empty omits the switch rows even when Others is non-empty.
	SwitchPath string
	// AddPath starts a sign-in for another account. Empty omits the row.
	AddPath string
	// ProfilePath is the account's own page. Empty omits the row.
	ProfilePath string
	// ProfileAttrs spread onto the profile link, e.g. htmx navigation
	// attributes when the app swaps the page into a container.
	ProfileAttrs templ.Attributes
	// LogoutPath receives the POST that ends this session. Empty omits the
	// row.
	LogoutPath string
	// Attrs spread onto the root dropdown (e.g. a data-testid).
	Attrs templ.Attributes
}

// AccountMenu renders the topbar account control: a round avatar trigger whose
// dropdown lists the active account, any cached accounts, and the account
// actions. It is the one account surface shared by the org's apps, so two
// products cannot drift apart on labels, rows or behaviour.
//
// The component is deliberately passive: the app that hosts it owns the routes,
// and an empty path omits its row rather than rendering a dead control.
templ AccountMenu(props AccountMenuProps) {
	if props.SignedIn {
		<div
			class={ twmerge("dropdown dropdown-end", props.Class) }
			data-gd-menu-root
			{ devmode.Attrs(ctx, "ui/AccountMenu")... }
			{ mergeAttrs(templ.Attributes{"data-testid": "account-menu"}, props.Attrs)... }
		>
			<div
				tabindex="0"
				role="button"
				class="rounded-full p-px outline-none cursor-pointer transition hover:ring-1 hover:ring-base-content/25 focus-visible:ring-1 focus-visible:ring-base-content/45 active:ring-1 active:ring-base-content/30"
				aria-label="Account"
				aria-haspopup="menu"
				data-testid="account-menu-trigger"
			>
				<div class="flex items-center gap-1">
					@accountMenuAvatar(props.Active.Name, props.Active.Picture, AvatarSize7, "text-xs")
				</div>
			</div>
			@DropdownMenu(templ.Attributes{"aria-label": "Account", "class": "min-w-56 border-base-content/10 z-50"}) {
				<li class="menu-title pointer-events-none px-2 pt-2 pb-0.5 text-[10px] font-medium tracking-[0.14em] uppercase text-faint select-none">Signed in as</li>
				@accountMenuActiveRow(props.Active)
				if accountMenuHasSwitchRows(props) {
					<li class="menu-title pointer-events-none px-2 pt-3 pb-0.5 text-[10px] font-medium tracking-[0.14em] uppercase text-faint select-none">Switch account</li>
					for _, a := range props.Others {
						if a.Sub != "" {
							@accountMenuSwitchRow(a, props.SwitchPath)
						}
					}
				}
				if accountMenuHasActions(props) {
					<li aria-hidden="true"></li>
				}
				if props.AddPath != "" {
					<li>
						<a href={ props.AddPath } class="justify-start gap-2" data-testid="account-menu-add">
							@IconSpan("lucide--user-plus", "size-4")
							<span>Add another account</span>
						</a>
					</li>
				}
				if props.ProfilePath != "" {
					<li>
						<a
							href={ props.ProfilePath }
							class="justify-start gap-2"
							data-testid="account-menu-profile"
							{ props.ProfileAttrs... }
						>
							@IconSpan("lucide--user", "size-4")
							<span>My Profile</span>
						</a>
					</li>
				}
				if props.LogoutPath != "" {
					if props.AddPath != "" || props.ProfilePath != "" {
						<li aria-hidden="true"></li>
					}
					<li>
						<form method="post" action={ props.LogoutPath } class="flex w-full">
							<button
								type="submit"
								class="text-error hover:bg-error/10 flex w-full cursor-pointer items-center gap-2 text-left"
								data-testid="account-menu-logout"
							>
								@IconSpan("lucide--log-out", "size-4")
								<span>Log out</span>
							</button>
						</form>
					</li>
				}
			}
			@DropdownScript()
		</div>
	} else if props.SignInPath != "" {
		<a
			class={ twmerge("btn btn-ghost btn-sm", props.Class) }
			href={ props.SignInPath }
			data-testid="account-menu-signin"
			{ props.Attrs... }
		>Sign in</a>
	}
}

// accountMenuHasSwitchRows reports whether the "Switch account" section renders
// anything: a switch path plus at least one account that can actually be
// switched to. A heading with no rows under it reads as a broken menu.
func accountMenuHasSwitchRows(props AccountMenuProps) bool {
	if props.SwitchPath == "" {
		return false
	}
	for _, a := range props.Others {
		if a.Sub != "" {
			return true
		}
	}
	return false
}

// accountMenuHasActions reports whether any action row follows the switch
// section, which is what the divider between them separates.
func accountMenuHasActions(props AccountMenuProps) bool {
	return props.AddPath != "" || props.ProfilePath != "" || props.LogoutPath != ""
}

// accountMenuAvatar renders a round avatar: an <img> when a picture URL is
// present, else an initials badge (falling back to a user icon). size selects
// the diameter; textClass sizes the initials text. The outer shrink-0 wrapper is
// local because AvatarFull has no shrink slot, and it stops the avatar from
// collapsing inside the flex menu rows.
templ accountMenuAvatar(name, picture string, size AvatarSize, textClass string) {
	<div class="shrink-0">
		@AvatarFull(AvatarProps{
			Name: name,
			// The picture is identity data from an IdP and travels as a plain
			// string attribute, which templ does not scheme-check; sanitising it
			// here keeps a crafted claim from turning into a live javascript:
			// URL on every page that renders the menu.
			Src:       string(templ.URL(picture)),
			Icon:      "lucide--user",
			Size:      size,
			Fallback:  AvatarFallbackInitials,
			TextClass: textClass,
		})
	</div>
}

// accountMenuActiveRow is the non-interactive row marking the active account.
templ accountMenuActiveRow(u Account) {
	<li class="pointer-events-none" data-testid="account-menu-active">
		<div class="flex items-center gap-2">
			@accountMenuAvatar(u.Name, u.Picture, AvatarSize6, "text-[10px]")
			<div class="min-w-0 grow">
				<p class="truncate text-sm font-semibold">{ u.Name }</p>
				if u.Email != "" {
					@EmptyNote(EmptyNoteProps{Tone: EmptyNoteToneQuiet, Size: EmptyNoteSizeXS, Class: "truncate"}) {
						{ u.Email }
					}
				}
			</div>
			@IconSpan("lucide--check", "size-4 text-success")
		</div>
	</li>
}

// accountMenuSwitchRow is one cached account the visitor can switch to.
templ accountMenuSwitchRow(u Account, switchPath string) {
	<li>
		<form method="post" action={ switchPath } class="flex w-full" data-testid="account-menu-switch">
			<input type="hidden" name="sub" value={ u.Sub }/>
			<button type="submit" role="menuitem" class="flex w-full cursor-pointer items-center gap-2 text-left">
				@accountMenuAvatar(u.Name, u.Picture, AvatarSize6, "text-[10px]")
				<div class="min-w-0 grow">
					<p class="truncate text-sm">{ u.Name }</p>
					if u.Email != "" {
						@EmptyNote(EmptyNoteProps{Tone: EmptyNoteToneQuiet, Size: EmptyNoteSizeXS, Class: "truncate"}) {
							{ u.Email }
						}
					}
				</div>
			</button>
		</form>
	</li>
}

// mergeAttrs returns base with extra's keys layered on top, without mutating
// either map: a caller's attributes must not leak through a shared props value
// into the next render.
func mergeAttrs(base, extra templ.Attributes) templ.Attributes {
	if len(extra) == 0 {
		return base
	}
	out := make(templ.Attributes, len(base)+len(extra))
	for k, v := range base {
		out[k] = v
	}
	for k, v := range extra {
		out[k] = v
	}
	return out
}
