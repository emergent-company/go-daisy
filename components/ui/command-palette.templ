package ui

import (
	"github.com/emergent-company/go-daisy/devmode"
	"github.com/emergent-company/go-daisy/staticfs"
)

var commandPaletteScriptOnce = templ.NewOnceHandle()

// CommandPaletteItem represents a single action in the command palette.
type CommandPaletteItem struct {
	ID          string
	Label       string
	Description string
	Icon        string
	Shortcut    string
	Href        string
	Group       string
	// Attrs are optional extra HTML attributes on the item's <a>, e.g. htmx
	// navigation attributes. Activating an item closes the palette; set
	// data-command-palette-keep-open to keep it open after the action.
	Attrs templ.Attributes
}

// CommandPaletteProps configures a ⌘K command palette modal.
type CommandPaletteProps struct {
	ID          string
	Placeholder string
	Items       []CommandPaletteItem
	ItemsURL    string // JSON endpoint for remote results (fetched client-side)
	Groups      []string
	Open        bool
	// FullScreenMobile renders the full-viewport mobile sheet behaviour: on
	// <768px the modal-box fills the viewport edge-to-edge, the input row pins
	// to the top (clear of safe-area insets), the results fill and scroll, and
	// the "Esc" label swaps to a tap-sized ✕. CSS selectors are derived from ID.
	FullScreenMobile bool
	// AriaLabel is the dialog's accessible name; defaults to "Command palette".
	AriaLabel string
	Attrs     templ.Attributes
}

// CommandPalette renders a ⌘K-style command palette modal.
templ CommandPalette(props CommandPaletteProps) {
	{{ label := props.AriaLabel
	if label == "" { label = "Command palette" } }}
	{{ searchLabel := props.Placeholder
	if searchLabel == "" { searchLabel = "Search" } }}
	<input type="checkbox" id={ props.ID + "-toggle" } data-command-palette="true" class="modal-toggle" checked?={ props.Open } />
	<div class="modal" role="dialog" aria-modal="true" aria-label={ label } { devmode.Attrs(ctx, "ui/CommandPalette")... } { props.Attrs... }>
		<div class="modal-box p-0 max-w-lg">
			<div class="flex items-center gap-3 px-4 py-3 border-b border-line">
				@IconSpan("lucide--search", "size-5 text-faint")
				<input
					type="text"
					id={ props.ID + "-input" }
					class="input input-ghost w-full p-0 text-base focus:outline-none"
					if props.Placeholder != "" {
					placeholder={ props.Placeholder }
				} else {
					placeholder="Type a command or search..."
				}
					aria-label={ searchLabel }
					oninput="filterPaletteItems(this)"
				/>
				<label for={ props.ID + "-toggle" } class="btn btn-ghost btn-xs">Esc</label>
			</div>
			<div class="max-h-80 overflow-y-auto p-2" id={ props.ID + "-results" }
			if props.ItemsURL != "" {
				data-items-url={ props.ItemsURL }
			}
		>
				for _, group := range props.Groups {
					@paletteGroup(props.ID, group, props.Items)
				}
				if len(props.Groups) == 0 {
					@paletteGroup(props.ID, "", props.Items)
				}
			</div>
		</div>
		<label class="modal-backdrop" for={ props.ID + "-toggle" }></label>
	</div>
	if props.FullScreenMobile {
		@templ.Raw("<style>" + commandPaletteMobileCSS(props.ID) + "</style>")
	}
	@commandPaletteScript()
}

// paletteGroupAttrs returns data attributes for filtering.
func paletteGroupAttrs(group string) templ.Attributes {
	return templ.Attributes{"data-palette-group": group}
}

// paletteItemDataAttrs returns data attributes for palette items.
func paletteItemDataAttrs(item CommandPaletteItem) templ.Attributes {
	return templ.Attributes{
		"data-label": item.Label,
		"data-group": item.Group,
	}
}

templ paletteGroup(paletteID, group string, items []CommandPaletteItem) {
	<div data-palette-group={ group }>
		if group != "" {
			<p class="eyebrow text-xs px-3 pt-3 pb-1.5">{ group }</p>
		}
		for _, item := range items {
			if item.Group == group || (group == "" && item.Group == "") {
				<a
					href={ templ.SafeURL(item.Href) }
					class="flex items-center gap-3 px-3 py-2.5 rounded-box hover:bg-base-200 cursor-pointer transition-colors"
					data-label={ item.Label }
					data-group={ item.Group }
					{ item.Attrs... }
				>
					if item.Icon != "" {
						<span class={ "iconify size-4 shrink-0 text-subtle " + item.Icon }></span>
					}
					<div class="flex-1 min-w-0">
						<p class="text-sm font-medium text-base-content truncate">{ item.Label }</p>
						if item.Description != "" {
							<p class="text-xs text-faint truncate">{ item.Description }</p>
						}
					</div>
					if item.Shortcut != "" {
						<kbd class="kbd kbd-xs">{ item.Shortcut }</kbd>
					}
				</a>
			}
		}
	</div>
}

// commandPaletteScript loads the palette runtime once per page. The runtime
// handles Cmd/Ctrl+K, initial focus, the focus trap and filterPaletteItems;
// gdFocus.trap comes from go-daisy-a11y.js, so both files load together.
templ commandPaletteScript() {
	@commandPaletteScriptOnce.Once() {
		@templ.Raw(staticfs.ScriptNonce("/js/go-daisy-a11y.js", templ.GetNonce(ctx)))
		@templ.Raw(staticfs.ScriptNonce("/js/go-daisy-command-palette.js", templ.GetNonce(ctx)))
	}
}
