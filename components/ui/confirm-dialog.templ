package ui

// ConfirmDialogProps configures a destructive confirm dialog.
type ConfirmDialogProps struct {
	// ID is the dialog element id.
	ID string
	// Noun is the item being deleted, used in the default heading
	// ("Delete <noun>?"), e.g. "agent".
	Noun string
	// Title overrides the heading. Empty defaults to "Delete <noun>?".
	Title string
	// Icon is the error-circle icon suffix; defaults to "lucide--trash-2".
	Icon string
	// BoxClass is the modal-box class; defaults to "max-w-sm".
	BoxClass string
	// Attrs are optional extra attributes on the <dialog> element.
	Attrs templ.Attributes
}

// ConfirmDialog renders a destructive confirm modal: an error icon circle, a
// "Delete <noun>?" heading, a description slot, and an actions slot (children).
// Built on ui.Modal. Free of application-specific copy — set Noun and provide
// your own description/actions.
templ ConfirmDialog(props ConfirmDialogProps, description templ.Component) {
	{{ boxClass := props.BoxClass
	if boxClass == "" { boxClass = "max-w-sm" }
	icon := props.Icon
	if icon == "" { icon = "lucide--trash-2" }
	title := props.Title
	if title == "" { title = "Delete " + props.Noun + "?" } }}
	@Modal(ModalProps{ID: props.ID, BoxClass: boxClass, Attrs: props.Attrs}) {
		<div class="mb-4 flex items-start gap-3">
			<div class="bg-error/10 text-error grid size-10 shrink-0 place-items-center rounded-full">
				@IconSpan(icon, "size-5")
			</div>
			<div>
				<h3 class="text-lg font-semibold">{ title }</h3>
				if description != nil {
					@description
				}
			</div>
		</div>
		{ children... }
	}
}
