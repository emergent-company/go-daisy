package ui

import "github.com/emergent-company/go-daisy/devmode"

type DropdownAlign string

const (
	DropdownEnd    DropdownAlign = "dropdown-end"
	DropdownTop    DropdownAlign = "dropdown-top"
	DropdownBottom DropdownAlign = "dropdown-bottom"
	DropdownLeft   DropdownAlign = "dropdown-left"
	DropdownRight  DropdownAlign = "dropdown-right"
)

// Dropdown wraps a trigger + dropdown-content menu.
// attrs is optional; pass nil when not needed.
//
// NOTE: no aria-expanded/aria-haspopup here. This is daisyUI's CSS-only
// (focus/focus-within) dropdown, so the open state has no JS hook to toggle
// aria-expanded — a static "false" would lie to assistive tech. Callers that
// need ARIA-complete dropdowns should use AlpineDropdown (which binds
// aria-expanded to its `open` state on the trigger).
templ Dropdown(align DropdownAlign, attrs templ.Attributes) {
	<div class={ "dropdown", templ.KV(string(align), align != "") } { devmode.Attrs(ctx, "ui/Dropdown")... } { attrs... }>
		{ children... }
	</div>
}

// DropdownTrigger renders a standard button trigger for a Dropdown.
// attrs is optional; pass nil when not needed.
templ DropdownTrigger(label string, variant string, attrs templ.Attributes) {
	<div tabindex="0" role="button" class={ "btn", "btn-sm", "m-1", variant } { devmode.Attrs(ctx, "ui/DropdownTrigger")... } { attrs... }>
		{ label }
		@IconSpan("lucide--chevron-down", "size-3.5")
	</div>
}

// DropdownMenu renders the dropdown-content menu list.
// attrs is optional; pass nil when not needed. A "class" entry in attrs is
// merged into the default menu classes via twmerge (last-wins conflict
// resolution), so callers can widen, re-tint, or add scroll constraints.
templ DropdownMenu(attrs templ.Attributes) {
	{{ extraClass := ""
	if s, ok := attrs["class"].(string); ok {
		extraClass = s
		delete(attrs, "class")
	} }}
	<ul tabindex="0" role="menu" class={ twmerge("dropdown-content z-[1] menu menu-sm p-1 bg-base-100 border border-base-200 rounded-box shadow-lg w-max min-w-40 max-w-[calc(100vw-2rem)] mt-1", extraClass) } { devmode.Attrs(ctx, "ui/DropdownMenu")... } { attrs... }>
		{ children... }
	</ul>
}

// DropdownItem renders a single menu item inside a dropdown.
// attrs is optional; pass nil when not needed.
templ DropdownItem(active bool, danger bool, attrs templ.Attributes) {
	<li role="none" { devmode.Attrs(ctx, "ui/DropdownItem")... } { attrs... }>
		<a role="menuitem" class={ "min-w-0 break-words", templ.KV("active", active), templ.KV("text-error", danger) }>
			{ children... }
		</a>
	</li>
}
