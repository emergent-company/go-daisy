package ui

import "github.com/emergent-company/go-daisy/devmode"

// ListRowVariant selects a visual treatment for a ListRow.
type ListRowVariant string

const (
	ListRowDefault ListRowVariant = ""       // current look, no extra classes
	ListRowOutline ListRowVariant = "outline"
	ListRowMuted   ListRowVariant = "muted"
)

// ListRowSize tightens the vertical padding and title size of a ListRow.
type ListRowSize string

const (
	ListRowSizeDefault ListRowSize = ""
	ListRowSizeSM      ListRowSize = "sm"
	ListRowSizeXS      ListRowSize = "xs"
)

// ListMediaVariant styles the Leading slot of a ListRow.
type ListMediaVariant string

const (
	ListMediaDefault ListMediaVariant = ""
	ListMediaIcon    ListMediaVariant = "icon"
	ListMediaImage   ListMediaVariant = "image"
)

// ListRowProps holds data for a single list row.
//
// Layout patterns:
//
//  1. Default (Title+Subtitle block grows as second child):
//     [Leading] [Title+Subtitle] [Trailing...]
//
//  2. Leading-grow (explicitly mark Leading with list-col-grow — useful for
//     rank/image combos where you want the leading block to grow instead):
//     Set LeadingGrow: true; Leading block gets list-col-grow instead of the
//     title block.
//
//  3. Col-wrap (Description wraps to the next row inside the list-row grid):
//     Set Description; it is rendered with list-col-wrap so it spans the full
//     width below the rest of the row.
type ListRowProps struct {
	// Title is the primary label text for the row.
	Title string
	// Subtitle is secondary label text rendered below Title.
	Subtitle string
	// Description is optional longer text that wraps to the next row using
	// list-col-wrap. Leave empty to omit.
	Description string
	// Leading is an optional component rendered in the leading slot
	// (e.g. avatar, image, rank number, icon).
	Leading templ.Component
	// LeadingGrow puts list-col-grow on the Leading slot instead of on the
	// Title+Subtitle block. Use this for the "rank/image + grow-title" pattern.
	LeadingGrow bool
	// Trailing is an optional list of components rendered after the title block
	// (e.g. buttons, badges, icons). They are each rendered as direct children
	// of the list-row (not wrapped).
	Trailing []templ.Component
	// Attrs are optional extra HTML attributes on the <li> element, e.g. {"data-testid": "user-row-42"}.
	Attrs templ.Attributes

	// Variant selects a visual treatment for the row.
	Variant ListRowVariant
	// Size tightens the vertical padding and title size of the row.
	Size ListRowSize
	// MediaVariant styles the Leading slot: "icon" wraps it in a 9×9 rounded
	// bg-base-200 centred box with text-muted; "image" wraps it in a 9×9
	// rounded overflow-hidden bg-base-200 box with [&_img]:size-full
	// [&_img]:object-cover; "" leaves Leading unwrapped. Ignored when
	// LeadingGrow is set, because the growing slot must stay unwrapped.
	MediaVariant ListMediaVariant
	// Href, when non-empty, wraps the row contents in an <a> filling the row.
	Href string
	// Target is the anchor target; emitted only when non-empty. Set "_blank"
	// to also emit rel="noopener noreferrer".
	Target string
	// Header is an optional component rendered above the title inside the
	// growing content column (not as a wrapped grid row).
	Header templ.Component
	// Footer is an optional component rendered below the description inside
	// the same wrapped grid cell.
	Footer templ.Component
}

// ListProps holds options for the List container.
type ListProps struct {
	// Header is an optional label rendered as the first row of the list using
	// the DaisyUI header-row style (plain <li> with muted text).
	Header string
	// Attrs are optional extra HTML attributes on the <ul> element, e.g. {"data-testid": "user-list"}.
	Attrs templ.Attributes
}

// List renders a DaisyUI list container with an optional header row.
templ List(p ListProps) {
	<ul class="list bg-base-100 rounded-box edge-line" { devmode.Attrs(ctx, "ui/List")... } { p.Attrs... }>
		if p.Header != "" {
			<li class="eyebrow text-xs p-4 pb-2">{ p.Header }</li>
		}
		{ children... }
	</ul>
}

// ItemGroup is a List container for item rows (templui ItemGroup parity).
templ ItemGroup(p ListProps) {
	@List(p) {
		{ children... }
	}
}

// ItemSeparator is a non-interactive separator row inside a list.
templ ItemSeparator() {
	<li role="separator" class="my-1 h-px bg-base-300" { devmode.Attrs(ctx, "ui/ItemSeparator")... }></li>
}

// ListRow renders a single row inside a List.
templ ListRow(p ListRowProps) {
	if p.Href != "" {
		<li { devmode.Attrs(ctx, "ui/ListRow")... } { p.Attrs... }>
			<a class={ listRowClass(p) } href={ templ.URL(p.Href) }
				if p.Target != "" {
					target={ p.Target }
				}
				if p.Target == "_blank" {
					rel="noopener noreferrer"
				}
			>
				@listRowContent(p)
			</a>
		</li>
	} else {
		<li class={ listRowClass(p) } { devmode.Attrs(ctx, "ui/ListRow")... } { p.Attrs... }>
			@listRowContent(p)
		</li>
	}
}

// listRowContent renders the shared inner content of a ListRow, used by both
// the plain and anchor branches.
//
// Header sits inside the growing content column (above the title), so the
// DaisyUI list grid keeps exactly one growing column. Description and Footer
// share a single list-col-wrap block, which keeps the wrapped row to one cell.
templ listRowContent(p ListRowProps) {
	if p.Leading != nil {
		if p.MediaVariant == ListMediaIcon && !p.LeadingGrow {
			<div class="size-9 shrink-0 rounded-box bg-base-200 text-muted flex items-center justify-center">@p.Leading</div>
		} else if p.MediaVariant == ListMediaImage && !p.LeadingGrow {
			<div class="size-9 shrink-0 rounded-box overflow-hidden bg-base-200 [&_img]:size-full [&_img]:object-cover">@p.Leading</div>
		} else if p.LeadingGrow {
			<div class="list-col-grow">
				@p.Leading
			</div>
		} else {
			@p.Leading
		}
	}
	if !p.LeadingGrow {
		<div class="list-col-grow">
			if p.Header != nil {
				<div class="text-xs font-semibold text-label">@p.Header</div>
			}
			<div class={ "font-medium", templ.KV("text-xs", p.Size == ListRowSizeXS), templ.KV("text-sm", p.Size != ListRowSizeXS) }>{ p.Title }</div>
			if p.Subtitle != "" {
				<div class="text-xs text-subtle">{ p.Subtitle }</div>
			}
		</div>
	} else {
		<div>
			if p.Header != nil {
				<div class="text-xs font-semibold text-label">@p.Header</div>
			}
			<div class={ "font-medium", templ.KV("text-xs", p.Size == ListRowSizeXS), templ.KV("text-sm", p.Size != ListRowSizeXS) }>{ p.Title }</div>
			if p.Subtitle != "" {
				<div class="text-xs text-subtle">{ p.Subtitle }</div>
			}
		</div>
	}
	for _, t := range p.Trailing {
		@t
	}
	if p.Footer == nil {
		if p.Description != "" {
			<div class="list-col-wrap text-xs text-muted mt-1">{ p.Description }</div>
		}
	} else {
		<div class="list-col-wrap text-xs mt-1">
			if p.Description != "" {
				<div class="text-muted">{ p.Description }</div>
			}
			<div class="text-subtle">@p.Footer</div>
		</div>
	}
}
