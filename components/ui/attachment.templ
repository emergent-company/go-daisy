package ui

import "github.com/emergent-company/go-daisy/devmode"

// AttachmentProps configures a file attachment chip.
type AttachmentProps struct {
	// Name is the file name shown prominently.
	Name string
	// Size is a human-readable size, e.g. "1.2 MB".
	Size string
	// Kind selects the fallback icon when Src is empty: "image", "audio",
	// "video", "archive", "code", or "" for a generic document.
	Kind string
	// Src is an optional thumbnail URL (images).
	Src string
	// Href makes the chip a download link.
	Href string
	// RemoveAction, when set, renders an hx-delete remove button.
	RemoveAction string
	// RemoveTarget is the hx-target for RemoveAction, e.g. "closest .attachment".
	RemoveTarget string
	Class        string
	Attrs        templ.Attributes
}

// attachmentIcon maps a Kind to its fallback Lucide icon.
func attachmentIcon(kind string) string {
	switch kind {
	case "image":
		return "lucide--image"
	case "audio":
		return "lucide--music"
	case "video":
		return "lucide--video"
	case "archive":
		return "lucide--file-archive"
	case "code":
		return "lucide--file-code"
	default:
		return "lucide--file"
	}
}

// Attachment renders a compact file chip: thumbnail or kind icon, name, size,
// and optional download / remove actions.
//
// Use it for chat message attachments, upload previews, and record files. It is
// display-only; wire RemoveAction to the endpoint that deletes the file.
templ Attachment(props ...AttachmentProps) {
	{{ var p AttachmentProps
	if len(props) > 0 { p = props[0] } }}
	<div
		class={ "attachment flex items-center gap-3 rounded-box border border-line bg-base-100 p-2 ps-3", p.Class }
		{ devmode.Attrs(ctx, "ui/Attachment")... }
		{ p.Attrs... }
	>
		<div class="grid size-9 shrink-0 place-items-center overflow-hidden rounded-box bg-base-200">
			if p.Src != "" {
				<img src={ p.Src } alt="" class="size-full object-cover" loading="lazy"/>
			} else {
				@IconSpan(attachmentIcon(p.Kind), "size-4 opacity-70")
			}
		</div>
		<div class="min-w-0 flex-1">
			<p class="truncate text-sm font-medium">{ p.Name }</p>
			if p.Size != "" {
				<p class="text-xs text-base-content/60">{ p.Size }</p>
			}
		</div>
		if p.Href != "" {
			<a href={ p.Href } class="btn btn-ghost btn-xs btn-square" aria-label={ "Download " + p.Name }>
				@IconSpan("lucide--download", "size-4")
			</a>
		}
		if p.RemoveAction != "" {
			<button
				type="button"
				class="btn btn-ghost btn-xs btn-square"
				aria-label={ "Remove " + p.Name }
				hx-delete={ p.RemoveAction }
				if p.RemoveTarget != "" {
					hx-target={ p.RemoveTarget }
				}
				hx-swap="outerHTML"
			>
				@IconSpan("lucide--x", "size-4")
			</button>
		}
	</div>
}
