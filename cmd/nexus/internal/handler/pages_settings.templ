package handler

import (
	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

templ SettingsPage() {

	<div class="min-sm:container" { devmode.Attrs(ctx, "nexus/SettingsPage")... }>

		<div class="bg-primary/10 rounded-box relative w-full overflow-hidden p-6">

			<div class="flex justify-between">

				<div>

					<div class="flex items-center gap-1">

						<p class="text-base-content/80 text-sm">Pages</p>

						@ui.IconSpan("lucide--chevron-right text-base-content/80", "size-3.5")

						<p class="text-sm">Settings</p>

					</div>

					<p class="text-primary mt-4 text-xl font-medium">My Profile</p>

					<p class="text-base-content/80">Configure your preferences and customize your account settings.</p>

				</div>

				<div class="flex flex-col items-end justify-between">

					<button class="btn btn-sm btn-primary max-xl:btn-square">

						@ui.IconSpan("lucide--settings-2", "size-4")

						<span class="max-xl:hidden">Advanced Setup</span>

					</button>

					<div class="text-base-content/60 flex items-center gap-2 max-xl:hidden">

						@ui.IconSpan("lucide--clock", "size-4")

						<p class="text-sm">Changed 6h ago</p>

					</div>

				</div>

			</div>

			@ui.IconSpan("lucide--settings text-primary/5 absolute start-1/2 -bottom-12 size-44", "-rotate-25")

		</div>

		<div class="card bg-base-100 card-border mt-6">

			<div class="card-body space-y-6 sm:space-y-20 sm:p-8">

				<div class="grid grid-cols-1 gap-5 xl:grid-cols-5">

					<div class="xl:col-span-2">

						<div class="flex items-center gap-2">

							@ui.IconSpan("lucide--id-card", "size-5")

							<p class="text-lg font-medium">User Profile</p>

						</div>

						<p class="text-base-content/60">Manage your account information and settings</p>

					</div>

					<div class="flex gap-5 max-lg:flex-col xl:col-span-3">

						<div class="avatar group relative size-24 min-w-24 cursor-pointer overflow-hidden rounded-full">

							<div class="bg-base-200 p-1 pb-0">

								<img src="/images/avatars/1.png" alt="Avatar"/>

							</div>

							<div class="absolute right-0 -bottom-8 left-0 h-6 w-full bg-black/60 text-center text-sm font-medium text-white opacity-0 backdrop-blur-xs transition-all group-hover:bottom-0 group-hover:opacity-100">Edit</div>

						</div>
						<dialog id="page-settings-avatar-modal" class="modal">
							<div class="modal-box">
								<div class="flex items-center justify-between"><p class="font-medium">Choose Avatar</p>
									<form method="dialog"><button class="btn btn-ghost btn-xs btn-circle" aria-label="Close upload file modal"><span class="iconify lucide--x size-4"></span></button></form>
								</div>
								<div class="mt-4">
									<div class="filepond--root filepond filepond--hopper" data-style-button-remove-item-position="left" data-style-button-process-item-position="right" data-style-load-indicator-position="right" data-style-progress-indicator-position="right" data-style-button-remove-item-align="false" style="height: 76px">
										<input class="filepond--browser" type="file" id="filepond--browser-c2z6kmp48" name="filepond" aria-controls="filepond--assistant-c2z6kmp48" aria-labelledby="filepond--drop-label-c2z6kmp48"/>
										<div class="filepond--drop-label" style="transform: translate3d(0px, 0px, 0px); opacity: 1;"><label for="filepond--browser-c2z6kmp48" id="filepond--drop-label-c2z6kmp48">Drag &amp; Drop your files or <span class="filepond--label-action" tabindex="0">Browse</span></label></div>
										<div class="filepond--list-scroller" style="transform: translate3d(0px, 0px, 0px);"><ul class="filepond--list" role="list"></ul></div>
										<div class="filepond--panel filepond--panel-root" data-scalable="true"><div class="filepond--panel-top filepond--panel-root"></div><div class="filepond--panel-center filepond--panel-root" style="transform: translate3d(0px, 8px, 0px) scale3d(1, 0.6, 1);"></div><div class="filepond--panel-bottom filepond--panel-root" style="transform: translate3d(0px, 68px, 0px);"></div></div>
										<span class="filepond--assistant" id="filepond--assistant-c2z6kmp48" role="alert" aria-live="polite" aria-relevant="additions"></span>
										<fieldset class="filepond--data"><legend>Files</legend></fieldset>
										<div class="filepond--drip"></div>
									</div>
									<div class="mt-5 text-end"><button class="btn btn-primary btn-sm"><span class="iconify lucide--arrow-up-from-line size-4"></span> Update</button></div>
								</div>
							</div>
							<form method="dialog" class="modal-backdrop"><button>close</button></form>
						</dialog>

						<div class="fieldset grid grow grid-cols-1 gap-5 lg:grid-cols-2">

							<div class="space-y-2">

								<label class="fieldset-label" for="name">Full Name</label>

								<label class="input w-full">

									@ui.IconSpan("lucide--user text-base-content/60", "size-4.5")

									<input type="text" class="grow" placeholder="Name" id="name" value="Denish Navadiya"/>

								</label>

							</div>

							<div class="space-y-2">

								<label class="fieldset-label">User</label>

								<label class="input w-full">

									<span class="label">nexus.com/</span>

									<input placeholder="username" type="text" value="withden"/>

								</label>

							</div>

							<div class="space-y-2">

								<label class="fieldset-label" for="email">Email</label>

								<label class="input w-full">

									@ui.IconSpan("lucide--mail text-base-content/60", "size-4.5")

									<input type="text" class="grow" placeholder="Email" id="email" value="withden.dev@gmail.com"/>

								</label>

							</div>

							<div class="space-y-2">

								<label class="fieldset-label" for="mobile">Mobile</label>

								<label class="input w-full">

									@ui.IconSpan("lucide--phone text-base-content/60", "size-4.5")

									<input type="text" class="grow" placeholder="Mobile" id="mobile" value="(+123) 9876543210"/>

								</label>

							</div>

						</div>

					</div>

				</div>

				<div class="grid grid-cols-1 gap-5 xl:grid-cols-5">

					<div class="xl:col-span-2">

						<div class="flex items-center gap-2">

							@ui.IconSpan("lucide--bell", "size-5")

							<p class="text-lg font-medium">Notifications</p>

						</div>

						<p class="text-base-content/60">Manage your notification settings and preferences</p>

					</div>

					<div class="gap-5 xl:col-span-3">

						<div class="fieldset grid grid-cols-1 gap-5 lg:grid-cols-3">

							<div class="space-y-2">

								<label class="fieldset-label" for="notification-channel">Channel</label>

								<select class="select w-full" aria-label="Notification Channel" id="notification-channel">

									<option value="email">Email</option>

									<option value="in-app" selected>In App</option>

									<option value="sms">SMS</option>

									<option value="none">None</option>

								</select>

							</div>

							<div class="space-y-2">

								<label class="fieldset-label" for="notification-new-order">Notify on new order</label>

								<select class="select w-full" aria-label="New Order" id="notification-new-order">

									<option value="all">All</option>

									<option value="important" selected>Important</option>

									<option value="mention">only @mention</option>

									<option value="none">None</option>

								</select>

							</div>

							<div class="space-y-2">

								<label class="fieldset-label" for="notification-activity">Activity Updates</label>

								<select class="select w-full" aria-label="Activity Updates" id="notification-activity">

									<option value="all-activity">All Activity</option>

									<option value="important-activity">Important Activity Only</option>

									<option value="mention" selected>Only @mention</option>

									<option value="none">No Notifications</option>

								</select>

							</div>

						</div>

					</div>

				</div>

				<div class="grid grid-cols-1 gap-5 xl:grid-cols-5">

					<div class="xl:col-span-2">

						<div class="flex items-center gap-2">

							@ui.IconSpan("lucide--calendar-cog", "size-5")

							<p class="text-lg font-medium">Time Preferences</p>

						</div>

						<p class="text-base-content/60">Set your timezone and time format</p>

					</div>

					<div class="gap-5 xl:col-span-3">

						<div class="fieldset grid grid-cols-1 gap-5 lg:grid-cols-3">

							<div class="space-y-2">

								<label class="fieldset-label" for="timezone">Timezone</label>

								<select class="select w-full" aria-label="Timezone" id="timezone">

									<option value="america-toronto">GMT-5:00 – Toronto (EST)</option>

									<option value="america-chicago">GMT-6:00 – Chicago(CST)</option>

									<option value="america-denver">GMT-7:00 – Calgary (MST)</option>

									<option value="america-losangeles">GMT-8:00 – Vancouver (PST)</option>

									<option value="asia-kolkata" selected>GMT+5:30 – Mumbai (IST)</option>

								</select>

							</div>

							<div class="space-y-2">

								<label class="fieldset-label" for="datetime-format">Datetime Format</label>

								<select class="select w-full" aria-label="Time & Date Format" id="datetime-format">

									<option value="12-hour" selected>12-hour (AM/PM)</option>

									<option value="24-hour">24-hour</option>

									<option value="dd-mm-yyyy">DD/MM/YYYY</option>

									<option value="mm-dd-yyyy">MM/DD/YYYY</option>

									<option value="yyyy-mm-dd">YYYY/MM/DD</option>

								</select>

							</div>

							<div class="space-y-2">

								<label class="fieldset-label" for="datetime-first-day">First day of week</label>

								<select class="select w-full" aria-label="First day of week" id="datetime-first-day">

									<option value="sunday" selected>Sunday</option>

									<option value="monday">Monday</option>

								</select>

							</div>

						</div>

					</div>

				</div>

			</div>

		</div>

		<div class="mt-6 flex justify-between gap-4 max-sm:flex-col-reverse">

			<div class="text-sm">

				<p>You might looking for:</p>

				<ul class="text-base-content/80 mt-2">

					<li class="link link-hover">Manage users</li>

					<li class="link link-hover">Security &amp; roles</li>

					<li class="link link-hover">Payment preference</li>

				</ul>

			</div>

			<div class="flex justify-end gap-3">

				<a href="#" class="btn btn-sm btn-ghost">

					@ui.IconSpan("lucide--x", "size-4")

					Cancel

				</a>

				<a href="#" class="btn btn-sm btn-primary">

					@ui.IconSpan("lucide--arrow-up-from-line", "size-4")

					Update

				</a>

			</div>

		</div>

	</div>

}

// ── Get Help ────────────────────────────────────────────────────────────────

templ GetHelpPage() {

	<div class="min-sm:container" { devmode.Attrs(ctx, "nexus/GetHelpPage")... }>

		<div class="bg-primary/10 rounded-box relative w-full overflow-hidden p-6">

			<div class="flex justify-between">

				<div>

		<div class="flex items-center gap-1">

								<p class="text-base-content/80 text-sm">Pages</p>

								@ui.IconSpan("lucide--chevron-right text-base-content/80", "size-3.5")

								<p class="text-sm">Support</p>

							</div>

							<p class="text-primary mt-4 text-xl font-medium">Get Help</p>

					<p class="text-base-content/80">Find answers to common questions and learn how to use the platform effectively</p>

				</div>

				<div class="flex flex-col items-end justify-between">

					<button class="btn btn-sm btn-primary max-xl:btn-square">

						@ui.IconSpan("lucide--plus", "size-4")

						<span class="max-xl:hidden">Create a Ticket</span>

					</button>

					<div class="text-base-content/60 flex items-center gap-2 max-xl:hidden">

						@ui.IconSpan("lucide--ticket-check", "size-4")

						<p class="text-sm">Your last ticket has been resolved</p>

					</div>

				</div>

			</div>

			@ui.IconSpan("lucide--badge-help text-primary/5 absolute start-1/2 -bottom-12 size-44", "-rotate-25")

		</div>

		<div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">

			@helpTopicCard("Getting Started", "Learn how to set up your account and navigate the dashboard.")

			@helpTopicCard("User Management", "Manage user roles, permissions, and access control settings.")

			@helpTopicCard("Customization", "Adjust settings, themes, and preferences to personalize your experience.")

			@helpTopicCard("Integrations", "Connect with third-party services and APIs to extend functionality.")

			@helpTopicCard("Troubleshooting", "Find solutions to common issues and errors encountered in the system.")

			@helpTopicCard("Billing & Subscription", "Understand pricing plans, payment methods, and subscription management.")

			@helpTopicCard("Security & Privacy", "Learn about security best practices and how your data is protected.")

			@helpTopicCard("Reports & Analytics", "Generate and analyze reports to track system performance and insights.")

		</div>

		<p class="mt-12 text-center text-2xl font-medium">Frequently Asked Questions</p>

		<p class="text-base-content/80 text-center">Find answers to common questions about system features, settings, and troubleshooting.</p>

		<div class="mt-8 grid gap-8 md:grid-cols-2">

			<div class="card bg-base-100 h-fit shadow">

				<div class="card-body pb-0">

					<div class="badge badge-sm badge-ghost">Control</div>

					<p class="text-lg font-medium">User Management queries</p>

					<div class="-mx-4 mt-2">

						<div class="collapse-plus collapse">

							<input type="radio" aria-label="Accordion radio" class="cursor-pointer" name="accordion-um"/>

							<div class="collapse-title cursor-pointer">How do I add a new user?</div>

							<div class="collapse-content">Go to the 'User Management' section, click 'Add User', fill in the required details, and submit.</div>

						</div>

						<div class="collapse-plus collapse">

							<input type="radio" aria-label="Accordion radio" class="cursor-pointer" name="accordion-um"/>

							<div class="collapse-title cursor-pointer">How can I change a user's role?</div>

							<div class="collapse-content">Navigate to 'User Management', select the user, click 'Edit', and update their role before saving.</div>

						</div>

						<div class="collapse-plus collapse">

							<input type="radio" aria-label="Accordion radio" class="cursor-pointer" name="accordion-um"/>

							<div class="collapse-title cursor-pointer">Can I deactivate a user instead of deleting them?</div>

							<div class="collapse-content">Yes, you can disable a user account by setting their status to 'Inactive' in the user settings.</div>

						</div>

						<div class="collapse-plus collapse">

							<input type="radio" aria-label="Accordion radio" class="cursor-pointer" name="accordion-um"/>

							<div class="collapse-title cursor-pointer">How do I reset a user's password?</div>

							<div class="collapse-content">Admins can reset passwords by selecting the user in 'User Management' and clicking 'Reset Password'. An email will be sent to the user.</div>

						</div>

					</div>

				</div>

			</div>

			<div class="card bg-base-100 h-fit shadow">

				<div class="card-body pb-0">

					<div class="badge badge-sm badge-ghost">Platform</div>

					<p class="text-lg font-medium">System related queries</p>

					<div class="-mx-4 mt-2">

						<div class="collapse-plus collapse">

							<input type="radio" aria-label="Accordion radio" class="cursor-pointer" name="accordion-sys"/>

							<div class="collapse-title cursor-pointer">Where can I update the system settings?</div>

							<div class="collapse-content">Navigate to the 'Settings' section in the admin panel to configure system preferences, security options, and more.</div>

						</div>

						<div class="collapse-plus collapse">

							<input type="radio" aria-label="Accordion radio" class="cursor-pointer" name="accordion-sys"/>

							<div class="collapse-title cursor-pointer">How do I enable or disable maintenance mode?</div>

							<div class="collapse-content">Go to 'Settings' &gt; 'System Configuration' and toggle the maintenance mode option to enable or disable it.</div>

						</div>

						<div class="collapse-plus collapse">

							<input type="radio" aria-label="Accordion radio" class="cursor-pointer" name="accordion-sys"/>

							<div class="collapse-title cursor-pointer">Can I change the default timezone for the system?</div>

							<div class="collapse-content">Yes, you can update the system timezone in 'Settings' under 'General Preferences'.</div>

						</div>

						<div class="collapse-plus collapse">

							<input type="radio" aria-label="Accordion radio" class="cursor-pointer" name="accordion-sys"/>

							<div class="collapse-title cursor-pointer">How do I configure email notifications?</div>

							<div class="collapse-content">Navigate to 'Settings' &gt; 'Email Configuration' to set up SMTP settings and customize notification templates.</div>

						</div>

					</div>

				</div>

			</div>

		</div>

	</div>

}

templ helpTopicCard(title, description string) {

	<div class="card card-border bg-base-100 hover:bg-primary hover:text-primary-content group hover:border-primary cursor-pointer transition-all">

		<div class="card-body">

			<div class="flex justify-between">

				<p class="font-medium">{ title }</p>

				@ui.IconSpan("lucide--arrow-right text-primary-content -translate-x-2 opacity-0 transition-all group-hover:translate-x-0", "group-hover:opacity-100")

			</div>

			<p class="mt-1 line-clamp-2 text-sm overflow-ellipsis">{ description }</p>

		</div>

	</div>

}

