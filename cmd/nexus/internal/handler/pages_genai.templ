package handler

import (
	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/nav"
	"github.com/emergent-company/go-daisy/components/table"
	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

// GenAIHome renders the Gen AI landing/workspace: a centered gradient greeting,
// three suggestion cards, and a prompt composer.
templ GenAIHome() {
	<div class="flex flex-col items-center justify-center md:mt-16 lg:mt-24 xl:mt-32" { devmode.Attrs(ctx, "nexus/GenAIHome")... }>
		<div class="max-w-4xl">
			<div class="from-base-content to-primary inline-block bg-gradient-to-tr from-40% bg-clip-text text-2xl font-semibold tracking-tight text-transparent sm:text-4xl">
				<p>Hi there, Denish</p>
				<p class="mt-1">How can I assist you today?</p>
			</div>
			<div class="mt-6 grid gap-6 md:grid-cols-3">
				@genAISuggestionCard("lucide--sparkles", "bg-primary text-primary-content", "Blog Post Ideas", "Generate compelling blog topics that captivate your audience and enhance SEO.", "Explore Ideas")
				@genAISuggestionCard("lucide--mail", "bg-secondary text-secondary-content", "Email Campaigns", "Create high-converting email copy that boosts engagement and builds lasting connections.", "Start Campaign")
				@genAISuggestionCard("lucide--text", "bg-success text-success-content", "Social Media Captions", "Generate catchy captions designed to maximize engagement across social platforms.", "Generate Captions")
			</div>
			@genAIComposer()
		</div>
	</div>
}

templ genAISuggestionCard(icon, toneClass, title, desc, action string) {
	@ui.CardRaw(ui.CardRawProps{Class: "group cursor-pointer transition-all"}) {
		<div class={ "rounded-box w-fit p-2", toneClass }>
			@ui.IconSpan(icon, "block size-4")
		</div>
		<p class="mt-3 font-medium">{ title }</p>
		<p class="text-body mt-1 line-clamp-2 text-sm text-ellipsis">{ desc }</p>
		<div class="text-muted group-hover:text-base-content mt-3 flex items-center gap-1.5 transition-all">
			<span class="text-sm">{ action }</span>
			@ui.IconSpan("lucide--chevron-right", "size-3.5")
		</div>
	}
}

templ genAIComposer() {
	@ui.CardRaw(ui.CardRawProps{Class: "mt-6", BodyClass: "p-3"}) {
		@form.FormField(form.FormFieldProps{
			Type:        form.FieldTextarea,
			Name:        "prompt",
			Placeholder: "Let us know what you need...",
			Class:       "m-0 h-24 resize-none border-0 p-0 text-base focus:outline-none",
		})
		<div class="mt-2 flex items-end justify-between">
			<div class="inline-flex items-center gap-0.5">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Shape: ui.ButtonShapeCircle, AriaLabel: "Voice input"}) {
					@ui.IconSpan("lucide--mic", "text-body size-4.5")
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Shape: ui.ButtonShapeCircle, AriaLabel: "Attach image"}) {
					@ui.IconSpan("lucide--image-plus", "text-body size-4.5")
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Shape: ui.ButtonShapeCircle, AriaLabel: "Attach file"}) {
					@ui.IconSpan("lucide--paperclip", "text-body size-4.5")
				}
			</div>
			<div class="text-muted flex items-center text-xs font-medium">
				Usage Limit:
				<span class="text-error ms-1">Active</span>
				<div class="tooltip">
					<div class="tooltip-content bg-base-100 text-base-content p-3 text-start font-normal shadow">
						<p class="font-semibold">Usage Summary:</p>
						<p class="mt-2">Today: 47 tokens</p>
						<p class="mt-0.5">Total: 158 tokens</p>
					</div>
					@ui.IconSpan("lucide--help-circle", "ms-1 block size-3")
				</div>
			</div>
			<div class="flex items-center gap-2">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Style: ui.ButtonStyleOutline, Size: ui.ButtonSM, ExtraClass: "border-base-300 rounded-full"}) {
					@ui.IconSpan("lucide--globe", "text-body size-4")
					Search
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Style: ui.ButtonStyleOutline, Size: ui.ButtonSM, ExtraClass: "border-base-300 rounded-full"}) {
					@ui.IconSpan("lucide--brain-cog", "text-body size-4")
					Brainstorm
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonPrimary, Size: ui.ButtonSM, Shape: ui.ButtonShapeCircle, AriaLabel: "Send"}) {
					@ui.IconSpan("lucide--arrow-right", "size-4")
				}
			</div>
		</div>
	}
}

// GenAIContent renders the Chat content-generation workspace: a settings column
// (Information + Language options) beside a History conversation column.
templ GenAIContent() {
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  "Chat",
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Apps"},
			{Label: "Chat"},
		},
	})
	<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-5 2xl:grid-cols-10">
		<div class="xl:col-span-2 2xl:col-span-3">
			<div class="space-y-6">
				@genAIContentInfoCard()
				@genAIContentLanguageCard()
			</div>
		</div>
		<div class="xl:col-span-3 2xl:col-span-7">
			@genAIContentHistory()
		</div>
	</div>
}

templ genAIContentInfoCard() {
	@ui.CardRaw(ui.CardRawProps{}) {
		<div class="card-title text-base font-medium">Information</div>
		<div class="fieldset mt-2">
			@form.FormField(form.FormFieldProps{
				Type:        form.FieldTextarea,
				Name:        "content",
				Label:       "Content",
				Placeholder: "Join [Company Name] as a UI Designer and craft user-friendly, visually stunning interfaces. Collaborate with...",
				Class:       "h-36 pb-0 leading-5",
				Attrs:       templ.Attributes{"aria-label": "Textarea"},
			})
			@form.FormField(form.FormFieldProps{
				Type:        form.FieldText,
				Name:        "keywords",
				Label:       "Keywords are included",
				Placeholder: "react, dashboard, nextjs, ....",
			})
		</div>
	}
}

templ genAIContentLanguageCard() {
	@ui.CardRaw(ui.CardRawProps{}) {
		<div class="card-title text-base font-medium">Language options</div>
		<div class="border-success/20 bg-success/5 rounded-box my-2.5 border p-3 text-sm">
			<span class="font-medium">Beta:</span>
			This feature is currently accessible to a limited group of beta users.
		</div>
		<div class="fieldset">
			<div class="flex gap-4">
				<div class="grow">
					@form.FormField(form.FormFieldProps{
						Type:  form.FieldSelect,
						Name:  "voice-tone",
						Label: "Voice Tone",
						Value: "Formal",
						Options: []form.SelectOption{
							{Value: "Formal", Label: "Formal"},
							{Value: "Casual", Label: "Casual"},
							{Value: "Persuasive", Label: "Persuasive"},
							{Value: "Friendly", Label: "Friendly"},
							{Value: "Neutral", Label: "Neutral"},
						},
					})
				</div>
				<div class="grow">
					@form.FormField(form.FormFieldProps{
						Type:        form.FieldNumber,
						Name:        "creative",
						Label:       "How creative it be",
						Value:       "0.6",
						Placeholder: "0.6",
						Attrs:       templ.Attributes{"min": "0", "max": "1", "step": "0.1"},
					})
				</div>
			</div>
			<div class="mt-2 flex items-end gap-4">
				<div class="grow">
					@form.FormField(form.FormFieldProps{
						Type:  form.FieldSelect,
						Name:  "input-voice",
						Label: "Input Voice",
						Value: "en",
						Options: []form.SelectOption{
							{Value: "en", Label: "English"},
							{Value: "es", Label: "Spanish"},
							{Value: "fr", Label: "French"},
							{Value: "de", Label: "German"},
							{Value: "it", Label: "Italian"},
						},
					})
				</div>
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Size: ui.ButtonSM, Shape: ui.ButtonShapeCircle, ExtraClass: "mb-1", AriaLabel: "Swap voices"}) {
					@ui.IconSpan("lucide--arrow-left-right", "size-4")
				}
				<div class="grow">
					@form.FormField(form.FormFieldProps{
						Type:  form.FieldSelect,
						Name:  "output-voice",
						Label: "Output Voice",
						Value: "fr",
						Options: []form.SelectOption{
							{Value: "en", Label: "English"},
							{Value: "es", Label: "Spanish"},
							{Value: "fr", Label: "French"},
							{Value: "de", Label: "German"},
							{Value: "it", Label: "Italian"},
						},
					})
				</div>
			</div>
		</div>
		<div class="mt-5 flex justify-end gap-3">
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"disabled": ""}}) {
				Stop
			}
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonPrimary, Size: ui.ButtonSM}) {
				@ui.IconSpan("lucide--wand-2", "size-3.5")
				Generate
			}
		</div>
	}
}

templ genAIContentHistory() {
	<div class="bg-base-100 card edge-line">
		<div class="border-base-200 flex items-center justify-between border-b py-2.5 ps-5 pe-2.5">
			<div class="inline-flex items-center gap-3">
				@ui.IconSpan("lucide--file-clock", "size-4.5")
				<span>History</span>
			</div>
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM}) {
				Clear history
			}
		</div>
		<div class="card-body p-0">
			@ui.ChatWindow("h-[calc(100vh_-_220px)]", nil) {
				<div class="text-center">
					<div class="bg-base-200 inline-flex cursor-pointer items-center gap-1 rounded-full px-3 py-1 text-xs opacity-70 transition-all hover:opacity-100">
						@ui.IconSpan("lucide--arrow-up", "size-3")
						Older
					</div>
				</div>
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: true, Timestamp: "Weeks ago", BubbleClass: "bg-base-200"}) {
					Can you provide an estimated timeline for completion?
				}
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: false, BotIcon: true, Timestamp: "Week ago", BubbleClass: "bg-base-200", ShowActions: true}) {
					Certainly! Based on our current progress, we estimate the project will be completed within 4-6 weeks. Let me know if you'd like a detailed breakdown.
				}
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: true, Timestamp: "30 minutes ago", BubbleClass: "bg-base-200"}) {
					Can you generate a random image?
				}
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: false, BotIcon: true, Timestamp: "30 minutes ago", BubbleClass: "bg-base-200", ShowActions: true}) {
					Here is your random image.
					<img class="rounded-box mt-1" alt="Gen Image" src="/images/apps/ai/gen-10.jpg"/>
				}
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: true, Timestamp: "2 hours ago", BubbleClass: "bg-base-200"}) {
					Do you have any suggestions for improvement?
				}
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: false, BotIcon: true, Timestamp: "2 hours ago", BubbleClass: "bg-base-200", ShowActions: true}) {
					Certainly! One suggestion would be to focus more on user feedback during the early stages of development.
				}
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: true, Timestamp: "1 minute ago", BubbleClass: "bg-base-200"}) {
					What are the next steps?
				}
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: false, BotIcon: true, Timestamp: "Now", BubbleClass: "bg-base-200", ShowActions: true}) {
					Next, we can schedule a meeting to discuss the implementation details. Does that work for you?
				}
				@ui.ChatBubble(ui.ChatBubbleProps{Sent: true, Timestamp: "now", BubbleClass: "bg-base-200"}) {
					Follow-Up on all conversations
				}
				@ui.AIThinkingIndicator()
			}
		</div>
	</div>
}

// GenAIImage renders the Image Gen workspace: a Configure panel beside an
// Images gallery grid with type chips and hover actions.
templ GenAIImage() {
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  "Image Gen",
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Gen Ai"},
			{Label: "Image Gen"},
		},
	})
	<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-5 2xl:grid-cols-10">
		<div class="xl:col-span-2 2xl:col-span-3">
			<div class="space-y-6">
				@genAIImageConfigureCard()
			</div>
		</div>
		<div class="xl:col-span-3 2xl:col-span-7">
			@genAIImageGallery()
		</div>
	</div>
}

templ genAIImageConfigureCard() {
	@ui.CardRaw(ui.CardRawProps{BodyClass: "gap-0"}) {
		<div class="card-title text-base font-medium">Configure</div>
		<div class="fieldset mt-2 gap-4">
			@form.FormField(form.FormFieldProps{
				Type:        form.FieldTextarea,
				Name:        "describe",
				Label:       "Describe your image",
				Placeholder: "E.g., A sunny beach with clear blue water",
				Class:       "h-16 pb-0 leading-5",
				Attrs:       templ.Attributes{"aria-label": "Textarea"},
			})
			@form.FormField(form.FormFieldProps{
				Type:  form.FieldSelect,
				Name:  "engine",
				Label: "Engine",
				Value: "Stable Diffusion",
				Options: []form.SelectOption{
					{Value: "Stable Diffusion", Label: "Stable Diffusion"},
					{Value: "DALL·E", Label: "DALL·E"},
					{Value: "MidJourney", Label: "MidJourney"},
					{Value: "DeepAI", Label: "DeepAI"},
					{Value: "RunwayML", Label: "RunwayML"},
				},
			})
			<div class="grid grid-cols-2 gap-4">
				@form.FormField(form.FormFieldProps{
					Type:  form.FieldSelect,
					Name:  "image-size",
					Label: "Image Size",
					Value: "512x512",
					Options: []form.SelectOption{
						{Value: "512x512", Label: "512x512"},
						{Value: "1024x1024", Label: "1024x1024"},
						{Value: "1920x1080", Label: "1920x1080"},
						{Value: "2048x2048", Label: "2048x2048"},
						{Value: "Portrait", Label: "Portrait"},
						{Value: "Landscape", Label: "Landscape"},
					},
				})
				@form.FormField(form.FormFieldProps{
					Type:  form.FieldSelect,
					Name:  "image-number",
					Label: "Images",
					Value: "2",
					Options: []form.SelectOption{
						{Value: "1", Label: "1"},
						{Value: "2", Label: "2"},
						{Value: "3", Label: "3"},
						{Value: "4", Label: "4"},
						{Value: "5", Label: "5"},
						{Value: "6", Label: "6"},
					},
				})
			</div>
			@form.Label(form.LabelProps{}) {
				Type
			}
			<div class="grid grid-cols-3 gap-2 sm:grid-cols-5 lg:grid-cols-3">
				@genAITypeTile("/images/apps/ai/type-3d.jpg", "3D", true)
				@genAITypeTile("/images/apps/ai/type-anime.jpg", "Anime", false)
				@genAITypeTile("/images/apps/ai/type-realistic.jpg", "Realistic", false)
				@genAITypeTile("/images/apps/ai/type-abstract.jpg", "Abstract", false)
				@genAITypeTile("/images/apps/ai/type-sketch.jpg", "Sketch", false)
			</div>
		</div>
		<div class="mt-5 flex justify-end gap-3">
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Attrs: templ.Attributes{"disabled": ""}}) {
				Stop
			}
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonPrimary, Size: ui.ButtonSM}) {
				@ui.IconSpan("lucide--wand-2", "size-3.5")
				Generate
			}
		</div>
	}
}

templ genAITypeTile(src, label string, active bool) {
	<div class={ "hover:bg-base-200 rounded-box cursor-pointer border border-transparent p-1 transition-all", templ.KV("!border-primary/20 !bg-primary/10 text-primary font-medium", active) }>
		<img class="rounded-box" src={ src } alt={ label }/>
		<p class="mt-1 text-center text-sm">{ label }</p>
	</div>
}

templ genAIImageGallery() {
	<div class="bg-base-100 card edge-line">
		<div class="flex items-center justify-between p-5 pb-0">
			<div>
				<div class="flex items-center gap-2">
					<div class="bg-primary text-primary-content rounded-box inline-flex items-center p-1.5">
						@ui.IconSpan("lucide--book-image", "size-4")
					</div>
					<p class="font-medium">Images</p>
				</div>
				<p class="text-body text-sm">
					<span class="text-error">Note:</span>
					cloud sync is disabled.
					<span class="link link-primary link-hover ms-1">
						Start sync?
					</span>
				</p>
			</div>
			<div class="text-center">
				<p class="text-body text-sm">
					Available Tokens
				</p>
				<p class="text-lg font-medium">
					961
					<span class="text-muted ms-1 text-sm">
						/1000
					</span>
				</p>
			</div>
			<div class="bg-base-200 rounded-box hidden items-center gap-3 py-2 ps-3 pe-2 2xl:inline-flex">
				<p class="text-sm">Trial period has ended</p>
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Size: ui.ButtonSM, ExtraClass: "btn-warning"}) {
					Upgrade
				}
			</div>
		</div>
		<hr class="border-base-300 mt-5 w-full border-dashed"/>
		<div class="card-body">
			<div class="flex flex-wrap gap-2.5">
				@genAITypeChip("3D", true)
				@genAITypeChip("Anime", false)
				@genAITypeChip("Realistic", false)
				@genAITypeChip("Abstract", false)
				@genAITypeChip("Sketch", false)
			</div>
			@genAIImageSection("Watercolor Painting", "8", "Stable diffusion", "mt-5", "mt-2 grid grid-cols-3 gap-5 md:grid-cols-5 lg:grid-cols-3 xl:grid-cols-5", []string{"/images/apps/ai/gen-1.jpg", "/images/apps/ai/gen-2.jpg", "/images/apps/ai/gen-3.jpg", "/images/apps/ai/gen-4.jpg", "/images/apps/ai/gen-5.jpg"})
			@genAIImageSection("3D Elements", "10+", "Deep AI", "mt-5", "mt-2 grid grid-cols-3 gap-5 md:grid-cols-5", []string{"/images/apps/ai/gen-6.jpg", "/images/apps/ai/gen-7.jpg", "/images/apps/ai/gen-8.jpg", "/images/apps/ai/gen-9.jpg", "/images/apps/ai/gen-10.jpg"})
			<div class="mt-5 text-center">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Size: ui.ButtonSM}) {
					@ui.IconSpan("lucide--arrow-down", "size-3.5")
					Load more
				}
			</div>
		</div>
	</div>
}

templ genAITypeChip(label string, active bool) {
	<div class={ "rounded-box cursor-pointer border px-2.5 py-0.5 transition-all", templ.KV("border-primary/20 bg-primary/10 text-primary", active), templ.KV("bg-base-200 hover:bg-base-300 border-transparent", !active) }>
		{ label }
	</div>
}

templ genAIImageSection(title, count, engine, sectionClass, gridClass string, images []string) {
	<div class={ sectionClass + " flex items-center justify-between gap-2" }>
		<p class="font-medium">{ title }</p>
		<div class="hidden items-center gap-5 md:flex">
			@genAIImageMeta("lucide--image-down", "Download All")
			@genAIImageMeta("lucide--book-image", count)
			@genAIImageMeta("lucide--cpu", engine)
		</div>
	</div>
	<div class={ gridClass }>
		for _, src := range images {
			@genAIImageTile(src)
		}
	</div>
}

templ genAIImageMeta(icon, text string) {
	<div class="text-muted hover:text-base-content inline-flex cursor-pointer items-center gap-2 transition-all">
		@ui.IconSpan(icon, "size-3.5")
		<p class="text-sm">{ text }</p>
	</div>
}

templ genAIImageTile(src string) {
	<div class="group relative">
		<img class="rounded-box" src={ src } alt={ src }/>
		<div class="rounded-box absolute start-1/2 bottom-0 flex -translate-x-1/2 scale-75 items-center justify-around gap-2 bg-black/60 px-2 py-1.5 text-white opacity-0 backdrop-blur-sm transition-all group-hover:bottom-4 group-hover:scale-100 group-hover:opacity-100">
			<div class="rounded-box cursor-pointer p-1 hover:bg-white/20">
				@ui.IconSpan("lucide--arrow-down-to-line", "block size-3.5")
			</div>
			<div class="rounded-box cursor-pointer p-1 hover:bg-white/20">
				@ui.IconSpan("lucide--palette", "block size-3.5")
			</div>
			<div class="rounded-box cursor-pointer p-1 hover:bg-white/20">
				@ui.IconSpan("lucide--image-plus", "block size-3.5")
			</div>
			<div class="rounded-box cursor-pointer p-1 hover:bg-white/20">
				@ui.IconSpan("lucide--maximize", "block size-3.5")
			</div>
		</div>
	</div>
}

// GenAILibrary renders the Image Gen library: a filter toolbar, a data table of
// generated items, a per-page/footer, and a confirm-delete dialog.
templ GenAILibrary() {
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  "Image Gen",
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Gen Ai"},
			{Label: "Image Gen"},
		},
	})
	<div class="mt-6">
		@table.TableCard(table.TableCardProps{
			Toolbar: genAILibraryToolbar(),
			Footer:  genAILibraryFooter(),
		}) {
			<div class="mt-4 overflow-auto">
				@table.TableWithProps(table.TableProps{Class: "whitespace-nowrap"}) {
					@table.TableHead() {
						@table.TableHeadRow() {
							@table.TableSelectAll("Check all")
							@table.TableHeadCell("ID")
							@table.TableHeadCell("User")
							@table.TableHeadCell("Type")
							@table.TableHeadCell("Title")
							@table.TableHeadCell("Content")
							@table.TableHeadCell("Tokens")
							@table.TableHeadCell("Action")
						}
					}
					@table.TableBody() {
						@genAILibraryRow("1", "Sophia Turner", "1", "lucide--image", "Image", "AI Art Generator", "Create stunning digital art with AI-powered tools. Provide a prompt, and let the AI bring your vision to life.", "50")
						@genAILibraryRow("2", "Ethan Roberts", "2", "lucide--text", "Text", "Text Summarizer", "Summarize lengthy documents or articles into concise, easy-to-digest information.", "30")
						@genAILibraryRow("3", "Olivia Martinez", "3", "lucide--code", "Code", "Code Helper", "Get suggestions, refactor code, and find solutions to common programming challenges.", "70")
						@genAILibraryRow("4", "James Cooper", "4", "lucide--image", "Image", "Photo Enhancer", "Enhance image quality, remove noise, and upscale resolution with AI-powered enhancements.", "40")
						@genAILibraryRow("5", "Isabella Lewis", "5", "lucide--text", "Text", "Grammar and Style Checker", "Polish your writing with advanced grammar checks and style suggestions.", "20")
						@genAILibraryRow("6", "Liam Carter", "6", "lucide--code", "Code", "Code Explainer", "Understand complex code snippets with detailed explanations generated by AI.", "60")
						@genAILibraryRow("7", "Emily Scott", "7", "lucide--text", "Text", "Prompt Optimizer", "Optimize your AI prompts for better output and improved results.", "25")
						@genAILibraryRow("8", "Noah Bennett", "8", "lucide--image", "Image", "3D Model Generator", "Generate 3D models and designs with AI-driven creativity and precision.", "80")
						@genAILibraryRow("9", "Charlotte Edwards", "9", "lucide--text", "Text", "Story Generator", "Create captivating stories and narratives with the help of AI storytelling tools.", "45")
						@genAILibraryRow("10", "William Harris", "10", "lucide--image", "Image", "AI Diagram Maker", "Quickly create flowcharts, diagrams, and visualizations tailored to your needs.", "55")
					}
				}
			</div>
		}
		@genAILibraryDeleteDialog()
	</div>
}

templ genAILibraryToolbar() {
	@table.TableCardHeader() {
		<div class="inline-flex items-center gap-3">
			@form.SearchInput("q", "", "Search along items", "", "", "input input-sm w-24 sm:w-36", templ.Attributes{"aria-label": "Search items"})
		</div>
		<div class="inline-flex items-center gap-3">
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLink, Href: "/apps/gen-ai/image", Variant: ui.ButtonPrimary, Size: ui.ButtonSM, ExtraClass: "max-sm:btn-square", AriaLabel: "Generate image link"}) {
				@ui.IconSpan("lucide--wand-2", "size-3.5")
				<span class="max-sm:hidden">Generate</span>
			}
			<div class="dropdown dropdown-bottom dropdown-end">
				<div role="button" class="btn btn-ghost border-base-300 btn-sm btn-square" aria-label="More option" tabindex="0">
					@ui.IconSpan("lucide--settings-2", "size-4")
				</div>
				<div class="dropdown-content bg-base-100 rounded-box z-1 w-52 shadow" tabindex="0">
					<ul class="menu w-full p-2">
						<li>
							<div>@ui.IconSpan("lucide--wand", "size-4") Bulk Actions</div>
						</li>
					</ul>
					<hr class="border-base-300"/>
					<ul class="menu w-full p-2">
						<li>
							<div>@ui.IconSpan("lucide--download-cloud", "size-4") Import from Store</div>
						</li>
						<li>
							<div>@ui.IconSpan("lucide--copy-plus", "size-4") Create from Existing</div>
						</li>
					</ul>
				</div>
			</div>
		</div>
	}
}

templ genAILibraryRow(id, name, avatar, icon, typ, title, content, tokens string) {
	@table.TableRow("", true, templ.Attributes{"class": "hover:bg-base-200/40 cursor-pointer *:text-nowrap"}) {
		@table.TableSelectRow("", false)
		@table.TableCell("font-medium", nil) {
			{ id }
		}
		@table.TableCell("", nil) {
			<div class="flex items-center space-x-3 truncate">
				@ui.AvatarFull(ui.AvatarProps{
					Name:       name,
					Src:        "/images/avatars/" + avatar + ".png",
					Size:       ui.AvatarMD,
					Mask:       "mask mask-squircle",
					FrameClass: "bg-base-200",
				})
				<p class="font-medium">{ name }</p>
			</div>
		}
		@table.TableCell("", nil) {
			<div class="inline-flex items-center gap-1.5">
				@ui.IconSpan(icon, "size-4")
				{ typ }
			</div>
		}
		@table.TableCell("", nil) {
			<p class="text-nowrap">{ title }</p>
		}
		@table.TableCell("", nil) {
			<p class="line-clamp-2 max-w-80 min-w-48 text-ellipsis">{ content }</p>
		}
		@table.TableCell("text-sm font-medium", nil) {
			{ tokens }
		}
		@table.TableCell("", nil) {
			<div class="inline-flex">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Shape: ui.ButtonShapeSquare, AriaLabel: "Edit Library"}) {
					@ui.IconSpan("lucide--pencil", "size-4")
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Shape: ui.ButtonShapeSquare, AriaLabel: "Show Library"}) {
					@ui.IconSpan("lucide--eye", "size-4")
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonError, Style: ui.ButtonStyleOutline, Size: ui.ButtonSM, Shape: ui.ButtonShapeSquare, ExtraClass: "border-transparent", AriaLabel: "Dummy delete customer", OnClick: templ.JSFuncCall("apps_ai_library_delete.showModal()")}) {
					@ui.IconSpan("lucide--trash", "size-4")
				}
			</div>
		}
	}
}

templ genAILibraryFooter() {
	<div class="flex items-center justify-between p-6">
		<div class="text-body flex gap-2 text-sm">
			<span class="hidden sm:inline">Per page</span>
			@form.FilterSelect("pageSize", "", "", "select-xs w-18") {
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
				<option value="100">100</option>
			}
		</div>
		<span class="text-body hidden text-sm lg:inline">
			Showing
			<span class="text-base-content font-medium">1 to 10</span>
			of 457 items
		</span>
		<div class="inline-flex items-center gap-1">
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonXS, Shape: ui.ButtonShapeCircle, ExtraClass: "sm:btn-sm", AriaLabel: "Prev"}) {
				@ui.IconSpan("lucide--chevron-left", "")
			}
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonPrimary, Size: ui.ButtonXS, Shape: ui.ButtonShapeCircle, ExtraClass: "sm:btn-sm"}) {
				1
			}
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonXS, Shape: ui.ButtonShapeCircle, ExtraClass: "sm:btn-sm"}) {
				2
			}
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonXS, Shape: ui.ButtonShapeCircle, ExtraClass: "sm:btn-sm"}) {
				3
			}
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Size: ui.ButtonXS, Shape: ui.ButtonShapeCircle, ExtraClass: "sm:btn-sm", AriaLabel: "Next"}) {
				@ui.IconSpan("lucide--chevron-right", "")
			}
		</div>
	</div>
}

templ genAILibraryDeleteDialog() {
	<dialog id="apps_ai_library_delete" class="modal">
		<div class="modal-box">
			<div class="flex items-center justify-between text-lg font-medium">
				Confirm Delete
				<form method="dialog">
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Shape: ui.ButtonShapeCircle, AriaLabel: "Close modal"}) {
						@ui.IconSpan("lucide--x", "size-4")
					}
				</form>
			</div>
			<p class="py-4">
				You are about to delete this item. Would you like to proceed further ?
			</p>
			<div class="modal-action">
				<form method="dialog">
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonGhost, Size: ui.ButtonSM}) {
						No
					}
				</form>
				<form method="dialog">
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeSubmit, Variant: ui.ButtonError, Size: ui.ButtonSM}) {
						Yes, delete it
					}
				</form>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
}
