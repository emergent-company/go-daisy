package handler

import (
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

templ LandingPageFull() {
	@layout.PageFull(layout.PageProps{Title: "Nexus - Premium Admin Dashboard", ThemeAttr: ""}) {
		@LandingPage()
	}
}

templ LandingPage() {
	<div class="min-h-screen" { devmode.Attrs(ctx, "nexus/LandingPage")... }>
		@landingTopbar()
		@landingHero()
		@landingFeatures()
		@landingShowcase()
		@landingTestimonials()
		@landingPricing()
		@landingFAQ()
		@landingFooter()
	</div>
	<script>
		if(!window._landingTheme){window._landingTheme=true;(function(){function u(){var t=document.documentElement.getAttribute("data-theme");var d=t==="dracula"||t==="dim"||t==="dark";var e=document.getElementById("hero-dark");if(e)e.style.display=d?"":"none";e=document.getElementById("hero-light");if(e)e.style.display=d?"none":""};u();document.querySelectorAll("[data-theme-btn]").forEach(function(b){b.addEventListener("click",function(){setTimeout(u,50)})})})()}
	</script>
}

templ landingTopbar() {
	<div id="landing-topbar" class="group fixed inset-x-0 z-[60] flex justify-center transition-all duration-500 data-[scrolled]:top-0 data-[scrolled]:max-w-screen data-[scrolled]:rounded-none data-[scrolled]:translate-y-0 top-4">
		<div class="border-base-content/15 bg-base-100/80 backdrop-blur-sm flex w-full max-w-[800px] items-center justify-between rounded-box border px-4 h-16 transition-all duration-500 group-data-[scrolled]:max-w-full group-data-[scrolled]:rounded-none data-[scrolled]:border-0 group-data-[scrolled]:border-b data-[scrolled]:border-base-200">
			<div class="flex items-center gap-4">
				<div class="drawer lg:hidden">
					<input id="landing-mobile-drawer" type="checkbox" class="drawer-toggle"/>
					<div class="drawer-content"><label for="landing-mobile-drawer" class="btn btn-square btn-ghost btn-sm"><span class="iconify lucide--menu size-5"></span></label></div>
					<div class="drawer-side z-[60]"><label for="landing-mobile-drawer" class="drawer-overlay"></label>
						<div class="bg-base-100 h-full w-72 p-4">
							<ul class="menu w-full">
								<li><a href="#">Home</a></li>
								<li><a href="/dashboards/ecommerce">Dashboard</a></li>
								<li><a href="#features">Features</a></li>
								<li><a href="#testimonial">Testimonials</a></li>
								<li><a href="#pricing">Pricing</a></li>
								<li><a href="#faq">FAQ</a></li>
							</ul>
						</div>
					</div>
				</div>
				<a href="#" class="text-xl font-bold">Nexus</a>
				<div class="hidden lg:flex items-center gap-6 text-sm">
					<a href="/dashboards/ecommerce" class="link link-hover text-base-content/70">Dashboard</a>
					<a href="#features" class="link link-hover text-base-content/70">Features</a>
					<a href="#testimonial" class="link link-hover text-base-content/70">Testimonials</a>
					<a href="#pricing" class="link link-hover text-base-content/70">Pricing</a>
				</div>
			</div>
			<div class="flex items-center gap-3">
				@ui.ThemeSwitcher()
				<a href="/dashboards/ecommerce" class="btn btn-primary btn-sm"><span class="iconify lucide--zap size-4"></span>Live Preview</a>
			</div>
		</div>
	</div>
}

templ landingHero() {
	<div class="relative overflow-hidden">
		<div class="absolute inset-0 -top-2 h-[1600px] w-full bg-[url(/images/landing/hero-bg-gradient.png)] bg-cover bg-no-repeat opacity-40 dark:opacity-20"></div>
		<div id="landing-hero" class="border-base-100/15 bg-base-100/25 relative mx-auto max-w-[1000px] rounded-box border backdrop-blur-sm mt-28 mb-12 px-4 sm:px-8 py-12 sm:py-20 text-center">
			<a href="/dashboards/ecommerce" class="btn badge-secondary rounded-full mb-6"><span class="iconify lucide--bot size-4"></span>New: Gen AI App</a>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">Boost Your Workflow, <span class="relative inline-block">Redefine<span class="absolute -bottom-1 left-0 w-full h-3 bg-[url(/images/landing/hero-text-underline.svg)] bg-no-repeat bg-bottom bg-contain"></span></span> Success with <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">Nexus</span></h1>
			<p class="text-base-content/60 mt-6 text-lg max-w-2xl mx-auto">Start your next project with Nexus, the ultimate dashboard template designed for effortless customization. Pre-built pages, reusable components, developer-friendly code to streamline your development process.</p>
			<div class="mt-8 flex items-center justify-center gap-4">
				<a href="/dashboards/ecommerce" class="btn btn-primary"><span class="iconify lucide--zap size-4"></span>Live Preview</a>
				<a href="#features" class="btn btn-outline btn-neutral"><span class="iconify lucide--box size-4"></span>Components</a>
			</div>
			<div class="mt-12 flex justify-center">
				<div class="relative">
					<img id="hero-dark" src="/images/landing/hero-dashboard-dark.jpg" class="rounded-box border border-base-200 shadow-lg max-w-full" alt="Dashboard" style="display:none"/>
					<img id="hero-light" src="/images/landing/hero-dashboard-light.jpg" class="rounded-box border border-base-200 shadow-lg max-w-full" alt="Dashboard"/>
				</div>
			</div>
			<div class="mt-8 flex items-center justify-center gap-6 text-sm text-base-content/50">
				<span>Available In</span>
				<div class="flex items-center gap-3">
					<span class="tooltip" data-tip="Tailwind CSS"><span class="iconify lucide--layers size-5"></span></span>
					<span class="tooltip" data-tip="DaisyUI"><span class="iconify lucide--palette size-5"></span></span>
					<span class="tooltip" data-tip="React 19"><span class="iconify lucide--component size-5"></span></span>
					<span class="tooltip" data-tip="TypeScript"><span class="iconify lucide--file-code size-5"></span></span>
					<span class="tooltip" data-tip="Vite"><span class="iconify lucide--zap size-5"></span></span>
				</div>
			</div>
		</div>
	</div>
}

templ landingFeatures() {
	<div id="features" class="container mx-auto px-4 py-16">
		<div class="text-center mb-12">
			<h2 class="text-3xl font-bold">Everything You Need</h2>
			<p class="text-base-content/60 mt-3">Powerful features designed to accelerate your development workflow.</p>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
			@landingFeatureCard("lucide--layers", "Framework Flexibility", "Integrate effortlessly with multiple frameworks including React, Next.js, and SvelteKit.", "text-primary")
			@landingFeatureCard("lucide--monitor-dot", "User-Friendly Dashboard", "Sleek, responsive design with dark/light modes for every device.", "text-secondary")
			@landingFeatureCard("lucide--package", "Ready-to-Use UI", "Buttons, forms, tables, and more with DaisyUI styling.", "text-info")
			@landingFeatureCard("lucide--line-chart", "Dynamic Charts", "Interactive ApexCharts: line, bar, pie, and more.", "text-accent")
			@landingFeatureCard("lucide--palette", "Versatile Themes", "Light, dark, material, contrast, dim, and system themes.", "text-warning")
			@landingFeatureCard("lucide--pencil-ruler", "Consistent Design", "Standardized typography, colors, and spacing system.", "text-success")
			@landingFeatureCard("lucide--monitor-smartphone", "Responsive Everywhere", "Seamless experience across desktops, tablets, and phones.", "text-primary")
			@landingFeatureCard("lucide--pencil-line", "Fully Customizable", "Easy to customize colors, fonts, and layout for your brand.", "text-secondary")
		</div>
	</div>
}

templ landingFeatureCard(icon, title, desc, color string) {
	<div class="card bg-base-100 shadow-sm border border-base-200 hover:border-base-300 transition-all">
		<div class="card-body">
			<div class={ "rounded-box p-2 w-fit " + color + "/10 " + color }>
				<span class={ "iconify size-5 " + icon }></span>
			</div>
			<h3 class="font-semibold mt-3">{ title }</h3>
			<p class="text-sm text-base-content/60 mt-1">{ desc }</p>
		</div>
	</div>
}

templ landingShowcase() {
	<div class="bg-base-200 py-16">
		<div class="container mx-auto px-4">
			<div class="text-center mb-8">
				<h2 class="text-3xl font-bold">Beautiful Components</h2>
				<p class="text-base-content/60 mt-3">Crafted with DaisyUI and Tailwind CSS for a polished look.</p>
			</div>
			<div class="flex flex-wrap gap-4 justify-center">
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary}){ "Primary" }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary}){ "Secondary" }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonAccent}){ "Accent" }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline}){ "Outline" }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost}){ "Ghost" }
				<span class="badge badge-primary">Badge</span>
				<span class="badge badge-success">Success</span>
				<span class="badge badge-warning">Warning</span>
				<span class="badge badge-error">Error</span>
			</div>
			<div class="flex justify-center mt-6">
				<a href="/dashboards/ecommerce" class="btn btn-neutral btn-sm"><span class="iconify lucide--box size-4"></span>View All Components</a>
			</div>
		</div>
	</div>
}

templ landingTestimonials() {
	<div id="testimonial" class="relative container mx-auto py-16 px-4">
		<div class="text-center mb-12">
			<h2 class="text-3xl font-bold">Voices That Matter</h2>
			<p class="text-base-content/60 mt-3">What our users say about Nexus.</p>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<div class="card bg-base-100 shadow-sm">
				<div class="card-body text-center">
					<div class="avatar"><div class="mask mask-squircle w-16 bg-base-200"><div class="bg-primary text-primary-content flex size-full items-center justify-center font-bold text-xl">PS</div></div></div>
					<div class="flex justify-center gap-0.5 mt-3">
						@ui.IconSpan("lucide--star text-warning", "size-4")
						@ui.IconSpan("lucide--star text-warning", "size-4")
						@ui.IconSpan("lucide--star text-warning", "size-4")
						@ui.IconSpan("lucide--star text-warning", "size-4")
						@ui.IconSpan("lucide--star text-warning", "size-4")
					</div>
					<p class="text-base-content/60 mt-2 text-sm">"This is the ultimate admin dashboard for any project. Beautiful, fast, and incredibly well-designed."</p>
					<p class="font-medium mt-3">Pouya Saadeghi</p>
					<p class="text-xs text-base-content/40">Creator of daisyUI</p>
				</div>
			</div>
			<div class="card bg-base-100 shadow-sm">
				<div class="card-body text-center">
					<div class="avatar"><div class="mask mask-squircle w-16 bg-base-200"><div class="bg-secondary text-secondary-content flex size-full items-center justify-center font-bold text-xl">AC</div></div></div>
					<div class="flex justify-center gap-0.5 mt-3">
						@ui.IconSpan("lucide--star text-warning", "size-4")<span class="iconify lucide--star text-warning size-4"></span>@ui.IconSpan("lucide--star text-warning", "size-4")<span class="iconify lucide--star text-warning size-4"></span>@ui.IconSpan("lucide--star text-warning", "size-4")
					</div>
					<p class="text-base-content/60 mt-2 text-sm">"Nexus saved us months of development time. The components are well-organized and easy to extend."</p>
					<p class="font-medium mt-3">Alexandre Cohen</p>
					<p class="text-xs text-base-content/40">CTO of Disphere</p>
				</div>
			</div>
			<div class="card bg-base-100 shadow-sm">
				<div class="card-body text-center">
					<div class="avatar"><div class="mask mask-squircle w-16 bg-base-200"><div class="bg-accent text-accent-content flex size-full items-center justify-center font-bold text-xl">QT</div></div></div>
					<div class="flex justify-center gap-0.5 mt-3">
						@ui.IconSpan("lucide--star text-warning", "size-4")<span class="iconify lucide--star text-warning size-4"></span>@ui.IconSpan("lucide--star text-warning", "size-4")<span class="iconify lucide--star text-warning size-4"></span>@ui.IconSpan("lucide--star text-warning", "size-4")
					</div>
					<p class="text-base-content/60 mt-2 text-sm">"Perfect dashboard template for solo developers. Clean code, great documentation, beautiful design."</p>
					<p class="font-medium mt-3">Quinn</p>
					<p class="text-xs text-base-content/40">Solo Web Developer</p>
				</div>
			</div>
		</div>
	</div>
}

templ landingPricing() {
	<div id="pricing" class="bg-base-200 py-16">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold">Simple Pricing</h2>
				<p class="text-base-content/60 mt-3">Choose the plan that fits your needs.</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
				<div class="card bg-base-100 shadow-sm">
					<div class="card-body text-center">
						@ui.IconSpan("lucide--lightbulb text-primary size-8", "mx-auto")
						<h3 class="text-xl font-bold mt-3">Solo</h3>
						<p class="text-4xl font-extrabold mt-2">$69</p>
						<p class="text-sm text-base-content/60">One-time payment</p>
						<ul class="mt-4 space-y-2 text-sm text-base-content/60">
							<li><span class="iconify lucide--check text-success size-4 inline"></span> HTML Version</li>
							<li><span class="iconify lucide--check text-success size-4 inline"></span> React Version</li>
							<li><span class="iconify lucide--x text-error size-4 inline"></span> Next.js Version</li>
							<li><span class="iconify lucide--x text-error size-4 inline"></span> SvelteKit Version</li>
						</ul>
						<a href="#" class="btn btn-outline btn-primary mt-4 btn-block">Get Solo License</a>
					</div>
				</div>
				<div class="card bg-base-100 shadow-sm ring-2 ring-primary">
					<div class="card-body text-center">
						<div class="badge badge-primary mx-auto">Most Popular</div>
						@ui.IconSpan("lucide--rocket text-primary size-8 mx-auto", "mt-2")
						<h3 class="text-xl font-bold mt-3">Team</h3>
						<p class="text-4xl font-extrabold mt-2">$129</p>
						<p class="text-sm text-base-content/60">One-time payment</p>
						<ul class="mt-4 space-y-2 text-sm text-base-content/60">
							<li><span class="iconify lucide--check text-success size-4 inline"></span> HTML Version</li>
							<li><span class="iconify lucide--check text-success size-4 inline"></span> React Version</li>
							<li><span class="iconify lucide--check text-success size-4 inline"></span> Next.js Version</li>
							<li><span class="iconify lucide--x text-error size-4 inline"></span> SvelteKit Version</li>
						</ul>
						<a href="#" class="btn btn-primary mt-4 btn-block">Get Team License</a>
					</div>
				</div>
				<div class="card bg-base-100 shadow-sm">
					<div class="card-body text-center">
						@ui.IconSpan("lucide--briefcase text-secondary size-8", "mx-auto")
						<h3 class="text-xl font-bold mt-3">Enterprise</h3>
						<p class="text-4xl font-extrabold mt-2">$499</p>
						<p class="text-sm text-base-content/60">One-time payment</p>
						<ul class="mt-4 space-y-2 text-sm text-base-content/60">
							<li><span class="iconify lucide--check text-success size-4 inline"></span> HTML Version</li>
							<li><span class="iconify lucide--check text-success size-4 inline"></span> React Version</li>
							<li><span class="iconify lucide--check text-success size-4 inline"></span> Next.js Version</li>
							<li><span class="iconify lucide--check text-success size-4 inline"></span> SvelteKit Version</li>
						</ul>
						<a href="#" class="btn btn-secondary mt-4 btn-block">Get Enterprise License</a>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ landingFAQ() {
	<div id="faq" class="container mx-auto py-16 px-4 max-w-3xl">
		<div class="text-center mb-12">
			<h2 class="text-3xl font-bold">Frequently Asked Questions</h2>
			<p class="text-base-content/60 mt-3">Got questions? We have answers.</p>
		</div>
		<div class="space-y-2">
			<div class="collapse collapse-plus border border-base-200 bg-base-100 rounded-box">
				<input type="radio" name="landing-faq"/>
				<div class="collapse-title font-medium">How can I give feedback?</div>
				<div class="collapse-content"><p class="text-sm text-base-content/60">You can submit feedback through our contact form or email us at support@nexus.com. We value your input!</p></div>
			</div>
			<div class="collapse collapse-plus border border-base-200 bg-base-100 rounded-box">
				<input type="radio" name="landing-faq"/>
				<div class="collapse-title font-medium">Can I get the full source code?</div>
				<div class="collapse-content"><p class="text-sm text-base-content/60">Yes! The full source code is included with your purchase. You can customize it as needed.</p></div>
			</div>
			<div class="collapse collapse-plus border border-base-200 bg-base-100 rounded-box">
				<input type="radio" name="landing-faq"/>
				<div class="collapse-title font-medium">Will there be future payments?</div>
				<div class="collapse-content"><p class="text-sm text-base-content/60">No. All purchases are one-time payments with lifetime access to updates.</p></div>
			</div>
			<div class="collapse collapse-plus border border-base-200 bg-base-100 rounded-box">
				<input type="radio" name="landing-faq"/>
				<div class="collapse-title font-medium">Are there plans for future updates?</div>
				<div class="collapse-content"><p class="text-sm text-base-content/60">Yes! We regularly update Nexus with new features, components, and improvements.</p></div>
			</div>
			<div class="collapse collapse-plus border border-base-200 bg-base-100 rounded-box">
				<input type="radio" name="landing-faq"/>
				<div class="collapse-title font-medium">Do I need a backend?</div>
				<div class="collapse-content"><p class="text-sm text-base-content/60">Nexus is a frontend template. You can connect it to any backend of your choice.</p></div>
			</div>
		</div>
	</div>
}

templ landingFooter() {
	<footer class="bg-base-200 border-t border-base-300">
		<div class="container mx-auto px-4 py-12">
			<div class="bg-primary/10 rounded-box p-8 mb-8">
				<div class="flex flex-col md:flex-row items-center justify-between gap-4">
					<div><h3 class="text-xl font-bold">Start today and launch your success right away.</h3><p class="text-base-content/60 text-sm mt-1">Get the complete Nexus dashboard template.</p></div>
					<div class="flex gap-3">
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary}){"Purchase Now" }
						<a href="/dashboards/ecommerce" class="btn btn-outline">Live Preview</a>
					</div>
				</div>
			</div>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-8">
				<div>
					<h4 class="font-bold text-lg">Nexus</h4>
					<p class="text-sm text-base-content/60 mt-2">Premium admin dashboard template built with daisyUI and Tailwind CSS.</p>
					<div class="flex gap-2 mt-3">
						<a href="#" class="btn btn-ghost btn-xs btn-square"><span class="iconify lucide--github size-4"></span></a>
						<a href="#" class="btn btn-ghost btn-xs btn-square"><span class="iconify lucide--twitter size-4"></span></a>
						<a href="#" class="btn btn-ghost btn-xs btn-square"><span class="iconify lucide--link size-4"></span></a>
					</div>
				</div>
				<div>
					<h4 class="font-semibold mb-3">Quick Links</h4>
					<ul class="space-y-1 text-sm text-base-content/60">
						<li><a href="/dashboards/ecommerce" class="link link-hover">Dashboard</a></li>
						<li><a href="#features" class="link link-hover">Features</a></li>
						<li><a href="/auth/login" class="link link-hover">Login</a></li>
					</ul>
				</div>
				<div>
					<h4 class="font-semibold mb-3">Company</h4>
					<ul class="space-y-1 text-sm text-base-content/60">
						<li><a href="#" class="link link-hover">About</a></li>
						<li><a href="#" class="link link-hover">Blog</a></li>
						<li><a href="#" class="link link-hover">Contact</a></li>
					</ul>
				</div>
				<div>
					<h4 class="font-semibold mb-3">Legal</h4>
					<ul class="space-y-1 text-sm text-base-content/60">
						<li><a href="#" class="link link-hover">Privacy Policy</a></li>
						<li><a href="#" class="link link-hover">Terms of Service</a></li>
						<li><a href="#" class="link link-hover">License</a></li>
					</ul>
				</div>
			</div>
			<div class="text-center text-sm text-base-content/40 mt-8 pt-8 border-t border-base-300">
				<p>Developed with <span class="iconify lucide--heart text-error size-3.5 inline"></span> using daisyUI. v2.1.0</p>
			</div>
		</div>
	</footer>
}
