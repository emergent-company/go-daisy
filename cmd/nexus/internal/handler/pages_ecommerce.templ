package handler

import (
	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/nav"
	"github.com/emergent-company/go-daisy/components/table"
	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

templ ProductsList() {
	

		<div class="flex items-center justify-between"><h3 class="text-lg font-medium">Products</h3><div class="breadcrumbs hidden p-0 text-sm sm:inline"><ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Ecommerce</li><li class="opacity-80">Products</li></ul></div></div>

		<div class="mt-6">
			@table.TableCard(table.TableCardProps{
				Toolbar: productsListToolbar(),
				Footer:  productsListFooter(),
			}) {
				@table.TableWithProps(table.TableProps{Class: "whitespace-nowrap"}) {
					@table.TableHead() {
						@table.TableHeadRow() {
							@table.TableSelectAll("Check all")
							@table.TableHeadCell("ID")
							@table.TableHeadCell("Name")
							@table.TableHeadCell("Category")
							@table.TableHeadCell("Price")
							@table.TableHeadCell("Ratings")
							@table.TableHeadCell("Orders")
							@table.TableHeadCell("Stock")
							@table.TableHeadCell("Created At")
							@table.TableHeadCell("Action")
						}
					}
					@table.TableBody() {
						@productRow("1", "1001", "Men's tracking shoes #SHOES", "Fashion", "$29", "4.7", "130", "10", "Available", "30 Nov 2024")
						@productRow("2", "1002", "Cocooil body oil #COCOOIL", "Daily Need", "$16", "4.2", "547", "15", "Available", "30 Nov 2024")
						@productRow("3", "1003", "Freeze air #FREEAIR", "Cosmetic", "$32", "3.8", "862", "25", "Available", "30 Jul 2024")
						@productRow("4", "1004", "Ladies's shoes #LASHOES", "Fashion", "$32", "2.9", "861", "10", "Out of stock", "30 Jan 2024")
						@productRow("5", "1005", "Gamepad #GAMEPAD", "Electronics", "$59", "4.1", "96", "42", "Available", "30 Oct 2024")
						@productRow("6", "1006", "Blue & Pink Clothes #BPCloth", "Fashion", "$27", "4.24", "72", "31", "Available", "30 May 2024")
						@productRow("7", "1007", "Ladies's shorts wear #LSWEAR", "Fashion", "$24", "3.5", "48", "42", "Available", "30 Sep 2024")
						@productRow("8", "1008", "Kitchen's Fruits & Vegetable #KFVEGE", "Food", "$45", "2.7", "54", "36", "Available", "30 Apr 2024")
						@productRow("9", "1009", "Quokka Lemon Water #QUOKKA", "Food", "$7", "4.1", "64", "27", "Available", "30 Dec 2024")
						@productRow("10", "1010", "White & Brown Candy #CANDY", "Food", "$14", "3.6", "84", "42", "Out of stock", "30 Jun 2024")
						@productRow("11", "1011", "Yellow Ice cream #ICECREAM", "Food", "$15", "4.9", "52", "31", "Available", "30 Jan 2024")
					}
				}
			}
		<dialog id="apps_product_delete" class="modal">
			<div class="modal-box">
				<div class="flex items-center justify-between text-lg font-medium">
					Confirm Delete
					<form method="dialog">
						<button class="btn btn-sm btn-ghost btn-circle" aria-label="Close modal"><span class="iconify lucide--x size-4"></span></button>
					</form>
				</div>
				<p class="py-4">You are about to delete this product. Would you like to proceed further ?</p>
				<div class="modal-action">
					<form method="dialog"><button class="btn btn-ghost btn-sm">No</button></form>
					<form method="dialog"><button class="btn btn-sm btn-error">Yes, delete it</button></form>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>
		</div>

}

templ productsListToolbar() {
	@table.TableCardHeader() {
		<div class="inline-flex items-center gap-3">
			<label class="input input-sm">
				@ui.IconSpan("lucide--search text-body", "size-3.5")
				<input class="w-24 sm:w-36" placeholder="Search along products" type="search" aria-label="Search products"/>
			</label>
			<div class="hidden sm:block">
				<select class="select select-sm w-36" aria-label="Category">
					<option value="" disabled selected>Select Category</option>
					<option>Fashion</option>
					<option>Daily Need</option>
					<option>Cosmetic</option>
					<option>Electronics</option>
					<option>Food</option>
				</select>
			</div>
		</div>
		<div class="inline-flex items-center gap-3">
			<a href="/apps/ecommerce/products/create" class="btn btn-primary btn-sm max-sm:btn-square">
				@ui.IconSpan("lucide--plus", "size-4")
				<span class="hidden sm:inline">New Product</span>
			</a>
			<div class="dropdown dropdown-bottom dropdown-end">
				<div tabindex="0" role="button" class="btn btn-ghost border-line-strong btn-sm btn-square" aria-label="More option">
					@ui.IconSpan("lucide--settings-2", "size-4")
				</div>
				<div tabindex="0" class="dropdown-content bg-base-100 rounded-box z-1 w-52 shadow">
					<ul class="menu w-full p-2">
						<li><div>@ui.IconSpan("lucide--wand", "size-4") Bulk Actions</div></li>
					</ul>
					<hr class="border-line-strong"/>
					<ul class="menu w-full p-2">
						<li><div>@ui.IconSpan("lucide--download-cloud", "size-4") Import from Store</div></li>
						<li><div>@ui.IconSpan("lucide--copy-plus", "size-4") Create from Existing</div></li>
					</ul>
				</div>
			</div>
		</div>
	}
}

templ productsListFooter() {
	<div class="flex items-center justify-between p-6">
		<div class="text-body hover:text-base-content flex gap-2 text-sm">
			<span class="hidden sm:inline">Per page</span>
			<select class="select select-xs w-18" aria-label="Per page">
				<option value="10">10</option><option value="20" selected>20</option><option value="50">50</option><option value="100">100</option>
			</select>
		</div>
		<span class="text-body hidden text-sm lg:inline">Showing <span class="text-base-content font-medium">1 to 20 </span>of 457 items</span>
		<div class="inline-flex items-center gap-1">
			<button class="btn btn-circle sm:btn-sm btn-xs btn-ghost" aria-label="Prev"><span class="iconify lucide--chevron-left"></span></button>
			<button class="btn btn-primary btn-circle sm:btn-sm btn-xs">1</button>
			<button class="btn btn-ghost btn-circle sm:btn-sm btn-xs">2</button>
			<button class="btn btn-ghost btn-circle sm:btn-sm btn-xs">3</button>
			<button class="btn btn-circle sm:btn-sm btn-xs btn-ghost" aria-label="Next"><span class="iconify lucide--chevron-right"></span></button>
		</div>
	</div>
}

templ productRow(num, id, name, category, price, rating, ratingCount, orders, stock, created string) {
	@table.TableRow("", true, nil) {
		@table.TableSelectRow("", false)
		@table.TableCell("", nil) {
			{ id }
		}
		@table.TableCell("", nil) {
			<div class="flex items-center space-x-3 truncate">
				<img class="rounded-box size-10" src={ "/images/apps/ecommerce/products/" + num + ".jpg" } alt="Product"/>
				<div>
					<p class="font-medium">{ productNameOnly(name) }</p>
					<p class="text-muted text-xs">{ productSKU(name) }</p>
				</div>
			</div>
		}
		@table.TableCell("", nil) {
			{ category }
		}
		@table.TableCell("text-sm font-medium", nil) {
			{ price }
		}
		@table.TableCell("", nil) {
			<div class="flex items-center gap-2">
				<span class="iconify lucide--star text-success size-4"></span>
				{ rating }
				<span class="text-muted text-xs">({ ratingCount })</span>
			</div>
		}
		@table.TableCell("", nil) {
			{ orders }
		}
		@table.TableCell("", nil) {
			@productStockBadge(stock)
		}
		@table.TableCell("text-sm", nil) {
			{ created }
		}
		@table.TableCell("", nil) {
			<div class="inline-flex">
				<a class="btn btn-square btn-ghost btn-sm" href="./apps-ecommerce-products-edit.html" aria-label="Edit product link"><span class="iconify lucide--pencil text-body size-4"></span></a>
				<button class="btn btn-square btn-ghost btn-sm" aria-label="Dummy show product"><span class="iconify lucide--eye text-body size-4"></span></button>
				<button class="btn btn-square btn-error btn-outline btn-sm border-transparent" onclick="apps_product_delete.showModal()" aria-label="Dummy delete product"><span class="iconify lucide--trash size-4"></span></button>
			</div>
		}
	}
}

templ productStockBadge(stock string) {
	if stock == "Available" {
		<span class="text-success">Available</span>
	} else {
		<span class="textarea-error">Out of stock</span>
	}
}

templ OrdersList() {

		<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/OrdersList")... }><h3 class="text-lg font-medium">Orders</h3><div class="breadcrumbs hidden p-0 text-sm sm:inline"><ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Ecommerce</li><li class="opacity-80">Orders</li></ul></div></div>

		<div class="mt-6">
			@table.TableCard(table.TableCardProps{
				Class:   "mt-5",
				Toolbar: ordersListToolbar(),
				Footer:  ordersListFooter(),
			}) {
				@table.TableWithProps(table.TableProps{Class: "whitespace-nowrap"}) {
					@table.TableHead() {
						@table.TableHeadRow() {
							@table.TableSelectAll("Check all")
							@table.TableHeadCell("ID")
							@table.TableHeadCell("Name")
							@table.TableHeadCell("Customer")
							@table.TableHeadCell("Price")
							@table.TableHeadCell("Payment")
							@table.TableHeadCell("Status")
							@table.TableHeadCell("Ordered At")
							@table.TableHeadCell("Action")
						}
					}
					@table.TableBody() {
						@orderTableRow("21001", "5 Items", "Emily Johnson", "$342", "Paid", "Ordered", "29 May 2024")
						@orderTableRow("21002", "3 Items", "Alex Thompson", "$578", "Paid", "Accepted", "29 Sep 2023")
						@orderTableRow("21003", "6 Items", "Sarah Davis", "$215", "Pending", "On the Way", "29 Jan 2024")
						@orderTableRow("21004", "2 Items", "Michael Wilson", "$769", "Pending", "Delivered", "29 Jul 2023")
						@orderTableRow("21005", "7 Items", "Jessica Miller", "$431", "Paid", "Accepted", "29 Apr 2024")
						@orderTableRow("21006", "1 Items", "Brian Anderson", "$622", "Paid", "Ordered", "29 Nov 2023")
						@orderTableRow("21007", "4 Items", "Olivia Smith", "$894", "Pending", "On the way", "29 Mar 2024")
						@orderTableRow("21008", "7 Items", "Daniel Robinson", "$156", "Paid", "Delivered", "29 Oct 2023")
						@orderTableRow("21009", "1 Items", "Emma Garcia", "$497", "Pending", "Ordered", "29 Jun 2024")
						@orderTableRow("21010", "3 Items", "Christopher Baker", "$783", "Paid", "Accepted", "29 Dec 2023")
					}
				}
			}
		</div>

}

templ ordersListToolbar() {
	@table.TableCardHeader() {
		<div class="inline-flex items-center gap-3">
			<label class="input input-sm">
				@ui.IconSpan("lucide--search text-body", "size-3.5")
				<input class="w-24 sm:w-36" placeholder="Search along orders" aria-label="Search orders" type="search"/>
			</label>
			<div class="hidden sm:block">
				<select class="select select-sm w-36" aria-label="Category">
					<option value="" disabled selected>Select Category</option>
					<option>Fashion</option>
					<option>Daily Need</option>
					<option>Cosmetic</option>
					<option>Electronics</option>
					<option>Food</option>
				</select>
			</div>
		</div>
		<a class="btn btn-sm btn-primary" href="/dashboards/ecommerce">
			@ui.IconSpan("lucide--monitor-dot", "size-4")
			<span class="hidden sm:inline">Dashboard</span>
		</a>
	}
}

templ ordersListFooter() {
	<div class="flex items-center justify-between p-6">
		<div class="text-body hover:text-base-content flex gap-2 text-sm">
			<span class="hidden sm:inline">Per page</span>
			<select class="select select-xs w-18" aria-label="Per page">
				<option value="10">10</option><option value="20" selected>20</option><option value="50">50</option><option value="100">100</option>
			</select>
		</div>
		<span class="text-body hidden text-sm lg:inline">Showing <span class="text-base-content font-medium">1 to 20 </span>of 457 items</span>
		<div class="inline-flex items-center gap-1">
			<button class="btn btn-circle sm:btn-sm btn-xs btn-ghost" aria-label="Prev"><span class="iconify lucide--chevron-left"></span></button>
			<button class="btn btn-primary btn-circle sm:btn-sm btn-xs">1</button>
			<button class="btn btn-ghost btn-circle sm:btn-sm btn-xs">2</button>
			<button class="btn btn-ghost btn-circle sm:btn-sm btn-xs">3</button>
			<button class="btn btn-circle sm:btn-sm btn-xs btn-ghost" aria-label="Next"><span class="iconify lucide--chevron-right"></span></button>
		</div>
	</div>
}

templ orderTableRow(id, name, customer, price, payment, status, date string) {
	@table.TableRow("", true, nil) {
		@table.TableSelectRow("", false)
		@table.TableCell("font-medium", nil) {
			#{ id }
		}
		@table.TableCell("", nil) {
			{ name }
		}
		@table.TableCell("", nil) {
			{ customer }
		}
		@table.TableCell("text-sm font-medium", nil) {
			{ price }
		}
		@table.TableCell("", nil) {
			@orderStatusBadge(payment)
		}
		@table.TableCell("text-sm", nil) {
			{ status }
		}
		@table.TableCell("text-sm", nil) {
			{ date }
		}
		@table.TableCell("", nil) {
			<a aria-label="View order"><button class="btn btn-square btn-ghost btn-sm"><span class="iconify lucide--eye text-body size-4"></span></button></a>
		}
	}
}

templ orderStatusBadge(status string) {
	if status == "Paid" {
		<div class="badge badge-soft badge-success">{ status }</div>
	} else if status == "Pending" {
		<div class="badge badge-soft badge-error">{ status }</div>
	} else {
		{ status }
	}
}

templ OrderDetail() {
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  "Order Detail",
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Orders", Href: "/apps/ecommerce/orders"},
			{Label: "Detail"},
		},
	})
	<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-12">
		<div class="lg:col-span-8 2xl:col-span-9">
			@ui.CardRaw(ui.CardRawProps{BodyClass: "p-0"}) {
				<div class="px-5 pt-5">
					<div class="flex justify-between">
						<div class="space-x-2">
							<span class="text-2xl font-medium">#1</span>
							<span class="text-label hidden text-sm sm:inline">27 Dec 2024 at 05:26 PM</span>
						</div>
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, Size: ui.ButtonSM, Icon: "lucide--scroll-text", ExtraClass: "border-base-300"}){ Invoice }
					</div>
				</div>
				<div class="mt-5 overflow-auto">
					@table.TableWithProps(table.TableProps{}) {
						@table.TableHead() {
							@table.TableHeadRow() {
								@table.TableHeadCell("ID")
								@table.TableHeadCell("Name")
								@table.TableHeadCell("Category")
								@table.TableHeadCell("Price")
								@table.TableHeadCell("Quantity")
								@table.TableHeadCell("Amount")
							}
						}
						@table.TableBody() {
							@orderLineRow("1001", "1", "Men's tracking shoes", "#SHOES", "Fashion", "$29", "3x", "$87")
							@orderLineRow("1002", "2", "Coco body oil", "#COCOOIL", "Daily Need", "$16", "2x", "$32")
							@orderLineRow("1003", "3", "Freeze air", "#FREEAIR", "Cosmetic", "$32", "4x", "$128")
							@orderTotalRow("Sub Total", "text-end font-medium", "$247", "font-medium")
							@orderTotalRow("Tax", "text-end font-medium", "+ $44", "font-medium")
							@orderTotalRow("Discount", "text-end font-medium text-success", "- $60", "text-success font-medium")
							@orderTotalRow("Total", "text-end font-medium", "$231", "font-semibold")
						}
					}
				</div>
			}
			<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-2 2xl:grid-cols-3">
				@orderPaymentCard()
				@orderCustomerCard()
				@orderAddressCard()
			</div>
		</div>
		<div class="lg:col-span-4 2xl:col-span-3">
			@ui.CardRaw(ui.CardRawProps{BodyClass: "gap-0"}) {
				<p class="bg-base-200 rounded-box px-3 py-2 font-medium">Track Order</p>
				<div class="mt-2">
					@orderTrackTimeline()
				</div>
				<p class="bg-base-200 rounded-box mt-4 px-3 py-2 font-medium">Delivery Partner</p>
				<div class="mt-3">
					<div class="flex items-center gap-3">
						<img class="bg-base-200 mask mask-squircle size-10" src="/images/avatars/8.png" alt="Avatar"/>
						<div class="grow">
							<p class="text-sm font-medium">Patricia T. Gandy</p>
							<p class="text-body text-sm">pat.gandy@mail.com</p>
						</div>
						<div class="inline-flex gap-2">
							@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, Size: ui.ButtonSM, Icon: "lucide--route"}){ Track }
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}

templ orderLineRow(id, imgNum, name, sku, category, price, qty, amount string) {
	@table.TableRow("", false, nil) {
		@table.TableRowHeaderCell("font-medium", nil) {
			{ id }
		}
		@table.TableCell("", nil) {
			<div class="flex items-center space-x-3 truncate">
				<img class="size-10 rounded" src={ "/images/apps/ecommerce/products/" + imgNum + ".jpg" } alt="Product"/>
				<div>
					<p class="font-medium">{ name }</p>
					<p class="text-muted text-xs">{ sku }</p>
				</div>
			</div>
		}
		@table.TableCell("", nil) {
			{ category }
		}
		@table.TableCell("", nil) {
			{ price }
		}
		@table.TableCell("", nil) {
			{ qty }
		}
		@table.TableCell("font-medium", nil) {
			{ amount }
		}
	}
}

templ orderTotalRow(label string, labelClass string, amount string, amountClass string) {
	@table.TableRow("", false, nil) {
		@table.TableCell(labelClass, templ.Attributes{"colspan": "5"}) {
			{ label }
		}
		@table.TableCell(amountClass, nil) {
			{ amount }
		}
	}
}

templ orderPaymentCard() {
	@ui.CardRaw(ui.CardRawProps{}) {
		<p class="bg-base-200 rounded-box px-3 py-2 font-medium">Payment Information</p>
		<div class="mt-3 flex gap-3">
			@ui.IconSpan("lucide--credit-card", "size-6")
			<div class="grow">
				<p class="font-medium">Ends with 2487</p>
				<p class="text-body text-sm">Expired at 08/27</p>
			</div>
			@ui.Badge(ui.BadgeProps{Label: "Paid", Variant: ui.BadgeSuccess, Size: ui.BadgeSizeSM, Style: ui.BadgeStyleDash})
		</div>
		<div class="mt-2 text-end">
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Style: ui.ButtonStyleSoft, Size: ui.ButtonSM, Icon: "lucide--arrow-left-right"}){ Transactions }
		</div>
	}
}

templ orderCustomerCard() {
	@ui.CardRaw(ui.CardRawProps{}) {
		<p class="bg-base-200 rounded-box px-3 py-2 font-medium">Customer Details</p>
		<div class="mt-3 flex items-center gap-3">
			<img class="bg-base-200 mask mask-squircle size-10 p-0.5" src="/images/avatars/5.png" alt=""/>
			<div class="grow">
				<p class="font-medium">James J. Herron</p>
				<p class="text-body text-sm">james@mail.com</p>
			</div>
		</div>
		<div class="mt-2 flex items-center justify-end gap-1">
			@ui.Button(ui.ButtonProps{Shape: ui.ButtonShapeCircle, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Icon: "lucide--phone", AriaLabel: "call a customer"})
			@ui.Button(ui.ButtonProps{Shape: ui.ButtonShapeCircle, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Icon: "lucide--mail", AriaLabel: "mail to customer"})
		</div>
	}
}

templ orderAddressCard() {
	@ui.CardRaw(ui.CardRawProps{}) {
		<p class="bg-base-200 rounded-box px-3 py-2 font-medium">Delivery Address</p>
		<div class="mt-3 flex gap-3">
			@ui.IconSpan("lucide--map-pin", "size-6")
			<div class="grow">
				<p class="font-medium">4239 Bloomfield Way</p>
				<p class="text-body text-sm">Standish - ME 047842</p>
			</div>
		</div>
		<div class="mt-2 text-end">
			@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Style: ui.ButtonStyleSoft, Size: ui.ButtonSM, Icon: "lucide--map"}){ View on Map }
		</div>
	}
}

templ orderTrackTimeline() {
	<ul class="timeline timeline-vertical timeline-snap-icon timeline-hr-sm -ms-[100%] ps-10">
		@orderTrackItem("lucide--clipboard", "bg-base-200", "Ordered", "4 days", "Samuel E. Clark ordered it via app", true)
		@orderTrackItem("lucide--clipboard-check", "bg-base-200", "Accepted", "3 days", "Cafe day's accept order", false)
		@orderTrackItem("lucide--package-check", "bg-base-200", "Ready to dispatch", "23 hours", "Packaging done with instructions", false)
		@orderTrackItem("lucide--truck", "bg-base-200", "On the Way", "2 hours", "Way's truck goes for delivery", false)
		@orderTrackItem("lucide--package-open", "bg-primary/10 text-primary", "Delivered", "24 minutes", "Order put your door at snap", false)
		<li>
			<hr />
			<div class="timeline-middle">
				<div class="bg-success/10 text-success flex items-center rounded-full p-2">
					@ui.IconSpan("lucide--stars", "size-4.5")
				</div>
			</div>
			<div class="timeline-end mx-5 my-2">
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSuccess, Style: ui.ButtonStyleSoft, Size: ui.ButtonSM}){ Review order }
			</div>
		</li>
	</ul>
}

templ orderTrackItem(icon string, iconClass string, title string, time string, desc string, first bool) {
	<li>
		if !first {
			<hr />
		}
		<div class="timeline-middle">
			<div class={ iconClass, "flex items-center rounded-full p-2" }>
				@ui.IconSpan(icon, "size-4.5")
			</div>
		</div>
		<div class="timeline-end my-2.5 w-full px-4">
			<div class="flex items-center justify-between">
				<span class="text-sm font-medium">{ title }</span>
				<span class="text-muted text-xs">{ time }</span>
			</div>
			<p class="text-label text-xs">{ desc }</p>
		</div>
		<hr />
	</li>
}

templ ProductForm(isCreate bool) {
	{{ title := "Edit Product" }}
	{{ crumb := "Edit" }}
	{{ if isCreate { title = "Create Product"; crumb = "Create" } }}
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  title,
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Products", Href: "/apps/ecommerce/products"},
			{Label: crumb},
		},
	})
	<div class="mt-6">
		<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">Basic Information</div>
				<div class="fieldset mt-2 grid grid-cols-1 gap-4 lg:grid-cols-2">
					@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "name", Label: "Name", Placeholder: "Name"})
					@form.FormField(form.FormFieldProps{Type: form.FieldSelect, Name: "category", Label: "Category", Placeholder: "Select category", Attrs: templ.Attributes{"aria-label": "Select Category"}, Options: []form.SelectOption{
						{Value: "fashion", Label: "Fashion"},
						{Value: "daily-need", Label: "Daily Need"},
						{Value: "cosmetic", Label: "Cosmetic"},
						{Value: "electronic", Label: "Electronic"},
						{Value: "food", Label: "Food"},
					}})
					<div class="col-span-1 lg:col-span-2">
						@form.FormField(form.FormFieldProps{Type: form.FieldTextarea, Name: "description", Label: "Description", Placeholder: "Description"})
					</div>
				</div>
			}
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">Upload Image</div>
				<div class="mt-5">
					@form.FileUpload(form.FileUploadProps{Name: "image"})
				</div>
			}
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">Pricing</div>
				<div class="fieldset mt-2 grid grid-cols-1 gap-4 lg:grid-cols-2">
					@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "cost-price", Label: "Cost Price", Placeholder: "0", PrefixIcon: "lucide--dollar-sign", Attrs: templ.Attributes{"min": "0"}})
					@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "sale-price", Label: "Sale Price", Placeholder: "0", PrefixIcon: "lucide--dollar-sign", Attrs: templ.Attributes{"min": "0"}})
					@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "discount", Label: "Discount", Placeholder: "0", SuffixIcon: "lucide--percent", Attrs: templ.Attributes{"min": "0", "max": "100"}})
					@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "tax", Label: "Tax", Placeholder: "0", SuffixIcon: "lucide--percent", Attrs: templ.Attributes{"min": "0", "max": "100"}})
				</div>
			}
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">Inventory</div>
				<div class="fieldset mt-2 gap-4">
					@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "sku", Label: "SKU", Placeholder: "SKU (Stock Keeping Unit)"})
					<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
						@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "stock", Label: "Stock", Placeholder: "Stock", Attrs: templ.Attributes{"min": "0"}})
						@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "stock-alert", Label: "Stock Alert", Placeholder: "Stock alert", Attrs: templ.Attributes{"min": "0"}})
					</div>
				</div>
			}
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">SEO (Meta)</div>
				<div class="fieldset mt-2 gap-4">
					<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
						@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "slug", Label: "Slug", Placeholder: "Slug"})
						@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "title", Label: "Title", Placeholder: "Meta"})
					</div>
					@form.FormField(form.FormFieldProps{Type: form.FieldTextarea, Name: "meta-description", Label: "Description", Placeholder: "Description"})
				</div>
			}
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">Shipping</div>
				<div class="fieldset mt-2 grid grid-cols-1 gap-4 lg:grid-cols-2">
					@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "weight", Label: "Weight", Placeholder: "0", Suffix: "gm", Attrs: templ.Attributes{"min": "0"}})
					@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "width", Label: "Width", Placeholder: "0", Suffix: "In", Attrs: templ.Attributes{"min": "0"}})
					@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "height", Label: "Height", Placeholder: "0", Suffix: "In", Attrs: templ.Attributes{"min": "0"}})
					@form.FormField(form.FormFieldProps{Type: form.FieldNumber, Name: "depth", Label: "Depth", Placeholder: "0", Suffix: "In", Attrs: templ.Attributes{"min": "0"}})
					<div class="flex items-center gap-4">
						<label class="label" for="free_shipping">Free Shipping</label>
						@form.ToggleInput(form.ToggleInputProps{Name: "free_shipping", Class: "toggle toggle-sm", Attrs: templ.Attributes{"id": "free_shipping"}})
					</div>
				</div>
			}
		</div>
		@entityFormActions("/apps/ecommerce/products", isCreate)
	</div>
}

