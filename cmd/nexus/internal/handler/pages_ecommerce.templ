package handler

import (
	"github.com/emergent-company/go-daisy/components/form"
	"github.com/emergent-company/go-daisy/components/nav"
	"github.com/emergent-company/go-daisy/components/table"
	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

templ ProductsList() {
	

		<div class="flex items-center justify-between"><h3 class="text-lg font-medium">Products</h3><div class="breadcrumbs hidden p-0 text-sm sm:inline"><ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Ecommerce</li><li class="opacity-80">Products</li></ul></div></div>

		<div class="mt-6">
			@table.TableCard(table.TableCardProps{
				Toolbar: productsListToolbar(),
				Footer:  productsListFooter(),
			}) {
				@table.TableWithProps(table.TableProps{}) {
					@table.TableHead() {
						@table.TableHeadRow() {
							@table.TableSelectAll("Check all")
							@table.TableHeadCell("ID")
							@table.TableHeadCell("Name")
							@table.TableHeadCell("Category")
							@table.TableHeadCell("Price")
							@table.TableHeadCell("Ratings")
							@table.TableHeadCell("Orders")
							@table.TableHeadCell("Stock")
							@table.TableHeadCell("Created At")
							@table.TableHeadCell("Action")
						}
					}
					@table.TableBody() {
						@productRow("1", "1001", "Men's tracking shoes #SHOES", "Fashion", "$29", "4.7", "130", "10", "Available", "30 Nov 2024")
						@productRow("2", "1002", "Cocooil body oil #COCOOIL", "Daily Need", "$16", "4.2", "547", "15", "Available", "30 Nov 2024")
						@productRow("3", "1003", "Freeze air #FREEAIR", "Cosmetic", "$32", "3.8", "862", "25", "Available", "30 Jul 2024")
						@productRow("4", "1004", "Ladies's shoes #LASHOES", "Fashion", "$32", "2.9", "861", "10", "Out of stock", "30 Jan 2024")
						@productRow("5", "1005", "Gamepad #GAMEPAD", "Electronics", "$59", "4.1", "96", "42", "Available", "30 Oct 2024")
						@productRow("6", "1006", "Blue & Pink Clothes #BPCloth", "Fashion", "$27", "4.24", "72", "31", "Available", "30 May 2024")
						@productRow("7", "1007", "Ladies's shorts wear #LSWEAR", "Fashion", "$24", "3.5", "48", "42", "Available", "30 Sep 2024")
						@productRow("8", "1008", "Kitchen's Fruits & Vegetable #KFVEGE", "Food", "$45", "2.7", "54", "36", "Available", "30 Apr 2024")
						@productRow("9", "1009", "Quokka Lemon Water #QUOKKA", "Food", "$7", "4.1", "64", "27", "Available", "30 Dec 2024")
						@productRow("10", "1010", "White & Brown Candy #CANDY", "Food", "$14", "3.6", "84", "42", "Out of stock", "30 Jun 2024")
						@productRow("11", "1011", "Yellow Ice cream #ICECREAM", "Food", "$15", "4.9", "52", "31", "Available", "30 Jan 2024")
					}
				}
			}
		<dialog id="apps_product_delete" class="modal">
			<div class="modal-box">
				<div class="flex items-center justify-between text-lg font-medium">
					Confirm Delete
					<form method="dialog">
						<button class="btn btn-sm btn-ghost btn-circle" aria-label="Close modal"><span class="iconify lucide--x size-4"></span></button>
					</form>
				</div>
				<p class="py-4">You are about to delete this product. Would you like to proceed further ?</p>
				<div class="modal-action">
					<form method="dialog"><button class="btn btn-ghost btn-sm">No</button></form>
					<form method="dialog"><button class="btn btn-sm btn-error">Yes, delete it</button></form>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>
		</div>

}

templ productsListToolbar() {
	@table.TableCardHeader() {
		<div class="inline-flex items-center gap-3">
			<label class="input input-sm">
				@ui.IconSpan("lucide--search text-body", "size-3.5")
				<input class="w-24 sm:w-36" placeholder="Search along products" type="search" aria-label="Search products"/>
			</label>
			<div class="hidden sm:block">
				<select class="select select-sm w-36" aria-label="Category">
					<option value="" disabled selected>Select Category</option>
					<option>Fashion</option>
					<option>Daily Need</option>
					<option>Cosmetic</option>
					<option>Electronics</option>
					<option>Food</option>
				</select>
			</div>
		</div>
		<div class="inline-flex items-center gap-3">
			<a href="/apps/ecommerce/products/create" class="btn btn-primary btn-sm max-sm:btn-square">
				@ui.IconSpan("lucide--plus", "size-4")
				<span class="hidden sm:inline">New Product</span>
			</a>
			<div class="dropdown dropdown-bottom dropdown-end">
				<div tabindex="0" role="button" class="btn btn-ghost border-line-strong btn-sm btn-square" aria-label="More option">
					@ui.IconSpan("lucide--settings-2", "size-4")
				</div>
				<div tabindex="0" class="dropdown-content bg-base-100 rounded-box z-1 w-52 shadow">
					<ul class="menu w-full p-2">
						<li><div>@ui.IconSpan("lucide--wand", "size-4") Bulk Actions</div></li>
					</ul>
					<hr class="border-line-strong"/>
					<ul class="menu w-full p-2">
						<li><div>@ui.IconSpan("lucide--download-cloud", "size-4") Import from Store</div></li>
						<li><div>@ui.IconSpan("lucide--copy-plus", "size-4") Create from Existing</div></li>
					</ul>
				</div>
			</div>
		</div>
	}
}

templ productsListFooter() {
	<div class="flex items-center justify-between p-6">
		<div class="text-body hover:text-base-content flex gap-2 text-sm">
			<span class="hidden sm:inline">Per page</span>
			<select class="select select-xs w-18" aria-label="Per page">
				<option value="10">10</option><option value="20" selected>20</option><option value="50">50</option><option value="100">100</option>
			</select>
		</div>
		<span class="text-body hidden text-sm lg:inline">Showing <span class="text-base-content font-medium">1 to 20 </span>of 457 items</span>
		<div class="inline-flex items-center gap-1">
			<button class="btn btn-circle sm:btn-sm btn-xs btn-ghost" aria-label="Prev"><span class="iconify lucide--chevron-left"></span></button>
			<button class="btn btn-primary btn-circle sm:btn-sm btn-xs">1</button>
			<button class="btn btn-ghost btn-circle sm:btn-sm btn-xs">2</button>
			<button class="btn btn-ghost btn-circle sm:btn-sm btn-xs">3</button>
			<button class="btn btn-circle sm:btn-sm btn-xs btn-ghost" aria-label="Next"><span class="iconify lucide--chevron-right"></span></button>
		</div>
	</div>
}

templ productRow(num, id, name, category, price, rating, ratingCount, orders, stock, created string) {
	@table.TableRow("", true, nil) {
		@table.TableSelectRow("", false)
		@table.TableCell("", nil) {
			{ id }
		}
		@table.TableCell("", nil) {
			<div class="flex items-center space-x-3 truncate">
				<img class="rounded-box size-10" src={ "/images/apps/ecommerce/products/" + num + ".jpg" } alt="Product"/>
				<div>
					<p class="font-medium">{ productNameOnly(name) }</p>
					<p class="text-muted text-xs">{ productSKU(name) }</p>
				</div>
			</div>
		}
		@table.TableCell("", nil) {
			{ category }
		}
		@table.TableCell("text-sm font-medium", nil) {
			{ price }
		}
		@table.TableCell("", nil) {
			<div class="flex items-center gap-2">
				<span class="iconify lucide--star text-success size-4"></span>
				{ rating }
				<span class="text-muted text-xs">({ ratingCount })</span>
			</div>
		}
		@table.TableCell("", nil) {
			{ orders }
		}
		@table.TableCell("", nil) {
			@productStockBadge(stock)
		}
		@table.TableCell("text-sm", nil) {
			{ created }
		}
		@table.TableCell("", nil) {
			<div class="inline-flex">
				<a class="btn btn-square btn-ghost btn-sm" href="./apps-ecommerce-products-edit.html" aria-label="Edit product link"><span class="iconify lucide--pencil text-body size-4"></span></a>
				<button class="btn btn-square btn-ghost btn-sm" aria-label="Dummy show product"><span class="iconify lucide--eye text-body size-4"></span></button>
				<button class="btn btn-square btn-error btn-outline btn-sm border-transparent" onclick="apps_product_delete.showModal()" aria-label="Dummy delete product"><span class="iconify lucide--trash size-4"></span></button>
			</div>
		}
	}
}

templ productStockBadge(stock string) {
	if stock == "Available" {
		<span class="text-success">Available</span>
	} else {
		<span class="textarea-error">Out of stock</span>
	}
}

templ OrdersList() {

		<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/OrdersList")... }><h3 class="text-lg font-medium">Orders</h3><div class="breadcrumbs hidden p-0 text-sm sm:inline"><ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Ecommerce</li><li class="opacity-80">Orders</li></ul></div></div>

		<div class="mt-6">
			@table.TableCard(table.TableCardProps{
				Class:   "mt-5",
				Toolbar: ordersListToolbar(),
				Footer:  ordersListFooter(),
			}) {
				@table.TableWithProps(table.TableProps{}) {
					@table.TableHead() {
						@table.TableHeadRow() {
							@table.TableSelectAll("Check all")
							@table.TableHeadCell("ID")
							@table.TableHeadCell("Name")
							@table.TableHeadCell("Customer")
							@table.TableHeadCell("Price")
							@table.TableHeadCell("Payment")
							@table.TableHeadCell("Status")
							@table.TableHeadCell("Ordered At")
							@table.TableHeadCell("Action")
						}
					}
					@table.TableBody() {
						@orderTableRow("21001", "5 Items", "Emily Johnson", "$342", "Paid", "Ordered", "29 May 2024")
						@orderTableRow("21002", "3 Items", "Alex Thompson", "$578", "Paid", "Accepted", "29 Sep 2023")
						@orderTableRow("21003", "6 Items", "Sarah Davis", "$215", "Pending", "On the Way", "29 Jan 2024")
						@orderTableRow("21004", "2 Items", "Michael Wilson", "$769", "Pending", "Delivered", "29 Jul 2023")
						@orderTableRow("21005", "7 Items", "Jessica Miller", "$431", "Paid", "Accepted", "29 Apr 2024")
						@orderTableRow("21006", "1 Items", "Brian Anderson", "$622", "Paid", "Ordered", "29 Nov 2023")
						@orderTableRow("21007", "4 Items", "Olivia Smith", "$894", "Pending", "On the way", "29 Mar 2024")
						@orderTableRow("21008", "7 Items", "Daniel Robinson", "$156", "Paid", "Delivered", "29 Oct 2023")
						@orderTableRow("21009", "1 Items", "Emma Garcia", "$497", "Pending", "Ordered", "29 Jun 2024")
						@orderTableRow("21010", "3 Items", "Christopher Baker", "$783", "Paid", "Accepted", "29 Dec 2023")
