}

templ ShopForm(isCreate bool) {
	<div { devmode.Attrs(ctx, "nexus/ShopForm")... }>
		<div class="flex items-center justify-between"><h3 class="text-lg font-medium">Shop</h3></div>
		<div class="card bg-base-100 shadow-sm mt-6"><div class="card-body">Shop form</div></div>
	</div>
}
