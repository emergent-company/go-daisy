templ CustomerForm(isCreate bool) {
	{{ title := "Edit Customer" }}
	{{ crumb := "Edit" }}
	{{ if isCreate { title = "Create Customer"; crumb = "Create" } }}
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  title,
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Customers", Href: "/apps/ecommerce/customers"},
			{Label: crumb},
		},
	})
	<div class="mt-6">
		<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">Basic Information</div>
				<div class="fieldset mt-2 grid grid-cols-1 gap-4 lg:grid-cols-2">
					@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "name", Label: "Name", Placeholder: "Name"})
					@form.FormField(form.FormFieldProps{Type: form.FieldEmail, Name: "email", Label: "Email", Placeholder: "Email"})
					@form.FormField(form.FormFieldProps{Type: form.FieldTel, Name: "mobile", Label: "Mobile", Placeholder: "(098) 765 4321"})
					@form.FormField(form.FormFieldProps{Type: form.FieldDate, Name: "DOB", Label: "DOB"})
					<div class="flex items-center gap-3">
						@form.ToggleInput(form.ToggleInputProps{Name: "verified", Class: "toggle toggle-sm", Attrs: templ.Attributes{"id": "verified"}})
						<label class="label" for="verified">Verified</label>
					</div>
					<div class="flex items-center gap-3">
						@form.RadioButton("apps-seller-gender", "male", "Male", true, "radio-sm")
						@form.RadioButton("apps-seller-gender", "female", "Female", true, "radio-sm")
					</div>
				</div>
			}
			@entityAddressCard(false, "set-as-permanent", "Set as permanent")
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">Upload Image</div>
				<div class="mt-4">
					@form.FileUpload(form.FileUploadProps{Name: "image"})
				</div>
			}
			@entityPasswordCard(isCreate)
		</div>
		@entityFormActions("/apps/ecommerce/customers", isCreate)
	</div>
}

templ ShopsList() {
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  "Shops",
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Ecommerce"},
			{Label: "Shops"},
		},
	})
	<div class="mt-6">
		@table.TableCard(table.TableCardProps{
			Toolbar: listToolbar("Search along shops", "Search shops", "Verification status", "Create shop link", "/apps/ecommerce/shops/create", "New Shop"),
			Footer:  listFooter(),
		}) {
			@table.TableWithProps(table.TableProps{Class: "whitespace-nowrap"}) {
				@table.TableHead() {
					@table.TableHeadRow() {
						@table.TableSelectAll("Check all")
						@table.TableHeadCell("ID")
						@table.TableHeadCell("Name")
						@table.TableHeadCell("Seller")
						@table.TableHeadCell("Email")
						@table.TableHeadCell("Mobile")
						@table.TableHeadCell("Sales")
						@table.TableHeadCell("Rating")
						@table.TableHeadCell("Earning")
						@table.TableHeadCell("Verified")
						@table.TableHeadCell("Joined Date")
						@table.TableHeadCell("Action")
					}
				}
				@table.TableBody() {
					@shopRow("1", "Urban Chic Boutique", "Anthony S. Amaya", "urban.chic@yahoo.com", "402-788-1602", "20", "4.4", "124", "$350", "29 Mar 2024", true)
					@shopRow("2", "Whimsical Wares Emporium", "Crystal R. Taylor", "whimscal_ware@hotmail.com", "469-632-2611", "24", "4.7", "241", "$360", "29 Apr 2024", true)
					@shopRow("3", "Serene Styles Haven", "Jeremy M. Simon", "serene.styles@gmail.com", "207-538-1345", "34", "4.2", "104", "$574", "29 Nov 2023", true)
					@shopRow("4", "Posh Picks Boutique", "Jane B. Bush", "posh_picks@bush.com", "612-326-9186", "54", "3.8", "261", "$487", "29 Jan 2024", true)
					@shopRow("5", "Blissful Finds Co.", "Francis A. Bisson", "blissful_co@outlook.com", "317-949-1232", "67", "3.4", "195", "$784", "29 Dec 2023", false)
					@shopRow("6", "Trendy Threads Emporium", "Lydia P. Barnett", "trendy_te@mail.com", "936-895-2100", "74", "4.6", "135", "$657", "29 Jun 2023", true)
					@shopRow("7", "Luxe Loft Creations", "John B. Lopez", "luxe.loft@lopez.com", "262-849-4319", "45", "4.9", "321", "$354", "29 Jul 2023", true)
					@shopRow("8", "Vintage Vogue Hub", "Detra M. Rogers", "vintage_hub@rogers.com", "847-452-0238", "21", "2.8", "12", "$352", "29 Dec 2023", true)
					@shopRow("9", "Coastal Charm Marketplace", "Antonio D. Goss", "antonio_gross@ant.com", "203-250-6265", "29", "3.4", "238", "$920", "29 Apr 2023", false)
					@shopRow("10", "Dapper Designs Depot", "Brenda R. Holmes", "dapper.designs@mail.com", "325-480-1291", "67", "4.1", "541", "$874", "29 Mar 2023", true)
				}
			}
		}
		@listDeleteDialog("apps_shop_delete", "shop")
	</div>
}

templ shopRow(num, name, seller, email, mobile, sales, rating, ratingCount, earning, date string, verified bool) {
	@table.TableRow("", true, nil) {
		@table.TableSelectRow("", false)
		@table.TableCell("font-medium", nil) {
			{ num }
		}
		@table.TableCell("font-medium", nil) {
			{ name }
		}
		@table.TableCell("", nil) {
			{ seller }
		}
		@table.TableCell("", nil) {
			{ email }
		}
		@table.TableCell("", nil) {
			{ mobile }
		}
		@table.TableCell("", nil) {
			{ sales }
		}
		@table.TableCell("", nil) {
			<div class="flex items-center gap-1">
				<span class={ "iconify lucide--star size-4", shopRatingClass(rating) }></span>
				{ rating }
				<span class="text-body text-xs">({ ratingCount })</span>
			</div>
		}
		@table.TableCell("", nil) {
			<div class="text-sm font-medium">{ earning }</div>
		}
		@table.TableCell("", nil) {
			@verifiedIcon(verified)
		}
		@table.TableCell("text-sm", nil) {
			{ date }
		}
		@table.TableCell("", nil) {
			@listRowActions("Edit shop link", "Dummy show shop", "Dummy delete shop", "apps_shop_delete", "/apps/ecommerce/shops/1")
		}
	}
}

templ ShopForm(isCreate bool) {
	{{ title := "Edit Shop" }}
	{{ crumb := "Edit" }}
	{{ if isCreate { title = "Create Shop"; crumb = "Create" } }}
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  title,
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Shops", Href: "/apps/ecommerce/shops"},
			{Label: crumb},
		},
	})
	<div class="mt-6">
		<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
			@ui.CardRaw(ui.CardRawProps{Class: "shadow", Border: ui.CardBorderNone}) {
				<div class="card-title text-base font-medium">Basic Information</div>
				<div class="fieldset mt-2 grid grid-cols-1 gap-4 lg:grid-cols-2">
					@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "name", Label: "Name", Placeholder: "Name"})
					@form.FormSelect("seller", "Seller", "", [][2]string{
						{"Anthony S. Amaya", "Anthony S. Amaya"},
						{"Crystal R. Taylor", "Crystal R. Taylor"},
						{"Jeremy M. Simon", "Jeremy M. Simon"},
						{"Jane B. Bush", "Jane B. Bush"},
						{"Francis A. Bisson", "Francis A. Bisson"},
						{"Lydia P. Barnett", "Lydia P. Barnett"},
						{"John B. Lopez", "John B. Lopez"},
					}, "Select seller", form.LabelAbove, "", "", nil)
					@form.FormField(form.FormFieldProps{Type: form.FieldTel, Name: "mobile", Label: "Mobile", Placeholder: "(098) 765 4321"})
					@form.FormField(form.FormFieldProps{Type: form.FieldEmail, Name: "email", Label: "Email", Placeholder: "Email"})
					<div class="col-span-1 lg:col-span-2">
						@form.FormField(form.FormFieldProps{Type: form.FieldTextarea, Name: "description", Label: "Description", Placeholder: "Description"})
					</div>
				</div>
			}
			@entityAddressCard(true, "set-as-active", "Set as active")
		</div>
		@entityFormActions("/apps/ecommerce/shops", isCreate)
	</div>
}

templ entityAddressCard(hFit bool, checkboxName string, checkboxLabel string) {
	{{ cardClass := "shadow" }}
	{{ if hFit { cardClass = "h-fit shadow" } }}
	@ui.CardRaw(ui.CardRawProps{Class: cardClass, Border: ui.CardBorderNone}) {
		<div class="card-title text-base font-medium">Address</div>
		<div class="fieldset mt-2 grid grid-cols-1 gap-4 lg:grid-cols-2">
			@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "street-address", Label: "Street Address", Placeholder: "Street Address"})
			@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "city", Label: "City", Placeholder: "City"})
			@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "state", Label: "State", Placeholder: "State"})
			@form.FormField(form.FormFieldProps{Type: form.FieldText, Name: "postal-code", Label: "Postal Code", Placeholder: "564-879"})
			@form.FormField(form.FormFieldProps{Type: form.FieldCheckbox, Name: checkboxName, Label: checkboxLabel})
		</div>
	}
}

templ entityPasswordCard(isCreate bool) {
	@ui.CardRaw(ui.CardRawProps{Class: "h-fit shadow", Border: ui.CardBorderNone, BodyClass: "gap-0"}) {
		<div class="card-title text-base font-medium">
			if isCreate {
				Create Password
			} else {
				Change Password
			}
		</div>
		<div class="fieldset mt-2 grid grid-cols-1 gap-x-4 lg:grid-cols-2">
			if isCreate {
				@form.PasswordField(form.PasswordFieldProps{Name: "password", Label: "Password", Placeholder: "Password", ShowToggle: true, Icon: "lucide--key-round"})
				@form.PasswordField(form.PasswordFieldProps{Name: "confirm-password", Label: "Confirm Password", Placeholder: "Confirm Password", ShowToggle: true, Icon: "lucide--key-round"})
			} else {
				@form.PasswordField(form.PasswordFieldProps{Name: "old-password", Label: "Old Password", Placeholder: "Password", ShowToggle: true, Icon: "lucide--key-round"})
				@form.PasswordField(form.PasswordFieldProps{Name: "new-password", Label: "New Password", Placeholder: "Confirm Password", ShowToggle: true, Icon: "lucide--key-round"})
			}
		</div>
	}
}

templ entityFormActions(cancelHref string, isCreate bool) {
	<div class="mt-6 flex justify-end gap-3">
		@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLink, Href: cancelHref, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Icon: "lucide--x"}){ Cancel }
		if isCreate {
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLink, Href: cancelHref, Variant: ui.ButtonPrimary, Size: ui.ButtonSM, Icon: "lucide--check"}){ Save }
		} else {
			@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLink, Href: cancelHref, Variant: ui.ButtonPrimary, Size: ui.ButtonSM, Icon: "lucide--arrow-up-from-line"}){ Update }
		}
	</div>
}

