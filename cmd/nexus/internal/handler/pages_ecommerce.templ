templ orderTableRow(id, name, customer, price, payment, status, date string) {
	@table.TableRow("", true, nil) {
		@table.TableSelectRow("", false)
		@table.TableCell("font-medium", nil) {
			#{ id }
		}
		@table.TableCell("", nil) {
			{ name }
		}
		@table.TableCell("", nil) {
			{ customer }
		}
		@table.TableCell("text-sm font-medium", nil) {
			{ price }
		}
		@table.TableCell("", nil) {
			@orderStatusBadge(payment)
		}
		@table.TableCell("text-sm", nil) {
			{ status }
		}
		@table.TableCell("text-sm", nil) {
			{ date }
		}
		@table.TableCell("", nil) {
			<a aria-label="View order"><button class="btn btn-square btn-ghost btn-sm"><span class="iconify lucide--eye text-body size-4"></span></button></a>
		}
	}
}

templ orderStatusBadge(status string) {
	if status == "Paid" {
		<div class="badge badge-soft badge-success">{ status }</div>
	} else if status == "Pending" {
		<div class="badge badge-soft badge-error">{ status }</div>
	} else {
		{ status }
	}
}

templ OrderDetail() {

	<div { devmode.Attrs(ctx, "nexus/OrderDetail")... }>

		<div class="flex items-center justify-between"><h3 class="text-lg font-medium">Order #ORD-001</h3><div class="breadcrumbs hidden p-0 text-sm sm:inline"><ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Ecommerce</li><li><a href="/apps/ecommerce/orders">Orders</a></li><li class="opacity-80">#ORD-001</li></ul></div></div>

		<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">

			<div class="card bg-base-100 shadow-sm">

				<div class="card-body">

					<h4 class="text-base font-semibold">Order Details</h4>

					<div class="divider"></div>

					<dl class="space-y-3 text-sm">

						<div class="flex justify-between"><dt class="text-muted">Customer</dt><dd>Alice Johnson</dd></div>

						<div class="flex justify-between"><dt class="text-muted">Email</dt><dd>alice@example.com</dd></div>

						<div class="flex justify-between"><dt class="text-muted">Total</dt><dd>$129.99</dd></div>

						<div class="flex justify-between"><dt class="text-muted">Date</dt><dd>2025-01-15</dd></div>

					</dl>

				</div>

			</div>

			<div class="card bg-base-100 shadow-sm">

				<div class="card-body">

					<h4 class="text-base font-semibold">Order Items</h4>

					<div class="divider"></div>

					<ul class="space-y-2 text-sm">

						<li class="flex justify-between"><span>Running Shoes (x1)</span><span>$99.99</span></li>

						<li class="flex justify-between"><span>Workout T-Shirt (x1)</span><span>$20.99</span></li>

						<li class="flex justify-between"><span>Water Bottle (x1)</span><span>$9.01</span></li>

					</ul>

				</div>

			</div>

			<div class="card bg-base-100 shadow-sm">

				<div class="card-body">

					<h4 class="text-base font-semibold">Shipping Information</h4>

					<div class="divider"></div>

					<dl class="space-y-3 text-sm">

						<div class="flex justify-between"><dt class="text-muted">Address</dt><dd>123 Main St, NY 10001</dd></div>

						<div class="flex justify-between"><dt class="text-muted">Method</dt><dd>Express (+$5.99)</dd></div>

						<div class="flex justify-between"><dt class="text-muted">Tracking</dt><dd>1Z999AA10123456784</dd></div>

						<div class="flex justify-between"><dt class="text-muted">Status</dt><dd><span class="text-info">In transit</span></dd></div>

					</dl>

				</div>

			</div>

		</div>

		<div class="mt-6 flex gap-3">

			@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost}){ "Back to Orders" }

			@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary}){ "Update Status" }

		</div>

	</div>
}

templ CreateProductForm() {
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/CreateProductForm")... }>

		<div class="flex items-center justify-between"><h3 class="text-lg font-medium">Create Product</h3><div class="breadcrumbs hidden p-0 text-sm sm:inline"><ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Ecommerce</li><li><a href="/apps/ecommerce/products">Products</a></li><li class="opacity-80">Create</li></ul></div></div>

		<div class="card bg-base-100 shadow-sm mt-6">
			<div class="card-body">
				<form hx-post="/apps/ecommerce/products" hx-swap="none">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						@form.FormField(form.FormFieldProps{Type: "text", Name: "name", Label: "Product Name", Placeholder: "Enter product name", Required: true})
						@form.FormField(form.FormFieldProps{Type: "select", Name: "category", Label: "Category", Options: []form.SelectOption{
							{Value: "fashion", Label: "Fashion"},
							{Value: "electronics", Label: "Electronics"},
							{Value: "home", Label: "Home & Garden"},
							{Value: "sports", Label: "Sports"},
						}, Required: true})
						@form.FormField(form.FormFieldProps{Type: "number", Name: "price", Label: "Price", Placeholder: "0.00", Required: true})
						@form.FormField(form.FormFieldProps{Type: "number", Name: "stock", Label: "Stock", Placeholder: "0", Required: true})
						@form.FormField(form.FormFieldProps{Type: "text", Name: "sku", Label: "SKU", Placeholder: "SKU-001"})
					</div>
					@form.FormField(form.FormFieldProps{Type: "textarea", Name: "description", Label: "Description", Placeholder: "Product description...", Rows: 4})
					@form.FileUpload(form.FileUploadProps{Name: "image", Label: "Product Image", Accept: "image/*"})
					<div class="mt-6 flex gap-3">
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost}){ "Cancel" }
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: ui.ButtonTypeSubmit}){ "Create Product" }
					</div>
				</form>
			</div>
		</div>

	</div>
}

templ EditProductForm() {
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/EditProductForm")... }>

		<div class="flex items-center justify-between"><h3 class="text-lg font-medium">Edit Product</h3><div class="breadcrumbs hidden p-0 text-sm sm:inline"><ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Ecommerce</li><li><a href="/apps/ecommerce/products">Products</a></li><li class="opacity-80">Edit</li></ul></div></div>

		<div class="card bg-base-100 shadow-sm mt-6">
			<div class="card-body">
				<form hx-post="/apps/ecommerce/products/1" hx-swap="none">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						@form.FormField(form.FormFieldProps{Type: "text", Name: "name", Label: "Product Name", Placeholder: "Enter product name", Required: true})
						@form.FormField(form.FormFieldProps{Type: "select", Name: "category", Label: "Category", Options: []form.SelectOption{
							{Value: "fashion", Label: "Fashion"},
							{Value: "electronics", Label: "Electronics"},
						}, Required: true})
						@form.FormField(form.FormFieldProps{Type: "number", Name: "price", Label: "Price", Placeholder: "0.00", Required: true})
						@form.FormField(form.FormFieldProps{Type: "number", Name: "stock", Label: "Stock", Placeholder: "0", Required: true})
						@form.FormField(form.FormFieldProps{Type: "text", Name: "sku", Label: "SKU", Placeholder: "SKU-001"})
					</div>
					@form.FormField(form.FormFieldProps{Type: "textarea", Name: "description", Label: "Description", Placeholder: "Product description...", Rows: 4})
					@form.FileUpload(form.FileUploadProps{Name: "image", Label: "Product Image", Accept: "image/*"})
					<div class="mt-6 flex gap-3">
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost}){ "Cancel" }
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Type: ui.ButtonTypeSubmit}){ "Save Changes" }
					</div>
				</form>
			</div>
		</div>

	</div>
}

templ ProductForm(isCreate bool) {
	<div { devmode.Attrs(ctx, "nexus/ProductForm")... }>
		<div class="flex items-center justify-between"><h3 class="text-lg font-medium">Product</h3></div>
		<div class="card bg-base-100 shadow-sm mt-6"><div class="card-body">Product form</div></div>
	</div>
}

templ SellersList() {
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  "Sellers",
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Ecommerce"},
			{Label: "Sellers"},
		},
	})
	<div class="mt-6">
		@table.TableCard(table.TableCardProps{
			Toolbar: listToolbar("Search along sellers", "Search sellers", "Verification status", "Create seller link", "/apps/ecommerce/sellers/create", "New Seller"),
			Footer:  listFooter(),
		}) {
			@table.TableWithProps(table.TableProps{}) {
				@table.TableHead() {
					@table.TableHeadRow() {
						@table.TableSelectAll("Check all")
						@table.TableHeadCell("ID")
						@table.TableHeadCell("Name")
						@table.TableHeadCell("Shop")
						@table.TableHeadCell("Email")
						@table.TableHeadCell("Mobile")
						@table.TableHeadCell("Sales")
						@table.TableHeadCell("Earning")
						@table.TableHeadCell("Verified")
						@table.TableHeadCell("Joined Date")
						@table.TableHeadCell("Action")
					}
				}
				@table.TableBody() {
