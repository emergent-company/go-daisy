						<div class="dropdown dropdown-top dropdown-start"><div tabindex="0" aria-label="Dropdown" role="button" class="btn btn-square btn-sm"><span class="iconify lucide--arrow-up rotate-45"></span></div><div tabindex="0" class="dropdown-content bg-base-100 card card-border z-1 m-1 w-36 p-3 text-sm shadow-xs hover:shadow-sm"><p>Side: Top</p><p>Align: Start</p></div></div>
