package handler

import (
	"github.com/emergent-company/go-daisy/devmode"
)

templ UIComponentsPage() {
	<div { devmode.Attrs(ctx, "nexus/UIComponents")... }>
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-medium">UI Components</h3>
			<div class="breadcrumbs hidden p-0 text-sm sm:inline">
				<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>UI Showcase</li><li class="opacity-80">Components</li></ul>
			</div>
		</div>
		<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
			@compCard("Accordion", "Collapsible sections", "ui.Accordion")
			@compCard("Alert", "Status messages", "ui.Alert")
			@compCard("Avatar", "User avatars with initials", "ui.Avatar")
			@compCard("Badge", "Labels and counts", "ui.Badge")
			@compCard("Button", "Button variants with icons", "ui.Button")
			@compCard("Card", "Content containers", "ui.Card")
			@compCard("Chart", "ApexCharts integration", "ui.Chart")
			@compCard("ChatBubble", "Chat message bubbles", "ui.ChatBubble")
			@compCard("ChatInput", "Chat input bar", "ui.ChatInput")
			@compCard("Countdown", "Animated timer", "ui.Countdown")
			@compCard("Divider", "Content separators", "ui.Divider")
			@compCard("Drawer", "Slide-in panels", "ui.Drawer")
			@compCard("Dropdown", "Dropdown menus", "ui.Dropdown")
			@compCard("Empty", "Empty state placeholder", "ui.Empty")
			@compCard("Fieldset", "Form field groups", "ui.Fieldset")
			@compCard("Hero", "Hero section with CTA", "ui.Hero")
			@compCard("Indicator", "Badge overlays", "ui.Indicator")
			@compCard("Join", "Fused element groups", "ui.Join")
			@compCard("Kbd", "Keyboard shortcuts", "ui.Kbd")
			@compCard("List", "Vertical list items", "ui.List")
			@compCard("Loader", "Loading spinners", "ui.Loader")
			@compCard("Mask", "Shape masks", "ui.Mask")
			@compCard("Modal", "Dialog modals", "ui.Modal")
			@compCard("Pagination", "Page navigation", "ui.Pagination")
			@compCard("PersonCell", "Identity cell", "ui.PersonCell")
			@compCard("Progress", "Progress bars", "ui.Progress")
			@compCard("RadialProgress", "Circular progress", "ui.RadialProgress")
			@compCard("Rating", "Star/heart rating", "form.Rating")
			@compCard("Skeleton", "Loading placeholders", "ui.Skeleton")
			@compCard("Stack", "Overlapping cards", "ui.Stack")
			@compCard("StatCard", "KPI stat widgets", "ui.StatCard")
			@compCard("Steps", "Step indicators", "ui.Steps")
			@compCard("Swap", "Toggle between states", "ui.Swap")
			@compCard("Tabs", "Tabbed navigation", "ui.Tabs")
			@compCard("Tag", "Removable chips", "ui.Tag")
			@compCard("Testimonial", "Testimonial cards", "ui.TestimonialCard")
			@compCard("ThemeSwitcher", "Dark/light toggle", "ui.ThemeSwitcher")
			@compCard("Timeline", "Vertical timeline", "ui.Timeline")
			@compCard("Toast", "Toast notifications", "ui.Toast")
			@compCard("Tooltip", "Hover tooltips", "ui.Tooltip")
			@compCard("RangeInput", "Range slider", "form.RangeInput")
			@compCard("Checkbox", "Checkbox inputs", "form.Checkbox")
			@compCard("Toggle", "Toggle switches", "form.Toggle")
			@compCard("FileUpload", "File upload area", "form.FileUpload")
			@compCard("PasswordField", "Password input", "form.PasswordField")
			@compCard("Calendar", "Calendar component", "form.CalendarWrapper")
			@compCard("WizardStepper", "Multi-step wizard", "form.WizardStepper")
			@compCard("OTPInput", "OTP digit input", "form.OTPInput")
			@compCard("RichTextEditor", "Text editor", "form.RichTextEditor")
			@compCard("PromptBar", "AI prompt input", "form.PromptBar")
		</div>
	</div>
}

templ compCard(title, desc, importPath string) {
	<div class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-base-200">
		<div class="card-body p-4">
			<h4 class="font-semibold text-sm">{ title }</h4>
			<p class="text-xs text-base-content/60 mt-0.5">{ desc }</p>
			<div class="badge badge-ghost badge-xs mt-2 font-mono">{ importPath }</div>
		</div>
	</div>
}

templ UIFormsPage() {
	<div { devmode.Attrs(ctx, "nexus/UIForms")... }>
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-medium">Form Components</h3>
			<div class="breadcrumbs hidden p-0 text-sm sm:inline">
				<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>UI Showcase</li><li class="opacity-80">Forms</li></ul>
			</div>
		</div>
		<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
			@compCard("TextInput", "Text input field with label", "form.TextInput")
			@compCard("TextareaInput", "Multi-line text input", "form.TextareaInput")
			@compCard("SelectInput", "Dropdown select", "form.SelectInput")
			@compCard("EnhancedSelect", "Multi-select with search", "form.EnhancedSelect")
			@compCard("SearchInput", "Search field with icon", "form.SearchInput")
			@compCard("Checkbox", "Checkbox input", "form.Checkbox / FormCheckbox")
			@compCard("Toggle", "Toggle s/w", "form.Toggle / FormToggle")
			@compCard("RadioGroup", "Radio button group", "form.RadioGroup")
			@compCard("RangeInput", "Range slider", "form.RangeInput")
			@compCard("Rating", "Star/heart rating", "form.Rating")
			@compCard("FileInput", "File input field", "form.FileInput")
			@compCard("FileUpload", "Drag-drop upload area", "form.FileUpload")
			@compCard("PasswordField", "Password with toggle", "form.PasswordField")
			@compCard("PasswordMeter", "Password strength meter", "form.PasswordMeter")
			@compCard("FormField", "Unified form field", "form.FormField")
			@compCard("FormControl", "Label + input wrapper", "form.FormControl")
			@compCard("FormValidation", "Form with validation", "form.FormValidation")
			@compCard("OTPInput", "OTP digit input", "form.OTPInput")
			@compCard("ColorInput", "Color picker", "form.ColorInput")
			@compCard("DateInput", "Native date input", "form.DateInput")
			@compCard("DatePicker", "Date picker with calendar", "form.DatePicker")
			@compCard("CalendarWrapper", "Calendar display", "form.CalendarWrapper")
			@compCard("RichTextEditor", "Rich text editor", "form.RichTextEditor")
			@compCard("WizardStepper", "Multi-step form wizard", "form.WizardStepper")
			@compCard("PromptBar", "AI prompt input", "form.PromptBar")
			@compCard("PromptBarAction", "Prompt with actions", "form.PromptBarAction")
			@compCard("InputSpinner", "Numeric stepper", "form.InputSpinner")
			@compCard("DatalistInput", "Input with suggestions", "form.DatalistInput")
			@compCard("FormActions", "Submit/Cancel row", "form.FormActions")
		</div>
	</div>
}

templ UIChartsPage() {
	<div { devmode.Attrs(ctx, "nexus/UICharts")... }>
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-medium">Chart Components</h3>
			<div class="breadcrumbs hidden p-0 text-sm sm:inline">
				<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>UI Showcase</li><li class="opacity-80">Charts</li></ul>
			</div>
		</div>
		<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
			@compCard("Area Chart", "Filled area visualization", "ui.Chart{Type: ChartArea}")
			@compCard("Bar Chart", "Vertical/horizontal bars", "ui.Chart{Type: ChartBar}")
			@compCard("Column Chart", "Grouped/stacked columns", "ui.Chart{Type: ChartColumn}")
			@compCard("Line Chart", "Stepline/smooth lines", "ui.Chart{Type: ChartLine}")
			@compCard("Pie Chart", "Circular segments", "ui.Chart{Type: ChartPie}")
			@compCard("Donut Chart", "Hollow pie chart", "ui.Chart{Type: ChartDonut}")
			@compCard("Radial Chart", "Semi-circle gauge", "ui.Chart{Type: ChartRadial}")
			@compCard("Heatmap", "Color-intensity grid", "ui.Chart{Type: ChartHeatmap}")
			@compCard("Range Bar", "Dumbbell charts", "ui.Chart{Type: ChartRangeBar}")
			@compCard("Stacked", "Stacked bars/columns", "ui.Chart{Stacked: true}")
			@compCard("Sparkline", "Inline mini chart", "ui.Chart{Sparkline: true}")
			@compCard("Forecast", "Data prediction", "ui.Chart{ForecastCount: N}")
			@compCard("Annotations", "Reference lines/labels", "ui.Chart{Annotations: [...]}")
			@compCard("Gradient Fill", "Color gradient fills", "ui.Chart{FillType: gradient}")
			@compCard("Synced Charts", "Grouped tooltips", "ui.Chart{GroupID: ...}")
		</div>
	</div>
}

templ UIComponentDetailPage(name string) {
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/UIComponentDetail")... }>
		<h3 class="text-lg font-medium">{ capFirst(name) }</h3>
		<div class="breadcrumbs hidden p-0 text-sm sm:inline">
			<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Components</li><li class="opacity-80">{ capFirst(name) }</li></ul>
		</div>
	</div>
	@renderComponentDemo(name)
}

templ UIFormDetailPage(name string) {
	{{ title := capFirst(name) }}
	if name == "select" {
		{{ title = "File Input" }}
	}
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/UIFormDetail")... }>
		<h3 class="text-lg font-medium">{ title }</h3>
		<div class="breadcrumbs hidden p-0 text-sm sm:inline">
			<ul><li><a href="#">Nexus</a></li><li>Forms</li><li class="opacity-80">{ title }</li></ul>
		</div>
	</div>
	@renderFormDemo(name)
}


templ UIChartDetailPage(name string) {
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/UIChartDetail")... }>
		<h3 class="text-lg font-medium">{ capFirst(name) } Chart</h3>
		<div class="breadcrumbs hidden p-0 text-sm sm:inline">
			<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li><a href="/ui/charts">Charts</a></li><li class="opacity-80">{ capFirst(name) }</li></ul>
		</div>
	</div>
	<div class="mt-6">
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h4 class="text-base font-semibold">{ name } Chart</h4>
				<p class="text-sm text-base-content/60 mt-1">go-daisy chart type.</p>
				<div class="divider"></div>
				<div class="bg-base-200 rounded-box p-4 flex items-center justify-center" style="min-height: 300px">
					<span class="text-base-content/40">Chart demo: { name }</span>
				</div>
			</div>
		</div>
	</div>
}


templ renderComponentDemo(name string) {
	switch name {
	case "accordion":
		<div class="w-full">
			<div class="collapse collapse-arrow border border-base-300 bg-base-100 rounded-box"><input type="checkbox"/><div class="collapse-title font-medium">Click to expand</div><div class="collapse-content"><p>TABINDEX / ESC to close</p></div></div>
			<div class="collapse collapse-plus border border-base-300 bg-base-100 rounded-box mt-1"><input type="checkbox"/><div class="collapse-title font-medium">Plus icon</div><div class="collapse-content"><p>Uses collapse-plus class</p></div></div>
		</div>
	case "alert":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div><div class="mt-4"><div class="alert" role="alert"><span class="iconify lucide--info text-info size-5"></span><span>12 unread messages. Tap to see.</span></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Button</div><div class="mt-4"><div class="alert" role="alert"><span class="iconify lucide--cookie text-info size-5"></span><span>12 unread messages. Tap to see.</span><div class="space-x-2"><button class="btn btn-sm">Deny</button><button class="btn btn-sm btn-primary">Accept</button></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Description</div><div class="mt-4"><div class="alert" role="alert"><span class="iconify lucide--message-square-dashed size-5"></span><div><h3 class="font-medium">New message!</h3><div class="text-base-content/70 text-xs">You have 1 unread message</div></div><button class="btn btn-sm">See</button></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Confirmation</div><div class="mt-4"><div class="alert" role="alert"><span class="iconify lucide--trash-2 text-error size-5"></span><div><h3 class="font-bold">12.7 MB Saved</h3><div class="text-xs">Some file removed</div></div><div class="space-x-2"><button class="btn btn-sm">Dismiss</button><button class="btn btn-sm btn-primary">Restore</button></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Solid</div><div class="mt-4 space-y-3"><div class="alert alert-success" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-info" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-warning" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-error" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Soft</div><div class="mt-4 space-y-3"><div class="alert alert-success alert-soft" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-soft alert-info" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-soft alert-warning" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-error alert-soft" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Outline</div><div class="mt-4 space-y-3"><div class="alert alert-success alert-outline" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-outline alert-info" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-outline alert-warning" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-outline alert-error" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Dashed</div><div class="mt-4 space-y-3"><div class="alert alert-success alert-dash" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-dash alert-info" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-dash alert-warning" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div><div class="alert alert-dash alert-error" role="alert"><span class="iconify lucide--info size-5"></span><span>New software update available.</span></div></div></div></div>
		</div>
	case "avatar":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div><div class="mt-4"><div class="avatar"><div class="bg-base-200 rounded-box w-20"><img alt="Avatar" src="/images/avatars/1.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Rounded</div><div class="mt-4 flex flex-wrap items-center gap-4"><div class="avatar"><div class="bg-base-200 w-20 rounded-xl"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar"><div class="bg-base-200 w-20 rounded-full"><img alt="Avatar" src="/images/avatars/2.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-wrap items-center gap-4"><div class="avatar"><div class="bg-base-200 rounded-box w-24"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-base-200 rounded-box w-20"><img alt="Avatar" src="/images/avatars/2.png"/></div></div><div class="avatar"><div class="bg-base-200 rounded-box w-16"><img alt="Avatar" src="/images/avatars/3.png"/></div></div><div class="avatar"><div class="bg-base-200 rounded-box w-12"><img alt="Avatar" src="/images/avatars/1.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Mask</div><div class="mt-4 flex flex-wrap items-center gap-4"><div class="avatar"><div class="bg-base-200 mask mask-squircle w-20"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-base-200 mask mask-hexagon w-20"><img alt="Avatar" src="/images/avatars/2.png"/></div></div><div class="avatar"><div class="bg-base-200 mask mask-hexagon-2 w-20"><img alt="Avatar" src="/images/avatars/3.png"/></div></div><div class="avatar"><div class="bg-base-200 mask mask-diamond w-20"><img alt="Avatar" src="/images/avatars/4.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Group</div><div class="mt-4"><div class="avatar-group -space-x-5"><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/2.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/3.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/4.png"/></div></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Counter</div><div class="mt-4"><div class="avatar-group -space-x-5"><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/2.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/3.png"/></div></div><div class="avatar avatar-placeholder"><div class="bg-base-300 w-12 rounded-full">+99</div></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Ring</div><div class="mt-4"><div class="flex flex-wrap items-center gap-4"><div class="avatar"><div class="bg-primary/25 ring-primary ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-secondary/25 ring-secondary ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar"><div class="bg-accent/25 ring-accent ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/2.png"/></div></div><div class="avatar"><div class="bg-success/25 ring-success ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/3.png"/></div></div><div class="avatar"><div class="bg-info/25 ring-info ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-warning/25 ring-warning ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar"><div class="bg-error/25 ring-error ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/2.png"/></div></div><div class="avatar"><div class="bg-neutral/25 ring-neutral ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/3.png"/></div></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Presence</div><div class="mt-4 flex flex-wrap items-center gap-4"><div class="avatar avatar-online"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar avatar-offline"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/2.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Placeholder</div><div class="mt-4"><div class="flex flex-wrap items-center gap-4"><div class="avatar avatar-placeholder"><div class="bg-primary text-primary-content ring-primary ring-offset-base-100 w-12 rounded-full ring ring-offset-2">N</div></div><div class="avatar avatar-placeholder"><div class="bg-secondary text-secondary-content ring-secondary ring-offset-base-100 w-12 rounded-full ring ring-offset-2">E</div></div><div class="avatar avatar-placeholder"><div class="bg-success text-success-content ring-success ring-offset-base-100 w-12 rounded-full ring ring-offset-2">X</div></div><div class="avatar avatar-placeholder"><div class="bg-warning text-warning-content ring-warning ring-offset-base-100 w-12 rounded-full ring ring-offset-2">U</div></div><div class="avatar avatar-placeholder"><div class="bg-error text-error-content ring-error ring-offset-base-100 w-12 rounded-full ring ring-offset-2">S</div></div></div></div></div></div>
		</div>
	case "badge":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge">Badge</div><div class="badge badge-ghost">Ghost</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Empty</div><div class="mt-4 flex flex-wrap items-center gap-3"><div class="badge badge-primary badge-xl"></div><div class="badge badge-primary badge-lg"></div><div class="badge badge-primary badge-md"></div><div class="badge badge-primary badge-sm"></div><div class="badge badge-primary badge-xs"></div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Solid</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-primary">Primary</div><div class="badge badge-secondary">Secondary</div><div class="badge badge-accent">Accent</div><div class="badge badge-success">Success</div><div class="badge badge-info">Info</div><div class="badge badge-warning">Warning</div><div class="badge badge-error">Error</div><div class="badge badge-neutral">Neutral</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Soft</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-soft badge-primary">Primary</div><div class="badge badge-soft badge-secondary">Secondary</div><div class="badge badge-soft badge-accent">Accent</div><div class="badge badge-soft badge-success">Success</div><div class="badge badge-soft badge-info">Info</div><div class="badge badge-soft badge-warning">Warning</div><div class="badge badge-soft badge-error">Error</div><div class="badge badge-soft badge-neutral">Neutral</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Outline</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-outline badge-primary">Primary</div><div class="badge badge-outline badge-secondary">Secondary</div><div class="badge badge-outline badge-accent">Accent</div><div class="badge badge-outline badge-success">Success</div><div class="badge badge-outline badge-info">Info</div><div class="badge badge-outline badge-warning">Warning</div><div class="badge badge-outline badge-error">Error</div><div class="badge badge-outline badge-neutral">Neutral</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Dash</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-dash badge-primary">Primary</div><div class="badge badge-dash badge-secondary">Secondary</div><div class="badge badge-dash badge-accent">Accent</div><div class="badge badge-dash badge-success">Success</div><div class="badge badge-dash badge-info">Info</div><div class="badge badge-dash badge-warning">Warning</div><div class="badge badge-dash badge-error">Error</div><div class="badge badge-dash badge-neutral">Neutral</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Icon</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-success"><span class="iconify lucide--info"></span> Approved</div><div class="badge badge-info"><span class="iconify lucide--circle-alert"></span> Info</div><div class="badge badge-warning"><span class="iconify lucide--triangle-alert"></span> Warning</div><div class="badge badge-error"><span class="iconify lucide--ban"></span> Error</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-wrap items-center gap-3"><div class="badge badge-xl">Extra Large</div><div class="badge badge-lg">Large</div><div class="badge badge-md">Medium</div><div class="badge badge-sm">Small</div><div class="badge badge-xs">Extra Small</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Button</div><div class="mt-4 flex flex-wrap items-center gap-3"><button class="btn">Inbox <span class="badge badge-sm">+99</span></button><button class="btn"><span class="badge badge-primary badge-sm">+99</span></button></div></div></div>
		</div>
	case "breadcrumb":
		<div class="breadcrumbs text-sm"><ul><li><a href="#">Home</a></li><li><a href="#">Category</a></li><li>Current</li></ul></div>
	case "button":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div><div class="mt-4"><button class="btn btn-primary">Click me</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Disabled</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-disabled">Using class</button><button class="btn" disabled>Using attribute</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Solid</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-primary">Primary</button><button class="btn btn-secondary">Secondary</button><button class="btn btn-accent">Accent</button><button class="btn btn-success">Success</button><button class="btn btn-info">Info</button><button class="btn btn-warning">Warning</button><button class="btn btn-error">Error</button><button class="btn btn-neutral">Neutral</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Soft</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-soft btn-primary">Primary</button><button class="btn btn-soft btn-secondary">Secondary</button><button class="btn btn-soft btn-accent">Accent</button><button class="btn btn-soft btn-success">Success</button><button class="btn btn-soft btn-info">Info</button><button class="btn btn-soft btn-warning">Warning</button><button class="btn btn-soft btn-error">Error</button><button class="btn btn-soft btn-neutral">Neutral</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Outline</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-outline btn-primary">Primary</button><button class="btn btn-outline btn-secondary">Secondary</button><button class="btn btn-outline btn-accent">Accent</button><button class="btn btn-outline btn-success">Success</button><button class="btn btn-outline btn-info">Info</button><button class="btn btn-outline btn-warning">Warning</button><button class="btn btn-outline btn-error">Error</button><button class="btn btn-outline btn-neutral">Neutral</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Dash</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-dash btn-primary">Primary</button><button class="btn btn-dash btn-secondary">Secondary</button><button class="btn btn-dash btn-accent">Accent</button><button class="btn btn-dash btn-success">Success</button><button class="btn btn-dash btn-info">Info</button><button class="btn btn-dash btn-warning">Warning</button><button class="btn btn-dash btn-error">Error</button><button class="btn btn-dash btn-neutral">Neutral</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Ghost &amp; Link</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-ghost">Default</button><button class="btn btn-ghost btn-primary">Primary</button><button class="btn btn-ghost btn-secondary">Secondary</button><button class="btn btn-ghost btn-accent">Accent</button><button class="btn btn-ghost btn-success">Success</button><button class="btn btn-ghost btn-info">Info</button><button class="btn btn-ghost btn-warning">Warning</button><button class="btn btn-ghost btn-error">Error</button><button class="btn btn-ghost btn-neutral">Neutral</button><button class="btn btn-link">Link</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Icon</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-square gap-2"><span class="iconify lucide--heart size-4"></span></button><button class="btn gap-2"><span class="iconify lucide--heart size-4"></span>Click</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Rounded</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-circle gap-2"><span class="iconify lucide--heart size-4"></span></button><button class="btn btn-circle gap-2"><span class="iconify lucide--settings-2 size-4"></span></button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Loading</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-square gap-2"><span class="loading loading-spinner size-5"></span></button><button class="btn gap-2"><span class="loading loading-spinner size-5"></span>Loading</button><button class="btn btn-square gap-2"><span class="loading loading-spinner size-5"></span></button><button class="btn gap-2"><span class="loading loading-spinner size-5"></span>Loading</button></div></div></div>
		</div>

	case "card":
		<div class="grid grid-cols-2 gap-4">
			<div class="card bg-base-100 w-64 shadow-sm"><div class="card-body"><h4 class="card-title">Card Title</h4><p>Card body text</p><div class="card-actions"><button class="btn btn-primary btn-sm">Action</button></div></div></div>
			<div class="card bg-base-100 w-64 shadow-sm card-border"><figure><img src="/images/avatars/1.png" alt=""/></figure><div class="card-body"><h4 class="card-title">With Image</h4><p>Image on top</p></div></div>
		</div>
	case "countdown":
		<div class="flex gap-5 text-2xl font-mono">
			<div><span class="countdown"><span style="--value:59"></span></span>d</div>
			<div><span class="countdown"><span style="--value:23"></span></span>h</div>
			<div><span class="countdown"><span style="--value:59"></span></span>m</div>
			<div><span class="countdown"><span style="--value:45"></span></span>s</div>
		</div>
	case "divider":
		<div class="flex flex-col w-full">
			<div class="divider">OR</div>
			<div class="flex w-full"><div class="divider divider-primary">Primary</div></div>
			<div class="flex w-full"><div class="divider divider-secondary">Secondary</div></div>
		</div>
	case "drawer":
		<div class="drawer"><input id="drawerx" type="checkbox" class="drawer-toggle"/><div class="drawer-content"><label for="drawerx" class="btn btn-primary">Open</label></div><div class="drawer-side"><label for="drawerx" class="drawer-overlay"></label><ul class="menu bg-base-200 min-h-full w-80 p-4"><li><a>Item 1</a></li><li><a>Item 2</a></li></ul></div></div>
	case "dropdown":
		<div class="flex gap-2">
			<div class="dropdown"><div tabindex="0" class="btn">Click</div><ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box w-52 p-2 shadow"><li><a>A</a></li><li><a>B</a></li></ul></div>
			<div class="dropdown dropdown-hover"><div tabindex="0" class="btn">Hover</div><ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box w-52 p-2 shadow"><li><a>A</a></li><li><a>B</a></li></ul></div>
		</div>
	case "indicator":
		<div class="flex gap-6">
			<div class="indicator"><span class="indicator-item badge badge-primary">new</span><div class="bg-base-300 grid w-16 h-16 place-items-center rounded-box">div</div></div>
			<div class="indicator"><span class="indicator-item badge badge-secondary">99+</span><div class="bg-base-300 grid w-16 h-16 place-items-center rounded-box">div</div></div>
			<div class="indicator"><span class="indicator-item indicator-middle badge badge-success"></span><div class="bg-base-300 grid w-16 h-16 place-items-center rounded-box">div</div></div>
		</div>
	case "join":
		<div class="space-y-2"><div class="join"><button class="btn join-item">1</button><button class="btn join-item btn-active">2</button><button class="btn join-item">3</button></div></div>
	case "kbd":
		<div class="flex gap-2"><kbd class="kbd kbd-sm">⌘</kbd>+<kbd class="kbd kbd-sm">K</kbd></div>
	case "link":
		<div class="flex gap-4"><a class="link">Default</a><a class="link link-primary">Primary</a><a class="link link-secondary">Secondary</a><a class="link link-accent">Accent</a><a class="link link-hover">Hover</a></div>
	case "loading":
		<div class="flex flex-wrap gap-4">
			<span class="loading loading-spinner text-primary"></span><span class="loading loading-spinner text-secondary"></span>
			<span class="loading loading-dots loading-lg"></span><span class="loading loading-ring loading-lg"></span>
			<span class="loading loading-ball loading-lg"></span><span class="loading loading-bars loading-lg"></span>
			<span class="loading loading-infinity loading-lg"></span>
		</div>
	case "menu":
		<ul class="menu bg-base-200 rounded-box w-56"><li class="menu-title">Category</li><li><a>Item 1</a></li><li><a class="active">Active</a></li><li><a>Item 3</a></li><li class="menu-title">More</li><li><details open><summary>Sub</summary><ul><li><a>A</a></li><li><a>B</a></li></ul></details></li></ul>
	case "modal":
		<div><button class="btn" onclick="mod1.showModal()">Open</button></div>
		<dialog id="mod1" class="modal"><div class="modal-box"><h3 class="text-lg font-bold">Modal</h3><p class="py-4">ESC or click outside</p><div class="modal-action"><form method="dialog"><button class="btn">Close</button></form></div></div></dialog>
	case "pagination":
		<div class="join"><button class="join-item btn btn-sm">«</button><button class="join-item btn btn-sm">1</button><button class="join-item btn btn-sm btn-active">2</button><button class="join-item btn btn-sm">3</button><button class="join-item btn btn-sm">»</button></div>
	case "progress":
		<div class="space-y-3 w-full max-w-xs">
			<progress class="progress progress-primary w-full" value="70" max="100"></progress>
			<progress class="progress progress-secondary w-full" value="50" max="100"></progress>
			<progress class="progress progress-accent w-full" value="80" max="100"></progress>
			<progress class="progress progress-success w-full" value="40" max="100"></progress>
			<progress class="progress progress-warning w-full" value="60" max="100"></progress>
			<progress class="progress progress-error w-full" value="20" max="100"></progress>
		</div>
	case "radial-progress":
		<div class="flex gap-4"><div class="radial-progress text-primary" style="--value:70">70%</div><div class="radial-progress text-secondary" style="--value:50">50%</div><div class="radial-progress text-accent" style="--value:80">80%</div></div>
	case "skeleton":
		<div class="flex flex-col gap-3 w-64"><div class="skeleton h-4 w-full"></div><div class="skeleton h-4 w-3/4"></div><div class="skeleton h-32 w-full"></div></div>
	case "stack":
		<div class="stack"><div class="card bg-primary text-primary-content w-36 h-36"><div class="card-body">1</div></div><div class="card bg-secondary text-secondary-content w-36 h-36"><div class="card-body">2</div></div><div class="card bg-accent text-accent-content w-36 h-36"><div class="card-body">3</div></div></div>
	case "stat":
		<div class="grid grid-cols-2 gap-4">
			<div class="card bg-base-100 shadow-sm"><div class="card-body gap-2"><p class="text-sm text-base-content/60">Revenue</p><p class="text-2xl font-semibold">$12,345</p><div class="badge badge-success badge-soft badge-xs">+10.8%</div></div></div>
			<div class="card bg-base-100 shadow-sm"><div class="card-body gap-2"><p class="text-sm text-base-content/60">Users</p><p class="text-2xl font-semibold">4,562</p><div class="badge badge-success badge-soft badge-xs">+8.2%</div></div></div>
		</div>
	case "step", "steps":
		<ul class="steps w-full"><li class="step step-primary">Register</li><li class="step step-primary">Choose</li><li class="step">Purchase</li><li class="step">Receive</li></ul>
	case "swap":
		<label class="swap"><input type="checkbox"/><div class="swap-on">ON</div><div class="swap-off">OFF</div></label>
	case "tab", "tabs":
		<div class="space-y-3">
			<div role="tablist" class="tabs tabs-lift"><input type="radio" name="t1" class="tab" aria-label="Lift 1" checked/><input type="radio" name="t1" class="tab" aria-label="Lift 2"/></div>
			<div role="tablist" class="tabs tabs-box"><input type="radio" name="t2" class="tab" aria-label="Box 1" checked/><input type="radio" name="t2" class="tab" aria-label="Box 2"/></div>
			<div role="tablist" class="tabs tabs-border"><input type="radio" name="t3" class="tab" aria-label="Border 1" checked/><input type="radio" name="t3" class="tab" aria-label="Border 2"/></div>
		</div>
	case "table":
		<div class="overflow-x-auto"><table class="table"><thead><tr><th>Name</th><th>Role</th><th>Status</th></tr></thead><tbody><tr><td>Alice</td><td>Admin</td><td><span class="badge badge-success badge-xs">Active</span></td></tr><tr><td>Bob</td><td>Editor</td><td><span class="badge badge-warning badge-xs">Pending</span></td></tr></tbody></table></div>
	case "timeline":
		<ul class="timeline timeline-vertical"><li><div class="timeline-start">1984</div><div class="timeline-middle"><span class="iconify lucide--check size-4"></span></div><div class="timeline-end timeline-box">First Mac</div><hr/></li><li><hr/><div class="timeline-start">2007</div><div class="timeline-middle"><span class="iconify lucide--check size-4"></span></div><div class="timeline-end timeline-box">iPhone</div></li></ul>
	case "toast":
		<div class="space-y-2"><div class="alert alert-success"><span>Operation successful!</span></div><div class="alert alert-error"><span>Something went wrong</span></div></div>
	case "tooltip":
		<div class="flex gap-4 pt-4">
			<div class="tooltip" data-tip="Top"><button class="btn">Top</button></div>
			<div class="tooltip tooltip-bottom" data-tip="Bottom"><button class="btn">Bot</button></div>
			<div class="tooltip tooltip-left" data-tip="Left"><button class="btn">L</button></div>
			<div class="tooltip tooltip-right" data-tip="Right"><button class="btn">R</button></div>
		</div>
	default:
		<div class="text-center w-full py-8 text-base-content/40">Component demo: { name }</div>
	}
}

templ renderFormDemo(name string) {
	switch name {
	case "checkbox":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4 flex flex-wrap gap-3"><input type="checkbox" class="checkbox" aria-label="Checkbox"/><input type="checkbox" class="checkbox" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox" disabled aria-label="Checkbox"/><input type="checkbox" class="checkbox" checked disabled aria-label="Checkbox"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div><div class="mt-4 flex flex-wrap gap-3"><input type="checkbox" class="checkbox checkbox-primary" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-secondary" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-accent" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-success" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-info" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-warning" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-error" checked aria-label="Checkbox"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-wrap items-center gap-3"><input type="checkbox" class="checkbox checkbox-xl" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-lg" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-sm" checked aria-label="Checkbox"/><input type="checkbox" class="checkbox checkbox-xs" checked aria-label="Checkbox"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Form Control</div><form class="form-control bg-base-200 rounded-box mt-4 w-64 p-3 px-4"><label class="label flex"><span class="label-text grow cursor-pointer">Remember me</span><input type="checkbox" class="checkbox" aria-label="Checkbox example"/></label></form></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Indeterminate</div><div class="mt-4"><div class="flex flex-wrap gap-3"><input type="checkbox" class="checkbox" id="indeterminate-checkbox" aria-label="Checkbox example"/><input type="checkbox" class="checkbox" disabled id="indeterminate-checkbox-disabled" aria-label="Checkbox example"/></div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Custom</div><div class="mt-4 flex flex-wrap gap-3"><input type="checkbox" class="checkbox border-red-300 bg-red-100 text-red-600 checked:border-red-600 checked:bg-red-200" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox border-blue-300 bg-blue-100 text-blue-600 checked:border-blue-600 checked:bg-blue-200" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox border-blue-300 bg-linear-to-br from-blue-500 to-purple-500 [background-size:inherit] text-white checked:border-blue-500" checked aria-label="Checkbox example"/></div></div></div>
		</div>
	case "input":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4 flex flex-col gap-3"><input type="text" class="input" placeholder="Type here" aria-label="Input"/><input type="text" class="input" value="You can't touch this" aria-label="Input"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Disabled</div><div class="mt-4 flex flex-col gap-3"><input type="text" class="input" disabled placeholder="Can't touch this" aria-label="Input"/><input type="text" class="input" disabled value="You can't touch this" aria-label="Input"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Ghost</div><div class="mt-4 flex flex-col gap-3"><input type="text" class="input input-ghost" placeholder="Touch to write" aria-label="Input"/><input type="text" class="input" disabled aria-label="Input" value={"I'm ghost, you can't touch me 👻"}/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Fieldset</div><div class="mt-4 flex flex-col gap-3"><fieldset class="fieldset"><legend class="fieldset-legend">What is your name?</legend><input type="text" class="input" placeholder="Shoaib Rain" aria-label="Input"/><p class="fieldset-label">* Required</p></fieldset></div></div></div>
			<div class="space-y-5">
				<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Label inside</div><div class="mt-4 flex flex-col gap-3"><label class="input"><span class="iconify lucide--search text-base-content/60 size-5"></span><input class="grow" placeholder="Search" type="search" aria-label="Input"/><kbd class="kbd kbd-sm">⌘</kbd><kbd class="kbd kbd-sm">K</kbd></label><label class="input"><span class="iconify lucide--file text-base-content/60 size-5"></span><input class="grow" placeholder="index.php" type="text" aria-label="Input"/></label><label class="input">Path<input class="grow" placeholder="src/app/" type="text" aria-label="Input"/><span class="badge badge-ghost badge-sm">.tsx</span></label></div></div></div>
				<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-col gap-3"><input type="text" class="input input-xs" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-sm" placeholder="Type here" aria-label="Input"/><input type="text" class="input" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-lg" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-xl" placeholder="Type here" aria-label="Input"/></div></div></div>
			</div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div><div class="mt-4 flex flex-col gap-3"><input type="text" class="input input-primary" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-secondary" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-accent" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-success" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-info" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-warning" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-error" placeholder="Type here" aria-label="Input"/><input type="text" class="input input-neutral" placeholder="Type here" aria-label="Input"/></div></div></div>
		</div>
	case "toggle":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4 flex flex-wrap gap-4"><input type="checkbox" class="toggle" aria-label="Checkbox"/><input type="checkbox" class="toggle" checked aria-label="Checkbox"/><input type="checkbox" class="toggle" disabled aria-label="Checkbox"/><input type="checkbox" class="toggle" checked disabled aria-label="Checkbox"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div><div class="mt-4 flex flex-wrap gap-4"><input type="checkbox" class="toggle toggle-primary" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-secondary" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-accent" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-success" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-info" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-warning" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-error" checked aria-label="Checkbox"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-wrap items-center gap-4"><input type="checkbox" class="toggle toggle-xs" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-sm" checked aria-label="Checkbox"/><input type="checkbox" class="toggle" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-lg" checked aria-label="Checkbox"/><input type="checkbox" class="toggle toggle-xl" checked aria-label="Checkbox"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Icon</div><div class="mt-4 flex flex-wrap items-center gap-4"><label class="toggle text-base-content toggle-xl"><input type="checkbox" checked aria-label="Checkbox"/><span class="iconify lucide--x m-1 flex size-3.5 items-center"></span><span class="iconify lucide--check m-1 flex size-3.5 items-center"></span></label><label class="toggle text-base-content toggle-xl"><input type="checkbox" checked aria-label="Checkbox"/><span class="iconify lucide--sun m-1 flex size-3.5 items-center"></span><span class="iconify lucide--moon m-1 flex size-3.5 items-center"></span></label></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Custom</div><div class="mt-4 flex flex-wrap items-center gap-4"><input type="checkbox" class="toggle border-orange-300 bg-orange-200 text-orange-600 checked:border-orange-600 checked:bg-orange-600 checked:text-white" checked aria-label="Checkbox"/><input type="checkbox" class="toggle border-blue-300 bg-linear-to-br from-blue-300 to-purple-300 text-blue-800 checked:border-blue-500 checked:from-blue-500 checked:to-purple-500 checked:text-white" checked aria-label="Checkbox"/></div></div></div>
		</div>
	case "select":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4 flex flex-col gap-3"><select class="select" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option selected>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Disabled</div><div class="mt-4 flex flex-col gap-3"><select class="select" disabled aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select" disabled aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option selected>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Ghost</div><div class="mt-4 flex flex-col gap-3"><select class="select select-ghost" aria-label="Select"><option disabled selected>Select any ghost</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-ghost" disabled aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option selected>{"Can't touch me, I'm already selected"}</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Fieldset</div><div class="mt-4 flex flex-col gap-3"><fieldset class="fieldset"><legend class="fieldset-legend">Need any favourite simpson?</legend><select class="select" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><p class="fieldset-label">* Optional</p></fieldset></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div><div class="mt-4 flex flex-col gap-3"><select class="select select-primary" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-secondary" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-accent" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-success" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-info" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-warning" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-error" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-neutral" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-col gap-3"><select class="select select-xs" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-sm" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-lg" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select><select class="select select-xl" aria-label="Select"><option disabled selected>Pick your favorite Simpson</option><option>Homer</option><option>Marge</option><option>Bart</option><option>Lisa</option><option>Maggie</option></select></div></div></div>
		</div>
	case "fieldset": <fieldset class="fieldset bg-base-200 border border-base-300 p-4 rounded-box w-full max-w-md"><legend class="fieldset-legend">Settings</legend><label class="fieldset-label">Name</label><input type="text" class="input w-full" placeholder="Name"/></fieldset>
	case "file-input": <div class="space-y-2"><input type="file" class="file-input file-input-bordered w-full max-w-xs"/><input type="file" class="file-input file-input-primary w-full max-w-xs"/></div>
	case "label": <label class="form-control w-full max-w-xs"><div class="label"><span class="label-text">Name</span><span class="label-text-alt">Required</span></div><input type="text" class="input input-bordered w-full"/></label>
	case "radio": <div class="flex gap-4"><label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="rd" class="radio" checked/><span>A</span></label><label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="rd" class="radio"/><span>B</span></label></div>
	case "range": <div class="space-y-2 w-full max-w-xs"><input type="range" min="0" max="100" value="40" class="range range-primary w-full"/><input type="range" min="0" max="100" value="60" class="range range-secondary w-full"/></div>
	case "rating": <div class="rating"><input type="radio" name="rt" class="mask mask-star-2 bg-orange-400"/><input type="radio" name="rt" class="mask mask-star-2 bg-orange-400" checked/><input type="radio" name="rt" class="mask mask-star-2 bg-orange-400"/></div>
	case "textarea": <textarea class="textarea textarea-bordered w-full max-w-md" rows="4" placeholder="Write here..."></textarea>
	case "validator": <div class="text-center py-4"><p class="text-sm">Use <code class="badge">validator</code> class with <code class="badge">validator-hint</code> { "for" } HTML5 validation.</p></div>
	default: <div class="text-center py-8 text-base-content/40">Form demo: { name }</div>
	}
}
