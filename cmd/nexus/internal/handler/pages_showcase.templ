package handler

import (
	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

templ UIComponentsPage() {
	<div { devmode.Attrs(ctx, "nexus/UIComponents")... }>
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-medium">UI Components</h3>
			<div class="breadcrumbs hidden p-0 text-sm sm:inline">
				<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>UI Showcase</li><li class="opacity-80">Components</li></ul>
			</div>
		</div>
		<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
			@compCard("Accordion", "Collapsible sections", "ui.Accordion")
			@compCard("Alert", "Status messages", "ui.Alert")
			@compCard("Avatar", "User avatars with initials", "ui.Avatar")
			@compCard("Badge", "Labels and counts", "ui.Badge")
			@compCard("Button", "Button variants with icons", "ui.Button")
			@compCard("Card", "Content containers", "ui.Card")
			@compCard("Chart", "ApexCharts integration", "ui.Chart")
			@compCard("ChatBubble", "Chat message bubbles", "ui.ChatBubble")
			@compCard("ChatInput", "Chat input bar", "ui.ChatInput")
			@compCard("Countdown", "Animated timer", "ui.Countdown")
			@compCard("Divider", "Content separators", "ui.Divider")
			@compCard("Drawer", "Slide-in panels", "ui.Drawer")
			@compCard("Dropdown", "Dropdown menus", "ui.Dropdown")
			@compCard("Empty", "Empty state placeholder", "ui.Empty")
			@compCard("Fieldset", "Form field groups", "ui.Fieldset")
			@compCard("Hero", "Hero section with CTA", "ui.Hero")
			@compCard("Indicator", "Badge overlays", "ui.Indicator")
			@compCard("Join", "Fused element groups", "ui.Join")
			@compCard("Kbd", "Keyboard shortcuts", "ui.Kbd")
			@compCard("List", "Vertical list items", "ui.List")
			@compCard("Loader", "Loading spinners", "ui.Loader")
			@compCard("Mask", "Shape masks", "ui.Mask")
			@compCard("Dialog", "Native dialog shell", "ui.Dialog")
			@compCard("Pagination", "Page navigation", "ui.Pagination")
			@compCard("PersonCell", "Identity cell", "ui.PersonCell")
			@compCard("Progress", "Progress bars", "ui.Progress")
			@compCard("RadialProgress", "Circular progress", "ui.RadialProgress")
			@compCard("Rating", "Star/heart rating", "form.Rating")
			@compCard("Skeleton", "Loading placeholders", "ui.Skeleton")
			@compCard("Stack", "Overlapping cards", "ui.Stack")
			@compCard("StatCard", "KPI stat widgets", "ui.StatCard")
			@compCard("Steps", "Step indicators", "ui.Steps")
			@compCard("Swap", "Toggle between states", "ui.Swap")
			@compCard("Tabs", "Tabbed navigation", "ui.Tabs")
			@compCard("Tag", "Removable chips", "ui.Tag")
			@compCard("Testimonial", "Testimonial cards", "ui.TestimonialCard")
			@compCard("ThemeSwitcher", "Dark/light toggle", "ui.ThemeSwitcher")
			@compCard("Timeline", "Vertical timeline", "ui.Timeline")
			@compCard("Toast", "Toast notifications", "ui.Toast")
			@compCard("Tooltip", "Hover tooltips", "ui.Tooltip")
			@compCard("RangeInput", "Range slider", "form.RangeInput")
			@compCard("Checkbox", "Checkbox inputs", "form.Checkbox")
			@compCard("Toggle", "Toggle switches", "form.Toggle")
			@compCard("FileUpload", "File upload area", "form.FileUpload")
			@compCard("PasswordField", "Password input", "form.PasswordField")
			@compCard("Calendar", "Calendar component", "form.CalendarWrapper")
			@compCard("WizardStepper", "Multi-step wizard", "form.WizardStepper")
			@compCard("OTPInput", "OTP digit input", "form.OTPInput")
			@compCard("RichTextEditor", "Text editor", "form.RichTextEditor")
			@compCard("PromptBar", "AI prompt input", "form.PromptBar")
		</div>
	</div>
}

templ compCard(title, desc, importPath string) {
	<div class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-line">
		<div class="card-body p-4">
			<h4 class="font-semibold text-sm">{ title }</h4>
			<p class="text-xs text-base-content/60 mt-0.5">{ desc }</p>
			<div class="badge badge-ghost badge-xs mt-2 font-mono">{ importPath }</div>
		</div>
	</div>
}

templ UIFormsPage() {
	<div { devmode.Attrs(ctx, "nexus/UIForms")... }>
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-medium">Form Components</h3>
			<div class="breadcrumbs hidden p-0 text-sm sm:inline">
				<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>UI Showcase</li><li class="opacity-80">Forms</li></ul>
			</div>
		</div>
		<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
			@compCard("TextInput", "Text input field with label", "form.TextInput")
			@compCard("TextareaInput", "Multi-line text input", "form.TextareaInput")
			@compCard("SelectInput", "Dropdown select", "form.SelectInput")
			@compCard("EnhancedSelect", "Multi-select with search", "form.EnhancedSelect")
			@compCard("SearchInput", "Search field with icon", "form.SearchInput")
			@compCard("Checkbox", "Checkbox input", "form.Checkbox / FormCheckbox")
			@compCard("Toggle", "Toggle s/w", "form.Toggle / FormToggle")
			@compCard("RadioGroup", "Radio button group", "form.RadioGroup")
			@compCard("RangeInput", "Range slider", "form.RangeInput")
			@compCard("Rating", "Star/heart rating", "form.Rating")
			@compCard("FileInput", "File input field", "form.FileInput")
			@compCard("FileUpload", "Drag-drop upload area", "form.FileUpload")
			@compCard("PasswordField", "Password with toggle", "form.PasswordField")
			@compCard("PasswordMeter", "Password strength meter", "form.PasswordMeter")
			@compCard("FormField", "Unified form field", "form.FormField")
			@compCard("FormControl", "Label + input wrapper", "form.FormControl")
			@compCard("FormValidation", "Form with validation", "form.FormValidation")
			@compCard("OTPInput", "OTP digit input", "form.OTPInput")
			@compCard("ColorInput", "Color picker", "form.ColorInput")
			@compCard("DateInput", "Native date input", "form.DateInput")
			@compCard("DatePicker", "Date picker with calendar", "form.DatePicker")
			@compCard("CalendarWrapper", "Calendar display", "form.CalendarWrapper")
			@compCard("RichTextEditor", "Rich text editor", "form.RichTextEditor")
			@compCard("WizardStepper", "Multi-step form wizard", "form.WizardStepper")
			@compCard("PromptBar", "AI prompt input", "form.PromptBar")
			@compCard("PromptBarAction", "Prompt with actions", "form.PromptBarAction")
			@compCard("InputSpinner", "Numeric stepper", "form.InputSpinner")
			@compCard("DatalistInput", "Input with suggestions", "form.DatalistInput")
			@compCard("FormActions", "Submit/Cancel row", "form.FormActions")
		</div>
	</div>
}

templ UIChartsPage() {
	<div { devmode.Attrs(ctx, "nexus/UICharts")... }>
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-medium">Chart Components</h3>
			<div class="breadcrumbs hidden p-0 text-sm sm:inline">
				<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>UI Showcase</li><li class="opacity-80">Charts</li></ul>
			</div>
		</div>
		<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
			@compCard("Area Chart", "Filled area visualization", "ui.Chart{Type: ChartArea}")
			@compCard("Bar Chart", "Vertical/horizontal bars", "ui.Chart{Type: ChartBar}")
			@compCard("Column Chart", "Grouped/stacked columns", "ui.Chart{Type: ChartColumn}")
			@compCard("Line Chart", "Stepline/smooth lines", "ui.Chart{Type: ChartLine}")
			@compCard("Pie Chart", "Circular segments", "ui.Chart{Type: ChartPie}")
			@compCard("Donut Chart", "Hollow pie chart", "ui.Chart{Type: ChartDonut}")
			@compCard("Radial Chart", "Semi-circle gauge", "ui.Chart{Type: ChartRadial}")
			@compCard("Heatmap", "Color-intensity grid", "ui.Chart{Type: ChartHeatmap}")
			@compCard("Range Bar", "Dumbbell charts", "ui.Chart{Type: ChartRangeBar}")
			@compCard("Stacked", "Stacked bars/columns", "ui.Chart{Stacked: true}")
			@compCard("Sparkline", "Inline mini chart", "ui.Chart{Sparkline: true}")
			@compCard("Forecast", "Data prediction", "ui.Chart{ForecastCount: N}")
			@compCard("Annotations", "Reference lines/labels", "ui.Chart{Annotations: [...]}")
			@compCard("Gradient Fill", "Color gradient fills", "ui.Chart{FillType: gradient}")
			@compCard("Synced Charts", "Grouped tooltips", "ui.Chart{GroupID: ...}")
		</div>
	</div>
}

templ UIComponentDetailPage(name string) {
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/UIComponentDetail")... }>
		<h3 class="text-lg font-medium">{ capFirst(name) }</h3>
		<div class="breadcrumbs hidden p-0 text-sm sm:inline">
			<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li>Components</li><li class="opacity-80">{ capFirst(name) }</li></ul>
		</div>
	</div>
	@renderComponentDemo(name)
}

templ UIFormDetailPage(name string) {
	{{ title := capFirst(name) }}
	if name == "select" || name == "file-input" {
		{{ title = "File Input" }}
	}
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/UIFormDetail")... }>
		<h3 class="text-lg font-medium">{ title }</h3>
		<div class="breadcrumbs hidden p-0 text-sm sm:inline">
			<ul><li><a href="#">Nexus</a></li><li>Forms</li><li class="opacity-80">{ title }</li></ul>
		</div>
	</div>
	@renderFormDemo(name)
}


templ UIChartDetailPage(name string) {
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nexus/UIChartDetail")... }>
		<h3 class="text-lg font-medium">{ capFirst(name) } Chart</h3>
		<div class="breadcrumbs hidden p-0 text-sm sm:inline">
			<ul><li><a href="/dashboards/ecommerce">Nexus</a></li><li><a href="/ui/charts">Charts</a></li><li class="opacity-80">{ capFirst(name) }</li></ul>
		</div>
	</div>
	<div class="mt-6">
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h4 class="text-base font-semibold">{ name } Chart</h4>
				<p class="text-sm text-base-content/60 mt-1">go-daisy chart type.</p>
				<div class="divider"></div>
				<div class="bg-base-200 rounded-box p-4 flex items-center justify-center" style="min-height: 300px">
					<span class="text-base-content/40">Chart demo: { name }</span>
				</div>
			</div>
		</div>
	</div>
}


templ renderComponentDemo(name string) {
	switch name {
	case "accordion":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default (Single)</div>
				<div class="mt-4 space-y-1">
					<div class="bg-base-200 rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-default" checked/><div class="collapse-title text-lg font-medium">Accordion #1</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="bg-base-200 rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-default"/><div class="collapse-title text-lg font-medium">Accordion #2</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="bg-base-200 rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-default"/><div class="collapse-title text-lg font-medium">Accordion #3</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
				</div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Multiple</div>
				<div class="mt-4 space-y-1">
					<div class="bg-base-200 rounded-box collapse"><input aria-label="Collapse trigger" type="checkbox" name="accordion-multiple" checked/><div class="collapse-title text-lg font-medium">Accordion #1</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="bg-base-200 rounded-box collapse"><input aria-label="Collapse trigger" type="checkbox" name="accordion-multiple"/><div class="collapse-title text-lg font-medium">Accordion #2</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="bg-base-200 rounded-box collapse"><input aria-label="Collapse trigger" type="checkbox" name="accordion-multiple"/><div class="collapse-title text-lg font-medium">Accordion #3</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
				</div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Icon: Arrow</div>
				<div class="mt-4 space-y-1">
					<div class="bg-base-200 collapse-arrow rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-arrow" checked/><div class="collapse-title text-lg font-medium">Accordion #1</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="bg-base-200 collapse-arrow rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-arrow"/><div class="collapse-title text-lg font-medium">Accordion #2</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="bg-base-200 collapse-arrow rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-arrow"/><div class="collapse-title text-lg font-medium">Accordion #3</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
				</div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Icon: Plus/Minus</div>
				<div class="mt-4 space-y-1">
					<div class="bg-base-200 collapse-plus rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-plus" checked/><div class="collapse-title text-lg font-medium">Accordion #1</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="bg-base-200 collapse-plus rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-plus"/><div class="collapse-title text-lg font-medium">Accordion #2</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="bg-base-200 collapse-plus rounded-box collapse"><input aria-label="Collapse trigger" type="radio" name="accordion-plus"/><div class="collapse-title text-lg font-medium">Accordion #3</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
				</div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Join</div>
				<div class="join join-vertical mt-4">
					<div class="join-item border-base-300 collapse border"><input aria-label="Collapse trigger" type="radio" name="accordion-join" checked/><div class="collapse-title text-lg font-medium">Accordion #1</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="join-item border-base-300 collapse border"><input aria-label="Collapse trigger" type="radio" name="accordion-join"/><div class="collapse-title text-lg font-medium">Accordion #2</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
					<div class="join-item border-base-300 collapse border"><input aria-label="Collapse trigger" type="radio" name="accordion-join"/><div class="collapse-title text-lg font-medium">Accordion #3</div><div class="collapse-content">Here are some hidden content, which is now public</div></div>
				</div>
			</div></div>
		</div>
	case "alert":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div><div class="mt-4"><div class="alert" role="alert"><span class="iconify lucide--info text-info size-5"></span><span>12 unread messages. Tap to see.</span></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Button</div><div class="mt-4"><div class="alert" role="alert"><span class="iconify lucide--cookie text-info size-5"></span><span>12 unread messages. Tap to see.</span><div class="space-x-2"><button class="btn btn-sm">Deny</button><button class="btn btn-sm btn-primary">Accept</button></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Description</div><div class="mt-4"><div class="alert" role="alert"><span class="iconify lucide--message-square-dashed size-5"></span><div><h3 class="font-medium">New message!</h3><div class="text-base-content/70 text-xs">You have 1 unread message</div></div><button class="btn btn-sm">See</button></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Confirmation</div><div class="mt-4"><div class="alert" role="alert"><span class="iconify lucide--trash-2 text-error size-5"></span><div><h3 class="font-bold">12.7 MB Saved</h3><div class="text-xs">Some file removed</div></div><div class="space-x-2"><button class="btn btn-sm">Dismiss</button><button class="btn btn-sm btn-primary">Restore</button></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Solid</div><div class="mt-4 space-y-3">
				@ui.Alert(ui.AlertProps{Type: ui.AlertSuccess, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertInfo, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertWarning, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertError, Icon: "lucide--info", Message: "New software update available."})
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Soft</div><div class="mt-4 space-y-3">
				@ui.Alert(ui.AlertProps{Type: ui.AlertSuccess, Style: ui.AlertStyleSoft, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertInfo, Style: ui.AlertStyleSoft, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertWarning, Style: ui.AlertStyleSoft, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertError, Style: ui.AlertStyleSoft, Icon: "lucide--info", Message: "New software update available."})
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Outline</div><div class="mt-4 space-y-3">
				@ui.Alert(ui.AlertProps{Type: ui.AlertSuccess, Style: ui.AlertStyleOutline, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertInfo, Style: ui.AlertStyleOutline, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertWarning, Style: ui.AlertStyleOutline, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertError, Style: ui.AlertStyleOutline, Icon: "lucide--info", Message: "New software update available."})
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Dashed</div><div class="mt-4 space-y-3">
				@ui.Alert(ui.AlertProps{Type: ui.AlertSuccess, Style: ui.AlertStyleDash, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertInfo, Style: ui.AlertStyleDash, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertWarning, Style: ui.AlertStyleDash, Icon: "lucide--info", Message: "New software update available."})
				@ui.Alert(ui.AlertProps{Type: ui.AlertError, Style: ui.AlertStyleDash, Icon: "lucide--info", Message: "New software update available."})
			</div></div></div>
		</div>
	case "avatar":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div><div class="mt-4"><div class="avatar"><div class="bg-base-200 rounded-box w-20"><img alt="Avatar" src="/images/avatars/1.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Rounded</div><div class="mt-4 flex flex-wrap items-center gap-4"><div class="avatar"><div class="bg-base-200 w-20 rounded-xl"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar"><div class="bg-base-200 w-20 rounded-full"><img alt="Avatar" src="/images/avatars/2.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-wrap items-center gap-4"><div class="avatar"><div class="bg-base-200 rounded-box w-24"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-base-200 rounded-box w-20"><img alt="Avatar" src="/images/avatars/3.png"/></div></div><div class="avatar"><div class="bg-base-200 rounded-box w-16"><img alt="Avatar" src="/images/avatars/2.png"/></div></div><div class="avatar"><div class="bg-base-200 rounded-box w-12"><img alt="Avatar" src="/images/avatars/1.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Mask</div><div class="mt-4 flex flex-wrap items-center gap-4"><div class="avatar"><div class="bg-base-200 mask mask-squircle w-20"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-base-200 mask mask-hexagon w-20"><img alt="Avatar" src="/images/avatars/5.png"/></div></div><div class="avatar"><div class="bg-base-200 mask mask-hexagon-2 w-20"><img alt="Avatar" src="/images/avatars/7.png"/></div></div><div class="avatar"><div class="bg-base-200 mask mask-diamond w-20"><img alt="Avatar" src="/images/avatars/6.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Group</div><div class="mt-4"><div class="avatar-group -space-x-5"><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/5.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/7.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/8.png"/></div></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Counter</div><div class="mt-4"><div class="avatar-group -space-x-5"><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/5.png"/></div></div><div class="avatar"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/7.png"/></div></div><div class="avatar avatar-placeholder"><div class="bg-base-300 w-12 rounded-full">+99</div></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Ring</div><div class="mt-4"><div class="flex flex-wrap items-center gap-4"><div class="avatar"><div class="bg-primary/25 ring-primary ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar"><div class="bg-secondary/25 ring-secondary ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/2.png"/></div></div><div class="avatar"><div class="bg-accent/25 ring-accent ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/3.png"/></div></div><div class="avatar"><div class="bg-success/25 ring-success ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/4.png"/></div></div><div class="avatar"><div class="bg-info/25 ring-info ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/5.png"/></div></div><div class="avatar"><div class="bg-warning/25 ring-warning ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/6.png"/></div></div><div class="avatar"><div class="bg-error/25 ring-error ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/7.png"/></div></div><div class="avatar"><div class="bg-neutral/25 ring-neutral ring-offset-base-100 w-12 rounded-full ring ring-offset-2"><img alt="Avatar" src="/images/avatars/8.png"/></div></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Presence</div><div class="mt-4 flex flex-wrap items-center gap-4"><div class="avatar avatar-online"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/1.png"/></div></div><div class="avatar avatar-offline"><div class="bg-base-200 w-12 rounded-full"><img alt="Avatar" src="/images/avatars/2.png"/></div></div></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Placeholder</div><div class="mt-4"><div class="flex flex-wrap items-center gap-4"><div class="avatar avatar-placeholder"><div class="bg-primary text-primary-content ring-primary ring-offset-base-100 w-12 rounded-full ring ring-offset-2">N</div></div><div class="avatar avatar-placeholder"><div class="bg-secondary text-secondary-content ring-secondary ring-offset-base-100 w-12 rounded-full ring ring-offset-2">E</div></div><div class="avatar avatar-placeholder"><div class="bg-success text-success-content ring-success ring-offset-base-100 w-12 rounded-full ring ring-offset-2">X</div></div><div class="avatar avatar-placeholder"><div class="bg-warning text-warning-content ring-warning ring-offset-base-100 w-12 rounded-full ring ring-offset-2">U</div></div><div class="avatar avatar-placeholder"><div class="bg-error text-error-content ring-error ring-offset-base-100 w-12 rounded-full ring ring-offset-2">S</div></div></div></div></div></div>
		</div>
	case "badge":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge">Badge</div><div class="badge badge-ghost">Ghost</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Empty</div><div class="mt-4 flex flex-wrap items-center gap-3"><div class="badge badge-primary badge-xl"></div><div class="badge badge-primary badge-lg"></div><div class="badge badge-primary badge-md"></div><div class="badge badge-primary badge-sm"></div><div class="badge badge-primary badge-xs"></div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Solid</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-primary">Primary</div><div class="badge badge-secondary">Secondary</div><div class="badge badge-accent">Accent</div><div class="badge badge-success">Success</div><div class="badge badge-info">Info</div><div class="badge badge-warning">Warning</div><div class="badge badge-error">Error</div><div class="badge badge-neutral">Neutral</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Soft</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-soft badge-primary">Primary</div><div class="badge badge-soft badge-secondary">Secondary</div><div class="badge badge-soft badge-accent">Accent</div><div class="badge badge-soft badge-success">Success</div><div class="badge badge-soft badge-info">Info</div><div class="badge badge-soft badge-warning">Warning</div><div class="badge badge-soft badge-error">Error</div><div class="badge badge-soft badge-neutral">Neutral</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Outline</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-outline badge-primary">Primary</div><div class="badge badge-outline badge-secondary">Secondary</div><div class="badge badge-outline badge-accent">Accent</div><div class="badge badge-outline badge-success">Success</div><div class="badge badge-outline badge-info">Info</div><div class="badge badge-outline badge-warning">Warning</div><div class="badge badge-outline badge-error">Error</div><div class="badge badge-outline badge-neutral">Neutral</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Dash</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-dash badge-primary">Primary</div><div class="badge badge-dash badge-secondary">Secondary</div><div class="badge badge-dash badge-accent">Accent</div><div class="badge badge-dash badge-success">Success</div><div class="badge badge-dash badge-info">Info</div><div class="badge badge-dash badge-warning">Warning</div><div class="badge badge-dash badge-error">Error</div><div class="badge badge-dash badge-neutral">Neutral</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Icon</div><div class="mt-4 flex flex-wrap gap-2"><div class="badge badge-success"><span class="iconify lucide--info"></span>Success</div><div class="badge badge-info"><span class="iconify lucide--circle-alert"></span>Info</div><div class="badge badge-warning"><span class="iconify lucide--triangle-alert"></span>Warning</div><div class="badge badge-error"><span class="iconify lucide--ban"></span>Error</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-wrap items-center gap-3"><div class="badge badge-xl">Extra Large</div><div class="badge badge-lg">Large</div><div class="badge badge-md">Medium</div><div class="badge badge-sm">Small</div><div class="badge badge-xs">Extra Small</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Button</div><div class="mt-4 flex flex-wrap items-center gap-3"><button class="btn">Inbox <span class="badge badge-sm">+99</span></button><button class="btn">Inbox <span class="badge badge-primary badge-sm">+99</span></button></div></div></div>
		</div>
	case "breadcrumb":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div><div class="breadcrumbs mt-2 text-sm"><ul><li><a href="#home">Home</a></li><li><a href="#shops">Shops</a></li><li>Add Shop</li></ul></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Icon</div><div class="breadcrumbs mt-2 text-sm"><ul><li><a href="#home"><span class="iconify lucide--home"></span>Home</a></li><li><a href="#shops"><span class="iconify lucide--store"></span>Shops</a></li><li>Add Shop</li></ul></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Dropdown</div><div class="breadcrumbs mt-2 overflow-x-visible text-sm"><ul><li><a href="#home"><span class="iconify lucide--home"></span>Home</a></li><li><details class="dropdown dropdown-center dropdown-bottom"><summary class="btn btn-xs hover:no-undeline mx-1">•••</summary><ul class="menu dropdown-content bg-base-100 rounded-box z-1 w-32 p-2 shadow-sm"><li><a href="#store"><span class="iconify lucide--store"></span>Stores</a></li><li><a href="#users"><span class="iconify lucide--users"></span>Users</a></li></ul></details></li><li>Add Shop</li></ul></div></div></div>
		</div>
	case "button":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div><div class="mt-4">@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary}) { Click me }</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Disabled</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-disabled">Using class</button><button class="btn" disabled>Using attribute</button></div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Solid</div><div class="mt-4 flex flex-wrap gap-3">
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary}) { Primary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary}) { Secondary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonAccent}) { Accent }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSuccess}) { Success }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonInfo}) { Info }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonWarning}) { Warning }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonError}) { Error }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonNeutral}) { Neutral }
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Soft</div><div class="mt-4 flex flex-wrap gap-3">
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Style: ui.ButtonStyleSoft}) { Primary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Style: ui.ButtonStyleSoft}) { Secondary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonAccent, Style: ui.ButtonStyleSoft}) { Accent }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSuccess, Style: ui.ButtonStyleSoft}) { Success }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonInfo, Style: ui.ButtonStyleSoft}) { Info }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonWarning, Style: ui.ButtonStyleSoft}) { Warning }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonError, Style: ui.ButtonStyleSoft}) { Error }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonNeutral, Style: ui.ButtonStyleSoft}) { Neutral }
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Outline</div><div class="mt-4 flex flex-wrap gap-3">
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Style: ui.ButtonStyleOutline}) { Primary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Style: ui.ButtonStyleOutline}) { Secondary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonAccent, Style: ui.ButtonStyleOutline}) { Accent }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSuccess, Style: ui.ButtonStyleOutline}) { Success }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonInfo, Style: ui.ButtonStyleOutline}) { Info }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonWarning, Style: ui.ButtonStyleOutline}) { Warning }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonError, Style: ui.ButtonStyleOutline}) { Error }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonNeutral, Style: ui.ButtonStyleOutline}) { Neutral }
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Dash</div><div class="mt-4 flex flex-wrap gap-3">
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonPrimary, Style: ui.ButtonStyleDash}) { Primary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary, Style: ui.ButtonStyleDash}) { Secondary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonAccent, Style: ui.ButtonStyleDash}) { Accent }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonSuccess, Style: ui.ButtonStyleDash}) { Success }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonInfo, Style: ui.ButtonStyleDash}) { Info }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonWarning, Style: ui.ButtonStyleDash}) { Warning }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonError, Style: ui.ButtonStyleDash}) { Error }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonNeutral, Style: ui.ButtonStyleDash}) { Neutral }
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Ghost &amp; Link</div><div class="mt-4 flex flex-wrap gap-3">
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost}) { Default }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, ExtraClass: "btn-primary"}) { Primary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, ExtraClass: "btn-secondary"}) { Secondary }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, ExtraClass: "btn-accent"}) { Accent }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, ExtraClass: "btn-success"}) { Success }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, ExtraClass: "btn-info"}) { Info }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, ExtraClass: "btn-warning"}) { Warning }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, ExtraClass: "btn-error"}) { Error }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost, ExtraClass: "btn-neutral"}) { Neutral }
				@ui.Button(ui.ButtonProps{Variant: ui.ButtonLink}) { Link }
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Icon</div><div class="mt-4 flex flex-wrap gap-3">
				@ui.Button(ui.ButtonProps{Shape: ui.ButtonShapeSquare, Icon: "lucide--heart", ExtraClass: "gap-2", AriaLabel: "Icon"})
				@ui.Button(ui.ButtonProps{Icon: "lucide--heart", ExtraClass: "gap-2"}) { Like }
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Rounded</div><div class="mt-4 flex flex-wrap gap-3">
				@ui.Button(ui.ButtonProps{Shape: ui.ButtonShapeCircle, Icon: "lucide--heart", ExtraClass: "gap-2", AriaLabel: "Icon"})
				@ui.Button(ui.ButtonProps{Shape: ui.ButtonShapeCircle, Icon: "lucide--settings-2", ExtraClass: "gap-2", AriaLabel: "Icon"})
			</div></div></div>
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Loading</div><div class="mt-4 flex flex-wrap gap-3"><button class="btn btn-square gap-2" aria-label="Icon"><span class="loading loading-spinner size-5"></span></button><button class="btn gap-2"><span class="loading loading-spinner size-5"></span>Loading</button><button class="btn btn-square gap-2" disabled aria-label="Icon"><span class="loading loading-spinner size-5"></span></button><button class="btn gap-2" disabled><span class="loading loading-spinner size-5"></span>Loading</button></div></div></div>
		</div>

	case "card":
		<div class="grid grid-cols-2 gap-4">
			<div class="card bg-base-100 w-64 shadow-sm"><div class="card-body"><h4 class="card-title">Card Title</h4><p>Card body text</p><div class="card-actions"><button class="btn btn-primary btn-sm">Action</button></div></div></div>
			<div class="card bg-base-100 w-64 shadow-sm card-border"><figure><img src="/images/avatars/1.png" alt=""/></figure><div class="card-body"><h4 class="card-title">With Image</h4><p>Image on top</p></div></div>
		</div>
	case "countdown":
		<div class="mt-6">
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
				<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div>
					<div class="mt-4"><span class="countdown"><span class="countdown-timer" style="--value: 59"></span></span></div>
				</div></div>
				<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Clock</div>
					<div class="mt-4 flex flex-wrap items-center gap-2"><span class="countdown"><span style="--value: 10"></span></span><span>:</span><span class="countdown"><span style="--value: 24"></span></span><span>:</span><span class="countdown"><span class="countdown-timer" style="--value: 59"></span></span></div>
				</div></div>
				<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Label</div>
					<div class="mt-4 flex flex-wrap gap-5 text-center">
						<div class="flex flex-col"><span class="countdown text-xl md:text-5xl"><span style="--value: 15"></span></span>Days</div>
						<div class="flex flex-col"><span class="countdown text-xl md:text-5xl"><span style="--value: 10"></span></span>Hours</div>
						<div class="flex flex-col"><span class="countdown text-xl md:text-5xl"><span style="--value: 24"></span></span>Minutes</div>
						<div class="flex flex-col"><span class="countdown text-xl md:text-5xl"><span class="countdown-timer" style="--value: 59"></span></span>Seconds</div>
					</div>
				</div></div>
				<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Boxed</div>
					<div class="mt-4 flex flex-wrap gap-3 text-center md:gap-5">
						<div class="bg-base-200 rounded-box flex flex-col items-center gap-1 p-3 text-sm"><span class="countdown text-xl md:text-3xl"><span style="--value: 15"></span></span>Days</div>
						<div class="bg-base-200 rounded-box flex flex-col items-center gap-1 p-3 text-sm"><span class="countdown text-xl md:text-3xl"><span style="--value: 10"></span></span>Hours</div>
						<div class="bg-base-200 rounded-box flex flex-col items-center gap-1 p-3 text-sm"><span class="countdown text-xl md:text-3xl"><span style="--value: 24"></span></span>Minutes</div>
						<div class="bg-base-200 rounded-box flex flex-col items-center gap-1 p-3 text-sm"><span class="countdown text-xl md:text-3xl"><span class="countdown-timer" style="--value: 59"></span></span>Seconds</div>
					</div>
				</div></div>
			</div>
		</div>
	case "divider":
		<div class="flex flex-col w-full">
			<div class="divider">OR</div>
			<div class="flex w-full"><div class="divider divider-primary">Primary</div></div>
			<div class="flex w-full"><div class="divider divider-secondary">Secondary</div></div>
		</div>
	case "drawer":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div>
				<div class="mt-4"><div class="drawer">
					<input id="demo-drawer" class="drawer-toggle" type="checkbox"/>
					<div class="drawer-content"><label for="demo-drawer" class="btn drawer-button">Open</label></div>
					<div class="drawer-side z-[50]"><label for="demo-drawer" aria-label="close sidebar" class="drawer-overlay"></label><ul class="menu bg-base-100 text-base-content min-h-full w-80 p-4"><li><a>Sidebar Item 1</a></li><li><a>Sidebar Item 2</a></li></ul></div>
				</div></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Right Drawer</div>
				<div class="mt-4"><div class="drawer drawer-end">
					<input id="demo-end-drawer" class="drawer-toggle" type="checkbox"/>
					<div class="drawer-content"><label for="demo-end-drawer" class="btn drawer-button">Open</label></div>
					<div class="drawer-side z-[50]"><label for="demo-end-drawer" aria-label="close sidebar" class="drawer-overlay"></label><ul class="menu bg-base-100 text-base-content min-h-full w-80 p-4"><li><a>Sidebar Item 1</a></li><li><a>Sidebar Item 2</a></li></ul></div>
				</div></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Close Button</div>
				<div class="mt-4"><div class="drawer">
					<input id="demo-drawer-close" class="drawer-toggle" type="checkbox"/>
					<div class="drawer-content"><label for="demo-drawer-close" class="btn drawer-button">Open</label></div>
					<div class="drawer-side z-[50]"><label for="demo-drawer-close" aria-label="close sidebar" class="drawer-overlay"></label><div class="bg-base-100 min-h-full w-80 p-4"><div class="flex items-center justify-between"><p class="text-lg font-medium">Drawer Title</p><label for="demo-drawer-close" class="btn btn-ghost btn-circle drawer-button"><span class="iconify lucide--x"></span></label></div><p class="mt-2">Contents place here</p></div></div>
				</div></div>
			</div></div>
		</div>
	case "dropdown":
		<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
			<div class="bg-base-100 card card-border"><div class="card-body"><div class="card-title">Default</div>
				<div class="mt-4 flex flex-wrap gap-4">
					<div class="dropdown"><div tabindex="0" role="button" class="btn">Click</div><ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-1 w-40 p-2 shadow-sm"><li><a>Item 1</a></li><li><a>Item 2</a></li></ul></div>
					<div class="dropdown dropdown-hover"><div tabindex="0" role="button" class="btn">Hover</div><ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-1 w-40 p-2 shadow-sm"><li><a>Item 1</a></li><li><a>Item 2</a></li></ul></div>
					<details class="dropdown"><summary class="btn">Stick</summary><ul class="menu dropdown-content bg-base-100 rounded-box z-1 w-40 p-2 shadow-sm"><li><a>Item 1</a></li><li><a>Item 2</a></li></ul></details>
