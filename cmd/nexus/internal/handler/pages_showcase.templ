		</div>
	case "rating":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4"><div class="rating"><input type="radio" name="rating-1" class="mask mask-star" aria-label="1 star"/><input type="radio" name="rating-1" class="mask mask-star" checked aria-label="2 star"/><input type="radio" name="rating-1" class="mask mask-star" aria-label="3 star"/><input type="radio" name="rating-1" class="mask mask-star" aria-label="4 star"/><input type="radio" name="rating-1" class="mask mask-star" aria-label="5 star"/></div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div><div class="mt-4"><div class="rating"><input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="1 star"/><input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="2 star"/><input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" checked aria-label="3 star"/><input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="4 star"/><input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" aria-label="5 star"/></div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Hearts</div><div class="mt-4"><div class="rating gap-1"><input type="radio" name="rating-3" class="mask mask-heart bg-red-400" aria-label="1 star"/><input type="radio" name="rating-3" class="mask mask-heart bg-orange-400" aria-label="2 star"/><input type="radio" name="rating-3" class="mask mask-heart bg-yellow-400" checked aria-label="3 star"/><input type="radio" name="rating-3" class="mask mask-heart bg-lime-400" aria-label="4 star"/><input type="radio" name="rating-3" class="mask mask-heart bg-green-400" aria-label="5 star"/></div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Half</div><div class="mt-4"><div class="rating rating-lg rating-half"><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-1 bg-green-500" aria-label="0.5 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-2 bg-green-500" aria-label="1 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-1 bg-green-500" aria-label="1.5 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-2 bg-green-500" aria-label="2 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-1 bg-green-500" checked aria-label="2.5 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-2 bg-green-500" aria-label="3 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-1 bg-green-500" aria-label="3.5 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-2 bg-green-500" aria-label="4 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-1 bg-green-500" aria-label="4.5 star"/><input type="radio" name="rating-11" class="mask mask-star-2 mask-half-2 bg-green-500" aria-label="5 star"/></div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-col items-center gap-3"><div class="rating rating-xs"><input type="radio" name="rating-5" class="mask mask-star-2 bg-orange-400" aria-label="1 star"/><input type="radio" name="rating-5" class="mask mask-star-2 bg-orange-400" checked aria-label="2 star"/><input type="radio" name="rating-5" class="mask mask-star-2 bg-orange-400" aria-label="3 star"/><input type="radio" name="rating-5" class="mask mask-star-2 bg-orange-400" aria-label="4 star"/><input type="radio" name="rating-5" class="mask mask-star-2 bg-orange-400" aria-label="5 star"/></div><div class="rating rating-sm"><input type="radio" name="rating-6" class="mask mask-star-2 bg-orange-400" aria-label="1 star"/><input type="radio" name="rating-6" class="mask mask-star-2 bg-orange-400" checked aria-label="2 star"/><input type="radio" name="rating-6" class="mask mask-star-2 bg-orange-400" aria-label="3 star"/><input type="radio" name="rating-6" class="mask mask-star-2 bg-orange-400" aria-label="4 star"/><input type="radio" name="rating-6" class="mask mask-star-2 bg-orange-400" aria-label="5 star"/></div><div class="rating rating-md"><input type="radio" name="rating-7" class="mask mask-star-2 bg-orange-400" aria-label="1 star"/><input type="radio" name="rating-7" class="mask mask-star-2 bg-orange-400" checked aria-label="2 star"/><input type="radio" name="rating-7" class="mask mask-star-2 bg-orange-400" aria-label="3 star"/><input type="radio" name="rating-7" class="mask mask-star-2 bg-orange-400" aria-label="4 star"/><input type="radio" name="rating-7" class="mask mask-star-2 bg-orange-400" aria-label="5 star"/></div><div class="rating rating-lg"><input type="radio" name="rating-8" class="mask mask-star-2 bg-orange-400" aria-label="1 star"/><input type="radio" name="rating-8" class="mask mask-star-2 bg-orange-400" checked aria-label="2 star"/><input type="radio" name="rating-8" class="mask mask-star-2 bg-orange-400" aria-label="3 star"/><input type="radio" name="rating-8" class="mask mask-star-2 bg-orange-400" aria-label="4 star"/><input type="radio" name="rating-8" class="mask mask-star-2 bg-orange-400" aria-label="5 star"/></div><div class="rating rating-xl"><input type="radio" name="rating-9" class="mask mask-star-2 bg-orange-400" aria-label="1 star"/><input type="radio" name="rating-9" class="mask mask-star-2 bg-orange-400" checked aria-label="2 star"/><input type="radio" name="rating-9" class="mask mask-star-2 bg-orange-400" aria-label="3 star"/><input type="radio" name="rating-9" class="mask mask-star-2 bg-orange-400" aria-label="4 star"/><input type="radio" name="rating-9" class="mask mask-star-2 bg-orange-400" aria-label="5 star"/></div></div></div></div>
		</div>
	case "textarea":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4 flex flex-col gap-3"><textarea class="textarea" placeholder="Type here"></textarea><textarea class="textarea" aria-label="Textarea">I have already written something for you</textarea></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Disabled</div><div class="mt-4 flex flex-col gap-3"><textarea class="textarea" aria-label="Textarea" placeholder="Type here">disabled=""&gt;</textarea><textarea class="textarea" aria-label="Textarea" disabled>I have already written something for you</textarea></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Ghost</div><div class="mt-4 flex flex-col gap-3"><textarea class="textarea textarea-ghost" placeholder="Touch to write"></textarea><textarea class="textarea" aria-label="Textarea" disabled>{"I'm ghost, you can't touch me 👻"}</textarea></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Fieldset</div><div class="mt-4 flex flex-col gap-3"><fieldset class="fieldset"><legend class="fieldset-legend">What is your bio?</legend><textarea class="textarea" aria-label="Textarea" placeholder="Type here"></textarea><p class="fieldset-label">{"Don't worry, we never share anything with others"}</p></fieldset></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div><div class="mt-4 grid gap-6 *:w-full md:grid-cols-2"><textarea class="textarea textarea-primary" placeholder="Type here" aria-label="Textarea"></textarea><textarea class="textarea textarea-secondary" placeholder="Type here" aria-label="Textarea"></textarea><textarea class="textarea textarea-accent" placeholder="Type here" aria-label="Textarea"></textarea><textarea class="textarea textarea-success" placeholder="Type here" aria-label="Textarea"></textarea><textarea class="textarea textarea-warning" placeholder="Type here" aria-label="Textarea"></textarea><textarea class="textarea textarea-info" placeholder="Type here" aria-label="Textarea"></textarea><textarea class="textarea textarea-error" placeholder="Type here" aria-label="Textarea"></textarea><textarea class="textarea textarea-neutral" placeholder="Type here" aria-label="Textarea"></textarea></div></div></div>
		</div>
	case "validator":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Email</div><div class="mt-4"><label class="input validator"><span class="iconify lucide--mail text-base-content/60 size-5"></span><input class="" required placeholder="mail@site.com" type="email"/></label><div class="validator-hint">Enter valid email address</div></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Phone Number</div><div class="mt-4"><label class="input validator"><span class="iconify lucide--smartphone text-base-content/60 size-5"></span><input class="tabular-nums" required placeholder="Phone" pattern="[0-9]*" minlength="10" maxlength="10" title="Must be 10 digits" type="tel"/></label><p class="validator-hint">Must be 10 digits</p></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Date Validator</div><div class="mt-4"><label class="input validator"><span class="iconify lucide--calendar text-base-content/60 size-5"></span><input required placeholder="Pick a date in 2025" min="2025-01-01" max="2025-12-31" title="Must be valid date" type="date"/></label><p class="validator-hint">Must be 2025</p></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Time Validator</div><div class="mt-4"><label class="input validator"><span class="iconify lucide--clock text-base-content/60 size-5"></span><input min="09:00" max="18:00" aria-label="Input" type="time"/></label><p class="validator-hint">Use only office time (9 AM to 6 PM)</p></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Username</div><div class="mt-4"><label class="input validator"><span class="iconify lucide--user text-base-content/60 size-5"></span><input required placeholder="Username" pattern="[A-Za-z][A-Za-z0-9\-]*" minlength="3" maxlength="30" title="Only letters, numbers or dash" type="text"/></label><p class="validator-hint">Must be 3 to 30 characters<br/>containing only letters, numbers or dash</p></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">URL</div><div class="mt-4"><label class="input validator"><span class="iconify lucide--link text-base-content/60 size-4"></span><input required placeholder="https://" pattern="^(https?://)?([a-zA-Z0-9]([a-zA-ZäöüÄÖÜ0-9\-].*[a-zA-Z0-9])?\.)+[a-zA-Z].*$" title="Must be valid URL" type="url" value="https://"/></label><p class="validator-hint">Must be valid URL</p></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Checkbox</div><div class="mt-4"><input class="checkbox checkbox-primary validator" required title="Required" type="checkbox"/><p class="validator-hint">Required</p></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Toggle</div><div class="mt-4"><input class="toggle toggle-primary validator" required title="Required" type="checkbox"/><p class="validator-hint">Required</p></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Password</div><div class="mt-4"><label class="input validator"><span class="iconify lucide--key-round text-base-content/60 size-5"></span><input required minlength="8" pattern="(?=.*d)(?=.*[a-z])(?=.*[A-Z]).{8,}" title="Must be more than 8 characters, including number, lowercase letter, uppercase letter" type="password"/></label><p class="validator-hint">Must be more than 8 characters, including<br/>At least one number<br/>At least one lowercase letter<br/>At least one uppercase letter</p></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Form select</div><div class="mt-4"><form><select class="select validator w-64" required aria-label="Select"><option disabled value="" selected>Choose:</option><option>Tabs</option><option>Spaces</option></select><p class="validator-hint">Required</p><div class="mt-1 flex gap-3"><button class="btn" type="reset">Clear</button><button class="btn btn-primary" type="submit">Submit form</button></div></form></div></div></div>
		</div>
	default: <div class="text-center py-8 text-base-content/40">Form demo: { name }</div>
	}
}
