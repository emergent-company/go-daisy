			</div></div>
		</div>
	case "timeline":
		<div class="mt-6 grid gap-6 xl:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div>
				<div class="mt-4 overflow-auto"><ul class="timeline">
					<li><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">First Macintosh computer</div><hr/></li>
					<li><hr/><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iMac</div><hr/></li>
					<li><hr/><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iPod</div><hr/></li>
					<li><hr/><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iPhone</div><hr/></li>
					<li><hr/><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">Apple Watch</div></li>
				</ul></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Top side</div>
				<div class="mt-4 overflow-auto"><ul class="timeline">
					<li><div class="timeline-start timeline-box">First Macintosh computer</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr/></li>
					<li><hr/><div class="timeline-start timeline-box">iMac</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr/></li>
					<li><hr/><div class="timeline-start timeline-box">iPod</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr/></li>
					<li><hr/><div class="timeline-start timeline-box">iPhone</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr/></li>
					<li><hr/><div class="timeline-start timeline-box">Apple Watch</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div></li>
				</ul></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Label</div>
				<div class="mt-4 overflow-auto"><ul class="timeline">
					<li><div class="timeline-start">1984</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">First Macintosh computer</div><hr/></li>
					<li><hr/><div class="timeline-start">1998</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iMac</div><hr/></li>
					<li><hr/><div class="timeline-start">2001</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iPod</div><hr/></li>
					<li><hr/><div class="timeline-start">2007</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iPhone</div><hr/></li>
					<li><hr/><div class="timeline-start">2015</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">Apple Watch</div></li>
				</ul></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Different side</div>
				<div class="mt-4 overflow-auto"><ul class="timeline">
					<li><div class="timeline-start timeline-box">First Macintosh computer</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr/></li>
					<li><hr/><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iMac</div><hr/></li>
					<li><hr/><div class="timeline-start timeline-box">iPod</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr/></li>
					<li><hr/><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iPhone</div><hr/></li>
					<li><hr/><div class="timeline-start timeline-box">Apple Watch</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div></li>
				</ul></div>
			</div></div>
			<div class="space-y-6">
				<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div>
					<div class="mt-4 overflow-auto"><ul class="timeline">
						<li><div class="timeline-start timeline-box">First Macintosh computer</div><div class="timeline-middle"><div class="text-primary-content bg-primary grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr class="from-primary to-secondary bg-linear-to-r"/></li>
						<li><hr class="bg-secondary"/><div class="timeline-middle"><div class="bg-secondary text-secondary-content grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iMac</div><hr class="from-secondary to-info bg-linear-to-r"/></li>
						<li><hr class="bg-info"/><div class="timeline-start timeline-box">iPod</div><div class="timeline-middle"><div class="bg-info text-info-content grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr class="from-success to-success bg-linear-to-r"/></li>
						<li><hr class="bg-success"/><div class="timeline-middle"><div class="bg-success text-success-content grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iPhone</div><hr class="from-success to-base-300 bg-linear-to-r"/></li>
						<li><hr/><div class="timeline-start timeline-box">Apple Watch</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div></li>
					</ul></div>
				</div></div>
				<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Without icon</div>
					<div class="mt-4 overflow-auto"><ul class="timeline">
						<li><div class="timeline-start timeline-box">First Macintosh computer</div><hr/></li>
						<li><hr/><div class="timeline-end timeline-box">iMac</div><hr/></li>
						<li><hr/><div class="timeline-start timeline-box">iPod</div><hr/></li>
						<li><hr/><div class="timeline-end timeline-box">iPhone</div><hr/></li>
						<li><hr/><div class="timeline-start timeline-box">Apple Watch</div></li>
					</ul></div>
				</div></div>
			</div>
			<div class="card card-border bg-base-100 h-fit"><div class="card-body"><div class="card-title">Vertical</div>
				<div class="mt-4 overflow-auto"><ul class="timeline timeline-vertical">
					<li><div class="timeline-start timeline-box">First Macintosh computer</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr/></li>
					<li><hr/><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iMac</div><hr/></li>
					<li><hr/><div class="timeline-start timeline-box">iPod</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><hr/></li>
					<li><hr/><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div><div class="timeline-end timeline-box">iPhone</div><hr/></li>
					<li><hr/><div class="timeline-start timeline-box">Apple Watch</div><div class="timeline-middle"><div class="bg-base-200 grid place-items-center rounded-full p-1"><span class="iconify lucide--check size-3.5"></span></div></div></li>
				</ul></div>
			</div></div>
		</div>
	case "toast":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div>
				<div class="mt-4"><input aria-label="Show" class="btn peer" type="checkbox"/><div class="opacity-0 transition-all peer-checked:opacity-100"><div class="toast"><div class="alert alert-info"><span>New message arrived.</span></div></div></div></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Multiple</div>
				<div class="mt-4"><input aria-label="Show" class="btn peer" type="checkbox"/><div class="opacity-0 transition-all peer-checked:opacity-100"><div class="toast"><div class="alert alert-info"><span>New mail arrived.</span></div><div class="alert alert-success"><span>Message sent successfully.</span></div></div></div></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Playground</div>
				<div class="grid place-items-center py-6"><div class="-mb-16 grid grid-cols-3 place-items-center gap-4">
					<input aria-label="Top start" class="btn peer/top-start w-fit" type="checkbox"/>
					<input aria-label="Top center" class="btn peer/top-center w-fit" type="checkbox"/>
					<input aria-label="Top end" class="btn peer/top-end w-fit" type="checkbox"/>
					<input aria-label="Middle start" class="btn peer/middle-start w-fit" type="checkbox"/>
					<input aria-label="Middle center" class="btn peer/middle-center w-fit" type="checkbox"/>
					<input aria-label="Middle end" class="btn peer/middle-end w-fit" type="checkbox"/>
					<input aria-label="Bottom start" class="btn peer/bottom-start w-fit" type="checkbox"/>
					<input aria-label="Bottom center" class="btn peer/bottom-center w-fit" type="checkbox"/>
					<input aria-label="Bottom end" class="btn peer/bottom-end w-fit" type="checkbox"/>
					<div class="z-[-1] opacity-0 transition-all peer-checked/top-start:z-[50] peer-checked/top-start:opacity-100"><div class="toast toast-top toast-start"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
					<div class="z-[-1] opacity-0 transition-all peer-checked/top-center:z-[50] peer-checked/top-center:opacity-100"><div class="toast toast-top toast-center"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
					<div class="z-[-1] opacity-0 transition-all peer-checked/top-end:z-[50] peer-checked/top-end:opacity-100"><div class="toast toast-top toast-end"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
					<div class="z-[-1] opacity-0 transition-all peer-checked/middle-start:z-[50] peer-checked/middle-start:opacity-100"><div class="toast toast-middle toast-start"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
					<div class="z-[-1] opacity-0 transition-all peer-checked/middle-center:z-[50] peer-checked/middle-center:opacity-100"><div class="toast toast-middle toast-center"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
					<div class="z-[-1] opacity-0 transition-all peer-checked/middle-end:z-[50] peer-checked/middle-end:opacity-100"><div class="toast toast-middle toast-end"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
					<div class="z-[-1] opacity-0 transition-all peer-checked/bottom-start:z-[50] peer-checked/bottom-start:opacity-100"><div class="toast toast-bottom toast-start"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
					<div class="z-[-1] opacity-0 transition-all peer-checked/bottom-center:z-[50] peer-checked/bottom-center:opacity-100"><div class="toast toast-bottom toast-center"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
					<div class="z-[-1] opacity-0 transition-all peer-checked/bottom-end:z-[50] peer-checked/bottom-end:opacity-100"><div class="toast toast-bottom toast-end"><div class="alert alert-info"><span>New message arrived.</span></div></div></div>
				</div></div>
			</div></div>
		</div>
	case "tooltip":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div>
				<div class="mt-4 flex flex-wrap gap-3"><div class="tooltip" data-tip={ "It's tooltip" }><button class="btn">Hover me</button></div><div class="tooltip tooltip-open" data-tip={ "I'm never go" }><button class="btn">Always</button></div></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Position</div>
				<div class="mt-4 flex flex-wrap gap-3"><div class="tooltip tooltip-left" data-tip="Left"><button class="btn">Left</button></div><div class="tooltip tooltip-top" data-tip="Top"><button class="btn">Top</button></div><div class="tooltip tooltip-right" data-tip="Right"><button class="btn">Right</button></div><div class="tooltip tooltip-bottom" data-tip="Bottom"><button class="btn">Bottom</button></div></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div>
				<div class="mt-4 flex flex-wrap gap-3"><div class="tooltip tooltip-primary" data-tip="Primary"><button class="btn btn-primary">Primary</button></div><div class="tooltip tooltip-secondary" data-tip="Secondary"><button class="btn btn-secondary">Secondary</button></div><div class="tooltip tooltip-accent" data-tip="Accent"><button class="btn btn-accent">Accent</button></div><div class="tooltip tooltip-success" data-tip="Success"><button class="btn btn-success">Success</button></div><div class="tooltip tooltip-info" data-tip="Info"><button class="btn btn-info">Info</button></div><div class="tooltip tooltip-warning" data-tip="Warning"><button class="btn btn-warning">Warning</button></div><div class="tooltip tooltip-error" data-tip="Error"><button class="btn btn-error">Error</button></div></div>
			</div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Custom</div>
				<div class="mt-4"><div class="tooltip"><div class="tooltip-content bg-transparent p-0"><div class="card card-border bg-base-100 text-base-content shadow-sm"><div class="card-body p-3"><div class="card-title">Card title</div><p>you can use any element as a tooltip</p></div></div></div><button class="btn">Information</button></div></div>
			</div></div>
		</div>
	default:
		<div class="text-center w-full py-8 text-base-content/40">Component demo: { name }</div>
	}
}

templ renderFormDemo(name string) {
	switch name {
	case "checkbox":
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Default</div><div class="mt-4 flex flex-wrap gap-3"><input type="checkbox" class="checkbox" aria-label="Checkbox example"/><input type="checkbox" class="checkbox" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox" disabled aria-label="Checkbox example"/><input type="checkbox" class="checkbox" checked disabled aria-label="Checkbox example"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Color</div><div class="mt-4 flex flex-wrap gap-3"><input type="checkbox" class="checkbox checkbox-primary" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-secondary" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-accent" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-success" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-info" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-warning" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-error" checked aria-label="Checkbox example"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Size</div><div class="mt-4 flex flex-wrap items-center gap-3"><input type="checkbox" class="checkbox checkbox-xl" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-lg" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-sm" checked aria-label="Checkbox example"/><input type="checkbox" class="checkbox checkbox-xs" checked aria-label="Checkbox example"/></div></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Form Control</div><form class="form-control bg-base-200 rounded-box mt-4 w-64 p-3 px-4"><label class="label flex"><span class="label-text grow cursor-pointer">Remember me</span><input class="checkbox" type="checkbox"/></label></form></div></div>
			<div class="card card-border bg-base-100"><div class="card-body"><div class="card-title">Indeterminate</div><div class="mt-4"><div class="flex flex-wrap gap-3"><input type="checkbox" class="checkbox" id="indeterminate-checkbox" aria-label="Checkbox example"/><input type="checkbox" class="checkbox" disabled id="indeterminate-checkbox-disabled" aria-label="Checkbox example"/></div></div></div></div>
