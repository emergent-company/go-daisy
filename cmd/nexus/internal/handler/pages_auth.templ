package handler

import (
	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

templ LoginPageFull() {
	@layout.PageFull(layout.PageProps{Title: "Login - Nexus", ThemeAttr: ""}) {
		@LoginPage()
	}
}

templ RegisterPageFull() {
	@layout.PageFull(layout.PageProps{Title: "Register - Nexus", ThemeAttr: ""}) {
		@RegisterPage()
	}
}

templ ForgotPasswordPageFull() {
	@layout.PageFull(layout.PageProps{Title: "Forgot Password - Nexus", ThemeAttr: ""}) {
		@ForgotPasswordPage()
	}
}

templ ResetPasswordPageFull() {
	@layout.PageFull(layout.PageProps{Title: "Reset Password - Nexus", ThemeAttr: ""}) {
		@ResetPasswordPage()
	}
}

templ LoginPage() {
	<div class="grid grid-cols-12 overflow-auto sm:h-screen" { devmode.Attrs(ctx, "nexus/LoginPage")... }>
		<div class="bg-[#FFE9D1] dark:bg-[#14181c] lg:col-span-7 xl:col-span-8 2xl:col-span-9 relative overflow-hidden hidden lg:block">
			<img src="/images/auth/auth-hero.png" class="h-full w-full object-cover" alt="Auth Hero"/>
			<div class="absolute right-[20%] bottom-[15%]">
				<div class="card bg-base-100/80 w-64 backdrop-blur-lg shadow-lg">
					<div class="card-body p-4">
						<div class="flex items-center gap-2">
							<div class="avatar"><div class="mask mask-squircle w-10"><img src="/images/avatars/1.png" alt="Avatar"/></div></div>
						</div>
						<p class="text-sm font-medium mt-2">Pouya Saadeghi</p>
						<p class="text-xs text-base-content/60">Creator of daisyUI</p>
						<div class="flex gap-0.5 mt-1">
							@ui.IconSpan("lucide--star text-warning", "size-3")
							@ui.IconSpan("lucide--star text-warning", "size-3")
							@ui.IconSpan("lucide--star text-warning", "size-3")
							@ui.IconSpan("lucide--star text-warning", "size-3")
							@ui.IconSpan("lucide--star text-warning", "size-3")
						</div>
						<p class="text-xs text-base-content/60 mt-1">"This is the ultimate admin dashboard for any React project"</p>
					</div>
				</div>
			</div>
		</div>
		<div class="col-span-12 lg:col-span-5 xl:col-span-4 2xl:col-span-3 flex flex-col justify-center p-6 sm:p-12">
			<div class="flex items-center justify-between mb-6">
				<a href="/" class="text-xl font-bold">Nexus</a>
				@ui.ThemeSwitcher()
			</div>
			<h3 class="text-xl font-medium">Login</h3>
			<p class="text-base-content/70 mt-2 text-sm">Seamless Access, Secure Connection: Your Gateway to a Personalized Experience.</p>
			<div class="mt-6">
				<fieldset class="fieldset">
					<label class="input w-full">@ui.IconSpan("lucide--mail text-base-content/80", "size-5")<input class="grow" placeholder="Email Address" type="email" aria-label="Email Address"/></label>
				</fieldset>
				<fieldset class="fieldset mt-3">
					<label class="input w-full">@ui.IconSpan("lucide--key-round text-base-content/80", "size-5")<input class="grow" placeholder="Password" type="password" aria-label="Password"/></label>
				</fieldset>
				<div class="flex items-center justify-between mt-2">
					<label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" class="checkbox checkbox-sm"/><span class="text-xs">I agree with <a href="#" class="link link-hover link-primary">terms and conditions</a></span></label>
					<a href="/auth/forgot-password" class="text-xs link link-hover">Forgot Password?</a>
				</div>
				<button class="btn btn-primary mt-6 w-full"><span class="iconify lucide--log-in size-4"></span>Login</button>
				<div class="divider text-xs text-base-content/40 my-4">or</div>
				<button class="btn btn-ghost w-full"><img src="https://www.google.com/favicon.ico" class="size-4"/>Login with Google</button>
				<p class="text-center text-xs text-base-content/60 mt-4">Haven't account? <a href="/auth/register" class="link link-hover link-primary">Create One</a></p>
			</div>
		</div>
	</div>
}

templ RegisterPage() {
	<div class="grid grid-cols-12 overflow-auto sm:h-screen" { devmode.Attrs(ctx, "nexus/RegisterPage")... }>
		<div class="bg-[#FFE9D1] dark:bg-[#14181c] lg:col-span-7 xl:col-span-8 2xl:col-span-9 relative overflow-hidden hidden lg:block">
			<img src="/images/auth/auth-hero.png" class="h-full w-full object-cover" alt="Auth Hero"/>
			<div class="absolute right-[20%] bottom-[15%]">
				<div class="card bg-base-100/80 w-64 backdrop-blur-lg shadow-lg">
					<div class="card-body p-4">
						<div class="flex items-center gap-2">
							<div class="avatar"><div class="mask mask-squircle w-10"><img src="/images/avatars/1.png" alt="Avatar"/></div></div>
						</div>
						<p class="text-sm font-medium mt-2">Pouya Saadeghi</p>
						<p class="text-xs text-base-content/60">Creator of daisyUI</p>
						<div class="flex gap-0.5 mt-1">
							@ui.IconSpan("lucide--star text-warning", "size-3")<span class="iconify lucide--star text-warning size-3"></span>@ui.IconSpan("lucide--star text-warning", "size-3")<span class="iconify lucide--star text-warning size-3"></span>@ui.IconSpan("lucide--star text-warning", "size-3")
						</div>
						<p class="text-xs text-base-content/60 mt-1">"This is the ultimate admin dashboard for any React project"</p>
					</div>
				</div>
			</div>
		</div>
		<div class="col-span-12 lg:col-span-5 xl:col-span-4 2xl:col-span-3 flex flex-col justify-center p-6 sm:p-12">
			<div class="flex items-center justify-between mb-6">
				<a href="/" class="text-xl font-bold">Nexus</a>
				@ui.ThemeSwitcher()
			</div>
			<h3 class="text-xl font-medium">Register</h3>
			<p class="text-base-content/70 mt-2 text-sm">Create your account and start building amazing projects today.</p>
			<div class="mt-6">
				<div class="grid grid-cols-2 gap-3">
					<fieldset class="fieldset"><label class="input w-full">@ui.IconSpan("lucide--user text-base-content/80", "size-5")<input class="grow" placeholder="First Name" type="text"/></label></fieldset>
					<fieldset class="fieldset"><label class="input w-full">@ui.IconSpan("lucide--user text-base-content/80", "size-5")<input class="grow" placeholder="Last Name" type="text"/></label></fieldset>
				</div>
				<fieldset class="fieldset mt-3"><label class="input w-full">@ui.IconSpan("lucide--user-square text-base-content/80", "size-5")<input class="grow" placeholder="Username" type="text"/></label></fieldset>
				<fieldset class="fieldset mt-3"><label class="input w-full">@ui.IconSpan("lucide--mail text-base-content/80", "size-5")<input class="grow" placeholder="Email Address" type="email"/></label></fieldset>
				<fieldset class="fieldset mt-3"><label class="input w-full">@ui.IconSpan("lucide--key-round text-base-content/80", "size-5")<input class="grow" placeholder="Password" type="password"/></label></fieldset>
				<label class="flex items-center gap-2 cursor-pointer mt-2"><input type="checkbox" class="checkbox checkbox-sm"/><span class="text-xs">I agree with <a href="#" class="link link-hover link-primary">terms and conditions</a></span></label>
				<button class="btn btn-primary mt-6 w-full"><span class="iconify lucide--user-plus size-4"></span>Register</button>
				<div class="divider text-xs text-base-content/40 my-4">or</div>
				<button class="btn btn-ghost w-full"><img src="https://www.google.com/favicon.ico" class="size-4"/>Register with Google</button>
				<p class="text-center text-xs text-base-content/60 mt-4">Already have an account? <a href="/auth/login" class="link link-hover link-primary">Login</a></p>
			</div>
		</div>
	</div>
}

templ ForgotPasswordPage() {
	<div class="grid grid-cols-12 overflow-auto sm:h-screen" { devmode.Attrs(ctx, "nexus/ForgotPasswordPage")... }>
		<div class="bg-[#FFE9D1] dark:bg-[#14181c] lg:col-span-7 xl:col-span-8 2xl:col-span-9 relative overflow-hidden hidden lg:block">
			<img src="/images/auth/auth-hero.png" class="h-full w-full object-cover" alt="Auth Hero"/>
		</div>
		<div class="col-span-12 lg:col-span-5 xl:col-span-4 2xl:col-span-3 flex flex-col justify-center p-6 sm:p-12">
			<div class="flex items-center justify-between mb-6">
				<a href="/" class="text-xl font-bold">Nexus</a>
				@ui.ThemeSwitcher()
			</div>
			<h3 class="text-xl font-medium">Forgot Password</h3>
			<p class="text-base-content/70 mt-2 text-sm">Enter your email and we'll send you a reset link.</p>
			<div class="mt-6">
				<fieldset class="fieldset"><label class="input w-full">@ui.IconSpan("lucide--mail text-base-content/80", "size-5")<input class="grow" placeholder="Email Address" type="email"/></label></fieldset>
				<label class="flex items-center gap-2 cursor-pointer mt-2"><input type="checkbox" class="checkbox checkbox-sm"/><span class="text-xs">I agree with <a href="#" class="link link-hover link-primary">terms and conditions</a></span></label>
				<button class="btn btn-primary mt-6 w-full"><span class="iconify lucide--mail-plus size-4"></span>Send a reset link</button>
				<p class="text-center text-xs text-base-content/60 mt-4">Back to <a href="/auth/login" class="link link-hover link-primary">Login</a></p>
			</div>
		</div>
	</div>
}

templ ResetPasswordPage() {
	<div class="grid grid-cols-12 overflow-auto sm:h-screen" { devmode.Attrs(ctx, "nexus/ResetPasswordPage")... }>
		<div class="bg-[#FFE9D1] dark:bg-[#14181c] lg:col-span-7 xl:col-span-8 2xl:col-span-9 relative overflow-hidden hidden lg:block">
			<img src="/images/auth/auth-hero.png" class="h-full w-full object-cover" alt="Auth Hero"/>
		</div>
		<div class="col-span-12 lg:col-span-5 xl:col-span-4 2xl:col-span-3 flex flex-col justify-center p-6 sm:p-12">
			<div class="flex items-center justify-between mb-6">
				<a href="/" class="text-xl font-bold">Nexus</a>
				@ui.ThemeSwitcher()
			</div>
			<h3 class="text-xl font-medium">Reset Password</h3>
			<p class="text-base-content/70 mt-2 text-sm">Enter your new password below.</p>
			<div class="mt-6">
				<fieldset class="fieldset"><label class="input w-full">@ui.IconSpan("lucide--key-round text-base-content/80", "size-5")<input class="grow" placeholder="New Password" type="password"/></label></fieldset>
				<fieldset class="fieldset mt-3"><label class="input w-full">@ui.IconSpan("lucide--key-round text-base-content/80", "size-5")<input class="grow" placeholder="Confirm Password" type="password"/></label></fieldset>
				<label class="flex items-center gap-2 cursor-pointer mt-2"><input type="checkbox" class="checkbox checkbox-sm"/><span class="text-xs">I agree with <a href="#" class="link link-hover link-primary">terms and conditions</a></span></label>
				<button class="btn btn-primary mt-6 w-full"><span class="iconify lucide--check size-4"></span>Change Password</button>
				<p class="text-center text-xs text-base-content/60 mt-4">Back to <a href="/auth/login" class="link link-hover link-primary">Login</a></p>
			</div>
		</div>
	</div>
}
