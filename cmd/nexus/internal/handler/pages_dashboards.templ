package handler

import (
	"github.com/emergent-company/go-daisy/components/nav"
	"github.com/emergent-company/go-daisy/components/table"
	"github.com/emergent-company/go-daisy/components/ui"
)

templ EcommerceDashboard() {
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  "Business Overview",
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Dashboards"},
			{Label: "Ecommerce"},
		},
	})
	<div class="mt-6">
		<div class="grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
			@ui.StatCardFeatured(ui.StatCardFeaturedProps{Label: "Revenue", Value: "$587.54", Trend: "10.8%", TrendUp: true, Icon: "lucide--circle-dollar-sign", IconColor: "text-primary", Comparison: "vs. $494.16 last period"})
			@ui.StatCardFeatured(ui.StatCardFeaturedProps{Label: "Sales", Value: "4500", Trend: "21.2%", TrendUp: true, Icon: "lucide--package", IconColor: "text-secondary", Comparison: "vs. 3845 last period"})
			@ui.StatCardFeatured(ui.StatCardFeaturedProps{Label: "Customers", Value: "2242", Trend: "6.8%", TrendUp: false, Icon: "lucide--users", IconColor: "text-info", Comparison: "vs. 2448 last period"})
			@ui.StatCardFeatured(ui.StatCardFeaturedProps{Label: "Spending", Value: "$112.54", Trend: "8.5%", TrendUp: true, Icon: "lucide--eraser", IconColor: "text-warning", Comparison: "vs. $98.14 last period"})
		</div>
		<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-12">
			<div class="xl:col-span-7">
				@ui.ChartCard(ui.ChartCardProps{
					Title:       "Revenue Statistics",
					HeaderClass: "px-6 pt-5",
					Actions:     revenueTabs(),
					Intro:       revenueTotal(),
					Chart:       ui.Chart(ui.ChartProps{ID: "revenue-statics-chart", Type: ui.ChartColumn, RawConfigJSON: nxRevenueStatsConfig}),
				})
			</div>
			<div class="xl:col-span-5">
				<div class="card bg-base-100 shadow">
					<div class="card-body p-0">
						@ui.CardToolbar(ui.CardToolbarProps{
							Title:   "Customer Acquisition",
							Actions: predictionLegend(),
							Class:   "px-5 pt-5",
						})
						<div class="mt-4 py-3">
							<div class="divide-base-300 grid grid-cols-2 gap-5 px-5 sm:grid-cols-3 sm:divide-x">
								<div class="text-center">
									<p>Advertise</p>
									<p class="mt-0.5 text-xl font-medium">$148</p>
									<div class="text-success mt-0.5 inline-flex items-center gap-1">
										<span class="iconify lucide--arrow-up size-3"></span>
										<p class="text-xs">4.78%</p>
									</div>
								</div>
								<div class="hidden text-center sm:block">
									<p>Customers</p>
									<p class="mt-0.5 text-xl font-medium">427</p>
									<div class="text-success mt-0.5 inline-flex items-center gap-1">
										<span class="iconify lucide--arrow-up size-3"></span>
										<p class="text-xs">3.15%</p>
									</div>
								</div>
							</div>
						</div>
						<div class="-mt-25 sm:mx-5">
						@ui.Chart(ui.ChartProps{ID: "customer-acquisition-chart", Type: ui.ChartLine, RawConfigJSON: nxCustomerAcqConfig})
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-5 2xl:grid-cols-12">
			<div class="xl:col-span-3 2xl:col-span-5">
				@table.TableCard(table.TableCardProps{Toolbar: recentOrdersToolbar()}) {
					@table.TableWithProps(table.TableProps{}) {
						@table.TableHead() {
							@table.TableHeadRow() {
								@table.TableSelectAll("Check all orders")
								@table.TableHeadCell("Product")
								@table.TableHeadCell("Price")
								@table.TableHeadCell("Date")
								@table.TableHeadCell("Status")
								@table.TableHeadCell("Action")
							}
						}
						@table.TableBody() {
							@ecomOrderRow("1", "Men's tracking shoes", "$99", "25 Jun 2024", "Delivered", "badge-success")
							@ecomOrderRow("2", "Cocooil body oil", "$75", "22 Jun 2024", "On Going", "badge-info")
							@ecomOrderRow("3", "Freeze Air", "$47", "17 Jun 2024", "Confirmed", "badge-primary")
							@ecomOrderRow("4", "Ladies's shoes", "$52", "23 Jun 2024", "Canceled", "badge-error")
							@ecomOrderRow("10", "Choco's cookie", "$24", "21 Jun 2024", "Waiting", "badge-secondary")
						}
					}
				}
			</div>
			<div class="xl:col-span-2 2xl:col-span-3">
				<div class="card bg-base-100 shadow">
					<div class="card-body pb-3">
						<div class="flex items-center gap-3">
							<span class="iconify lucide--messages-square size-4.5"></span>
							<span class="font-medium">Quick Chat</span>
							<a href="/apps/chat" class="btn btn-outline btn-sm border-line-strong ms-auto">Go To Chat</a>
						</div>
						<div class="-mx-2 mt-2 space-y-0.5">
							@ecomChatItem("1", "Mia Johnson", "11:35 AM", "It's called 'Dreamscape.' A must-watch!")
							@ecomChatItem("2", "Ethan Patel", "09:58 AM", "Just got a new book. Excited to start reading.")
							@ecomChatItem("3", "Sophia Nguyen", "08:20 AM", "How's your day going?")
							@ecomChatItem("4", "Emily Chen", "06:21 PM", "Did you see that amazing sunset yesterday?")
							@ecomChatItem("5", "Kelvin S.", "08:15 AM", "Not sure, what you talking about...")
						</div>
					</div>
				</div>
			</div>
			<div class="xl:col-span-3 2xl:col-span-4">
				@ui.ChartCard(ui.ChartCardProps{
					Title:     "Global Sales (%)",
					Icon:      "lucide--globe-2",
					Actions:   globalSalesOverviewButton(),
					BodyClass: "me-5 -mt-5 mb-1",
					Chart:     ui.Chart(ui.ChartProps{ID: "global-sales-chart", Type: ui.ChartBar, Horizontal: true, RawConfigJSON: nxGlobalSalesConfig}),
				})
			</div>
		</div>
	</div>
}

templ revenueTotal() {
	<div class="mt-3 px-6">
		<div class="flex items-center gap-3">
			<span class="text-4xl font-semibold">$184.78K</span>
			<span class="text-success font-medium">+3.24%</span>
		</div>
		<span class="text-muted text-sm">Total income in this year</span>
	</div>
}

templ recentOrdersToolbar() {
	@table.TableCardHeader() {
		<span class="iconify lucide--shopping-bag size-4.5"></span>
		<span class="font-medium">Recent Orders</span>
		<button class="btn btn-outline border-line-strong btn-sm ms-auto">
			<span class="iconify lucide--download size-3.5"></span>
			Report
		</button>
	}
}

templ ecomOrderRow(imgNum, product, price, date, statusLabel, statusClass string) {
	@table.TableRow("", true, nil) {
		@table.TableSelectRow("", false)
		@table.TableCell("flex items-center space-x-3 truncate", nil) {
			<img alt="order image" class="mask mask-squircle bg-base-200 size-7.5" src={ "/images/apps/ecommerce/products/" + imgNum + ".jpg" }/>
			<p>{ product }</p>
		}
		@table.TableCell("font-medium", nil) {
			{ price }
		}
		@table.TableCell("text-xs", nil) {
			{ date }
		}
		@table.TableCell("", nil) {
			<div class={ "badge badge-sm badge-soft", statusClass }>{ statusLabel }</div>
		}
		@table.TableCell("", nil) {
			<div class="flex items-center gap-1">
				<button aria-label="Show product" class="btn btn-square btn-ghost btn-xs"><span class="iconify lucide--eye text-muted size-4"></span></button>
				<button aria-label="Show product" class="btn btn-square btn-error btn-outline btn-xs border-transparent"><span class="iconify lucide--trash size-4"></span></button>
			</div>
		}
	}
}

templ ecomChatItem(imgNum, name, time, message string) {
	<div class="rounded-box hover:bg-base-200 flex cursor-pointer items-center gap-3 px-2 py-2 transition-all active:scale-[.98]">
		<img alt="chat" class="bg-base-200 mask mask-squircle size-11" src={ "/images/avatars/" + imgNum + ".png" }/>
		<div class="grow">
			<div class="flex gap-1">
				<p class="grow">{ name }</p>
				<span class="text-muted text-xs">{ time }</span>
			</div>
			<p class="text-body line-clamp-1 text-sm text-ellipsis">{ message }</p>
		</div>
	</div>
}

templ quickChatItem(name, time, message string) {
	<div class="hover:bg-base-200 rounded-btn flex items-center gap-2 px-2 py-1.5 transition">
		<div class="avatar"><div class="mask mask-squircle w-7 p-0.5"><div class="bg-primary text-primary-content flex size-full items-center justify-center text-[10px] font-semibold">{ initials(name) }</div></div></div>
		<div class="grow min-w-0">
			<div class="flex items-center justify-between gap-1"><p class="truncate text-sm font-medium">{ name }</p><span class="text-xs text-muted">{ time }</span></div>
			<p class="truncate text-xs text-muted">{ message }</p>
		</div>
	</div>
}

// revenueTabs renders the Day/Month/Year period tabs for the Revenue Statistics
// card toolbar.
templ revenueTabs() {
	<div class="tabs tabs-box tabs-xs hidden sm:block">
		<div class="tab false px-3">Day</div>
		<div class="tab false px-3">Month</div>
		<div class="tab tab-active px-3">Year</div>
	</div>
}

// predictionLegend renders the dashed-line "Prediction" legend for the Customer
// Acquisition card toolbar.
templ predictionLegend() {
	<div class="inline-flex items-center gap-2">
		<div class="text-muted w-6 border border-dashed"></div>
		<span class="text-body text-xs">Prediction</span>
	</div>
}

// globalSalesOverviewButton renders the Overview eye button for the Global Sales
// chart card toolbar.
templ globalSalesOverviewButton() {
	<button class="btn btn-ghost btn-outline border-line-strong btn-sm z-1 ms-auto">
		<span class="iconify lucide--eye size-4"></span>
		Overview
	</button>
}

// saleMetricsLegend renders the "2024 vs. 2025" comparison label shown in the
// Sale Metrics chart card header.
templ saleMetricsLegend() {
	<span class="text-muted text-xs">2024 vs. 2025</span>
}

// saleMetricsStats renders the three realtime stat columns (Realtime Sales,
// Revenue, Customer Retention) that sit between the Sale Metrics header and its
// chart. The third column is hidden below the 2xl breakpoint.
templ saleMetricsStats() {
	<div class="mt-5 grid grid-cols-2 justify-between gap-6 px-6 2xl:grid-cols-3">
		<div class="flex flex-col items-center">
			<div class="flex items-center gap-2">
				@ui.StatusDot(ui.StatusSuccess, false)
				<span class="text-body text-sm">Realtime Sales</span>
			</div>
			<span class="mt-2 text-2xl font-semibold">541</span>
			<span class="text-muted text-xs">494 last hour</span>
		</div>
		<div class="flex flex-col items-center">
			<div class="flex items-center gap-2">
				@ui.StatusDot(ui.StatusSecondary, false)
				<span class="text-body text-sm">Revenue</span>
			</div>
			<span class="mt-2 text-2xl font-semibold">$51,474</span>
			<span class="text-muted text-xs">$49,162 last month</span>
		</div>
		<div class="hidden flex-col items-center 2xl:flex">
			<div class="flex items-center gap-2">
				@ui.StatusDot(ui.StatusError, false)
				<span class="text-body text-sm">Customer Retention</span>
			</div>
			<span class="mt-2 text-2xl font-semibold">3.14%</span>
			<span class="text-muted text-xs">2.16% last week</span>
		</div>
	</div>
}

// makeDealButton renders the CTA for the Customer Deals card toolbar.
templ makeDealButton() {
	<button class="btn btn-outline border-line-strong btn-sm">
		<span class="iconify lucide--plus size-3.5"></span>
		Make a Deal
	</button>
}

// dealRow renders a single row of the CRM Customer Deals table.
templ dealRow(img, name, value, statusLabel, statusClass, date string) {
	@table.TableRow("", false, nil) {
		@table.TableCell("flex items-center space-x-3 truncate", nil) {
			<img class="mask mask-squircle bg-base-200 size-7" src={ "/images/avatars/" + img + ".png" } alt={ name }/>
			<p>{ name }</p>
		}
		@table.TableCell("", nil) {
			{ value }
		}
		@table.TableCell("", nil) {
			<div class={ "badge badge-sm badge-soft", statusClass }>{ statusLabel }</div>
		}
		@table.TableCell("", nil) {
			{ date }
		}
		@table.TableCell("", nil) {
			<button class="btn btn-square btn-ghost btn-xs" aria-label="View"><span class="iconify lucide--eye text-body size-4"></span></button>
		}
	}
}

templ CRMDashboard() {
	@nav.PageHeading(nav.PageHeadingProps{
		Title:  "CRM Overview",
		Size:   nav.PageHeadingSizeSM,
		Layout: nav.PageHeadingLayoutSplit,
		Breadcrumbs: []nav.BreadcrumbItem{
			{Label: "Nexus", Href: "/dashboards/ecommerce"},
			{Label: "Dashboards"},
			{Label: "CRM"},
		},
	})
	<div class="mt-6">
		<div class="grid grid-cols-12 gap-5">
			<div class="col-span-12 md:col-span-4 xl:col-span-3 2xl:col-span-2">
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-1">
					@ui.StatCardFeatured(ui.StatCardFeaturedProps{Layout: ui.StatCardFeaturedLayoutCompact, Icon: "lucide--users", Label: "Customers", Value: "4,235", Trend: "8.04%", TrendUp: true})
					@ui.StatCardFeatured(ui.StatCardFeaturedProps{Layout: ui.StatCardFeaturedLayoutCompact, Icon: "lucide--dollar-sign", Label: "Revenue", Value: "$75,400", Trend: "15.3%", TrendUp: true})
					@ui.StatCardFeatured(ui.StatCardFeaturedProps{Layout: ui.StatCardFeaturedLayoutCompact, Icon: "lucide--handshake", Label: "Closed Deals", Value: "574", Trend: "-2.4%", TrendUp: false})
					@ui.StatCardFeatured(ui.StatCardFeaturedProps{Layout: ui.StatCardFeaturedLayoutCompact, Icon: "lucide--smile", Label: "Satisfaction", Value: "93%", Trend: "2.3%", TrendUp: true})
				</div>
			</div>
			<div class="col-span-12 md:col-span-8 xl:col-span-6 2xl:col-span-7">
				@ui.ChartCard(ui.ChartCardProps{
					Title:       "Sale Metrics",
					TitleClass:  "text-lg",
					Legend:      saleMetricsLegend(),
					Intro:       saleMetricsStats(),
					HeaderClass: "px-6 pt-5",
					Chart:       ui.Chart(ui.ChartProps{ID: "sale-metrics-chart", Type: ui.ChartColumn, RawConfigJSON: nxCRMSaleMetricsConfig}),
					BodyClass:   "mt-3.5 overflow-hidden rounded-xl ps-5",
				})
			</div>
			<div class="col-span-12 xl:col-span-3">
				<div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-1">
					<div class="col-span-1">
						@premiumCard()
					</div>
					<div class="col-span-1">
						@goalStatusCard()
					</div>
				</div>
			</div>
		</div>
		<div class="mt-5 grid grid-cols-1 gap-5 xl:grid-cols-2 2xl:grid-cols-3">
			<div class="col-span-1">
				@socialAcquisitionCard()
			</div>
			<div class="col-span-1">
				@customerDealsCard()
			</div>
			<div class="col-span-1">
				@quickIntegrationCard()
			</div>
		</div>
	</div>
}

// premiumCard renders the "Upgrade to premium" promo card in the CRM right rail.
templ premiumCard() {
	<div class="card bg-base-100 shadow">
		<div class="card-body">
			<p class="text-muted text-xs italic">Upgrade to premium</p>
			<p class="mt-1 leading-tight">Make the better business analytics with Premium Dashboard</p>
			<div class="mt-2 flex items-end justify-between">
				<div class="avatar-group -space-x-3.5">
					@ui.AvatarFull(ui.AvatarProps{Src: "/images/avatars/4.png", Name: "Avatar", Size: ui.AvatarSize7, FrameClass: "bg-base-200"})
					@ui.AvatarFull(ui.AvatarProps{Src: "/images/avatars/5.png", Name: "Avatar", Size: ui.AvatarSize7, FrameClass: "bg-base-200"})
					@ui.AvatarFull(ui.AvatarProps{Src: "/images/avatars/7.png", Name: "Avatar", Size: ui.AvatarSize7, FrameClass: "bg-base-200"})
					@ui.AvatarFull(ui.AvatarProps{Src: "/images/avatars/8.png", Name: "Avatar", Size: ui.AvatarSize7, FrameClass: "bg-base-200"})
				</div>
				<button class="btn btn-sm btn-outline btn-neutral">Pay Monthly $29</button>
			</div>
		</div>
	</div>
}

// goalStatusCard renders the Goal Status card in the CRM right rail.
templ goalStatusCard() {
	<div class="card bg-base-100 shadow">
		<div class="card-body">
			@ui.CardToolbar(ui.CardToolbarProps{
				Title:    "Goal Status",
				Subtitle: "(Nearly Finished)",
			})
			<div class="mt-3 flex items-center gap-6">
				@ui.RadialProgress(ui.ProgressColor("primary"), 76, "w-32 h-32", "10px")
				<div><p class="text-2xl font-bold">76%</p><p class="text-sm text-muted">You're completed 80% of yearly goal</p></div>
			</div>
			<div class="mt-4">
				<div class="flex items-center justify-between text-sm"><span>Budget Spent</span><span class="font-semibold">$22500<span class="text-muted font-normal">/$30000</span></span></div>
				@ui.Progress(ui.ProgressColor("primary"), 75, 100, nil)
			</div>
			<div class="mt-4 text-end"><a href="#" class="btn btn-ghost btn-sm">Change Goal</a></div>
		</div>
	</div>
}

// socialAcquisitionCard renders the Social Acquisition chart card in the CRM
// bottom row.
templ socialAcquisitionCard() {
	@ui.ChartCard(ui.ChartCardProps{
		Title: "Social Acquisition",
		Icon:  "lucide--megaphone",
		Chart: ui.Chart(ui.ChartProps{
			ID: "crm-social-chart", Type: ui.ChartBar, Height: "300", Horizontal: true,
			Series: []ui.ChartSeries{
				{Name: "Sales", Data: []float64{48,35,10,7}},
			},
			Categories: []string{"Facebook","Instagram","Whatsapp","LinkedIn"},
			Colors: []string{"#167bff","#a855f7","#06b6d4","#22c55e"},
			StrokeWidth: 0, FillOpacity: 1.0}),
	})
}

// customerDealsCard renders the Customer Deals table card in the CRM bottom row.
templ customerDealsCard() {
	<div class="card bg-base-100 shadow">
		<div class="card-body p-0">
			@ui.CardToolbar(ui.CardToolbarProps{
				Title: "Customer Deals",
				Icon:  "lucide--handshake",
				Actions: makeDealButton(),
				Class:   "px-5 pt-5",
			})
			<div class="mt-1 overflow-x-auto">
				@table.TableWithProps(table.TableProps{}) {
					@table.TableHead() {
						@table.TableHeadRow() {
							@table.TableHeadCell("Customer")
							@table.TableHeadCell("Value")
							@table.TableHeadCell("Status")
							@table.TableHeadCell("Date")
							@table.TableHeadCell("Action")
						}
					}
					@table.TableBody() {
						@dealRow("1", "John Doe", "$50,000", "Completed", "badge-success", "16 Dec")
						@dealRow("2", "Jane Smith", "$12,240", "Pending", "badge-warning", "21 June")
						@dealRow("3", "Rahul Kumar", "$87,452", "Completed", "badge-success", "15 Aug")
						@dealRow("4", "Emily Davis", "$65,357", "Completed", "badge-success", "17 Nov")
						@dealRow("5", "Akash Singh", "$35,769", "Canceled", "badge-error", "30 Jan")
					}
				}
			</div>
		</div>
	</div>
}

// quickIntegrationCard renders the Quick Integration list card in the CRM
// bottom row.
templ quickIntegrationCard() {
	<div class="card bg-base-100 shadow">
		<div class="card-body">
			<div class="flex items-center gap-2">
				<span class="iconify lucide--unplug text-body size-4.5"></span>
				<p class="grow font-medium">Quick Integration</p>
				<button class="btn btn-ghost btn-sm border-line-strong"><span class="iconify lucide--settings-2 size-3.5"></span> Manage</button>
			</div>
			<div class="mt-4 space-y-3.5">
				@quickIntegrationRow("/images/brand-logo/salesforce.svg", "Salesforce", "Salesforce provides customer relationship management software and application focused on sales", "Connect", "btn-error")
				@quickIntegrationRow("/images/brand-logo/asana.svg", "Asana", "Track, manage and connect your project across any team.", "Disconnect", "btn-primary")
				@quickIntegrationRow("/images/brand-logo/slack.svg", "Slack", "Slack is a new way to communicate with your team.", "Connect", "btn-error")
				@quickIntegrationRow("/images/brand-logo/notion.svg", "Notion", "Notion is a freemium productivity and note-taking web application developed by Notion Lab Inc.", "Disconnect", "btn-primary")
				@quickIntegrationRow("/images/brand-logo/hubspot.svg", "Hubspot", "Hubspot is a CRM platform with all the software, integrations and resources you need to connect", "Disconnect", "btn-primary")
			</div>
		</div>
	</div>
}

// quickIntegrationRow renders a single Quick Integration entry (logo, name,
// description, connect/disconnect action).
templ quickIntegrationRow(logo, name, description, actionLabel, actionClass string) {
	<div class="flex items-center gap-3">
		<img alt={ name } class="bg-base-200 mask mask-squircle size-11 p-2" src={ logo }/>
		<div class="grow"><p class="leading-none font-medium">{ name }</p><p class="text-body line-clamp-1 text-sm">{ description }</p></div>
		<button class={ "btn btn-xs btn-soft", actionClass }>{ actionLabel }</button>
	</div>
}
