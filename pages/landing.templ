package pages

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

// landingBrand returns brand name with default.
func landingBrand(s string) string {
	if s == "" {
		return "go-daisy"
	}
	return s
}

// landingTagline returns tagline with default.
func landingTagline(s string) string {
	if s == "" {
		return "Type-safe Templ components styled with DaisyUI"
	}
	return s
}

// LandingPage renders a full landing page with hero, features, and pricing.
templ LandingPage(props LandingPageProps) {
	<div class="min-h-screen" { devmode.Attrs(ctx, "pages/LandingPage")... }>
		<nav class="border-b border-base-200 bg-base-100/80 backdrop-blur-sm sticky top-0 z-10">
			<div class="max-w-6xl mx-auto flex items-center justify-between px-6 h-16">
				<a href="#" class="text-xl font-bold text-base-content">{ landingBrand(props.BrandName) }</a>
				<div class="flex items-center gap-6 text-sm">
					<a href="#" class="link link-hover text-base-content/60 hover:text-base-content">Features</a>
					<a href="#" class="link link-hover text-base-content/60 hover:text-base-content">Pricing</a>
					<a href="#" class="link link-hover text-base-content/60 hover:text-base-content">Docs</a>
					@ui.ThemeToggle(ui.ThemeToggleProps{})
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLink, Href: "#", Variant: ui.ButtonPrimary, Size: ui.ButtonSM, Glow: true}) {
						Get Started
					}
				</div>
			</div>
		</nav>

		<section class="max-w-6xl mx-auto px-6 py-24 text-center">
			<h1 class="text-5xl font-black text-base-content mb-4">
				Build faster with
				<br />
				@ui.GradientText(ui.GradientTextProps{Text: landingBrand(props.BrandName), FromColor: "from-primary", ToColor: "to-secondary", Size: "text-5xl", Weight: "font-black", Animate: true})
			</h1>
			<p class="text-xl text-base-content/60 max-w-2xl mx-auto mb-8">{ landingTagline(props.Tagline) }</p>
			<div class="flex items-center justify-center gap-4">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLink, Href: "#", Variant: ui.ButtonPrimary, Size: ui.ButtonLG, Glow: true}) {
					Get started free
				}
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLink, Href: "#", Variant: ui.ButtonOutline, Size: ui.ButtonLG}) {
					View on GitHub
				}
			</div>
		</section>

		<section class="max-w-6xl mx-auto px-6 py-16">
			<h2 class="text-3xl font-bold text-center text-base-content mb-12">Everything you need</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				@featureCard("lucide--puzzle", "65+ Components", "Every DaisyUI component wrapped as type-safe Templ components.")
				@featureCard("lucide--zap", "HTMX-Ready", "Built for HTMX with partial rendering, OOB swaps, and event wiring.")
				@featureCard("lucide--palette", "Themable", "Full DaisyUI theme support with light, dark, and custom themes.")
				@featureCard("lucide--code-2", "Type-Safe", "Go types for all component props — no runtime errors.")
				@featureCard("lucide--rocket", "Live Gallery", "Interactive component browser with live prop editing.")
				@featureCard("lucide--users", "Growing Ecosystem", "New components added regularly by the community.")
			</div>
		</section>

		<section class="bg-base-200 py-16">
			<div class="max-w-6xl mx-auto px-6">
				<h2 class="text-3xl font-bold text-center text-base-content mb-12">Loved by developers</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					@ui.TestimonialCard(ui.TestimonialCardProps{
						Quote: "The best Go UI library I've used. The HTMX integration is flawless.",
						Name: "Sarah Chen", Role: "Backend Engineer", Rating: 5, RatingColor: "bg-orange-400",
					})
					@ui.TestimonialCard(ui.TestimonialCardProps{
						Quote: "Type safety + DaisyUI = a match made in heaven. Saved us weeks of work.",
						Name: "Marcus Rivera", Role: "Full-Stack Developer", Rating: 5, RatingColor: "bg-orange-400",
					})
					@ui.TestimonialCard(ui.TestimonialCardProps{
						Quote: "The interactive gallery alone is worth it. Incredible DX.",
						Name: "Emily Watson", Role: "Tech Lead", Rating: 4, RatingColor: "bg-orange-400",
					})
				</div>
			</div>
		</section>

		<section class="max-w-6xl mx-auto px-6 py-16">
			<h2 class="text-3xl font-bold text-center text-base-content mb-12">Simple pricing</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
				@pricingCard("Starter", "$0", "Free forever", []string{"All components", "Community support", "MIT license"}, false)
				@pricingCard("Pro", "$29", "/month", []string{"Everything in Starter", "Priority support", "Custom themes", "Early access"}, true)
				@pricingCard("Enterprise", "$99", "/month", []string{"Everything in Pro", "Dedicated support", "Custom components", "SLA guarantee"}, false)
			</div>
		</section>

		<footer class="border-t border-base-200 py-8">
			<div class="max-w-6xl mx-auto px-6 text-center text-sm text-base-content/50">
				<p>&copy; 2026 { landingBrand(props.BrandName) }. Built with DaisyUI and Go.</p>
			</div>
		</footer>
	</div>
}

templ featureCard(icon, title, description string) {
	<div class="card bg-base-100 border border-base-200 shadow-sm">
		<div class="card-body p-6">
			@ui.IconSpan(icon, "size-8 text-primary mb-2")
			<h3 class="text-lg font-semibold text-base-content">{ title }</h3>
			<p class="text-sm text-base-content/60">{ description }</p>
		</div>
	</div>
}

templ pricingCard(name, price, period string, features []string, highlighted bool) {
	<div class={ "card border shadow-sm",
		templ.KV("bg-primary text-primary-content", highlighted),
		templ.KV("bg-base-100 border-base-200", !highlighted) }>
		<div class="card-body p-6 text-center">
			<h3 class="text-lg font-semibold">{ name }</h3>
			<p class={ "text-4xl font-black mt-2", templ.KV("text-base-content", !highlighted) }>{ price }</p>
			<p class={ "text-sm mt-1", templ.KV("text-primary-content/60", highlighted), templ.KV("text-base-content/50", !highlighted) }>{ period }</p>
			<ul class="mt-6 space-y-2 text-left">
				for _, f := range features {
					<li class="flex items-center gap-2 text-sm">
						@ui.IconSpan("lucide--check", "size-4 text-success")
						{ f }
					</li>
				}
			</ul>
			<div class="mt-6">
				@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLink, Href: "#", Variant: ui.ButtonPrimary, Size: ui.ButtonMD, Block: true}) {
					{ ternary(name == "Enterprise", "Contact sales", "Get started") }
				}
			</div>
		</div>
	</div>
}

