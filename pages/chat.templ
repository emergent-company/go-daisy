package pages

import (
	"github.com/emergent-company/go-daisy/components/form"
	ui "github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

// ChatLayout renders a full chat interface with conversation sidebar and message area.
templ ChatLayout(props ChatLayoutProps) {
	<div class="flex h-[calc(100vh-8rem)] gap-4" { devmode.Attrs(ctx, "pages/ChatLayout")... }>
		<div class="w-72 shrink-0 flex flex-col border border-base-200 rounded-box bg-base-100">
			<div class="p-3 border-b border-base-200">
				@form.SearchInput("chat-search", "", "Search conversations...", "", "#", "input-sm")
			</div>
			<div class="flex-1 overflow-y-auto divide-y divide-base-200">
				@conversationItem("Alice Johnson", "Sounds good! Let me know when...", "2 min ago", true, true)
				@conversationItem("Bob Smith", "The report is ready for review", "1 hour ago", false, false)
				@conversationItem("Carol White", "Can we reschedule?", "3 hours ago", false, false)
				@conversationItem("Dave Miller", "Thanks for the update", "Yesterday", false, false)
			</div>
		</div>

		<div class="flex-1 flex flex-col border border-base-200 rounded-box bg-base-100">
			<div class="flex items-center gap-3 p-4 border-b border-base-200">
				@ui.Avatar("Alice Johnson", "", "", ui.AvatarSM, "", nil)
				<div>
					<p class="text-sm font-semibold text-base-content">Alice Johnson</p>
					<p class="text-xs text-base-content/50">Online</p>
				</div>
			</div>

			<div class="flex-1 overflow-y-auto p-4 space-y-4">
				@ui.ChatBubble(false, "Alice Johnson", "10:32 AM", "", false, "bg-base-200", false, nil) {
					Hey! How are you doing?
				}
				@ui.ChatBubble(true, "You", "10:33 AM", "", false, "bg-base-200", false, nil) {
					Good thanks! How about you?
				}
				@ui.ChatBubble(false, "Alice Johnson", "10:34 AM", "", false, "bg-base-200", false, nil) {
					Just finished reviewing the documents. Have you had a chance to look at them?
				}
				@ui.AIThinkingIndicator()
			</div>

			<div class="p-4 border-t border-base-200">
				@ui.ChatInput(true, "Type a message...", nil)
			</div>
		</div>
	</div>
}

templ conversationItem(name, lastMessage, time string, active, unread bool) {
	<div class={ "flex items-center gap-3 px-3 py-3 cursor-pointer",
		templ.KV("bg-base-200", active),
		templ.KV("hover:bg-base-200", !active) }>
		@ui.Avatar(name, "", "", ui.AvatarSM, "", nil)
		<div class="flex-1 min-w-0">
			<div class="flex items-center justify-between">
				<p class={ "text-sm truncate", templ.KV("font-semibold", unread) }>{ name }</p>
				<span class="text-xs text-base-content/40 shrink-0">{ time }</span>
			</div>
			<p class={ "text-xs truncate mt-0.5", templ.KV("text-base-content/50", !unread), templ.KV("text-base-content/70 font-medium", unread) }>{ lastMessage }</p>
		</div>
		if unread {
			<span class="badge badge-primary badge-xs"></span>
		}
	</div>
}
