package galleryruntime

import (
	"encoding/json"

	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/ui"
)

// searchItem is the minimal shape serialised into the inline JS search index.
type searchItem struct {
	Slug        string `json:"slug"`
	Name        string `json:"name"`
	Category    string `json:"category"`
	Subcategory string `json:"sub"`
	Type        string `json:"type"` // "component" or "group"
}

// gallerySearchIndex builds a JSON-encoded list of all components and category groups
// for client-side search.
func gallerySearchIndex(categories []CategoryGroup) string {
	var items []searchItem
	for _, group := range categories {
		items = append(items, searchItem{
			Slug:     "group/" + SlugifyCategory(string(group.Name)),
			Name:     string(group.Name),
			Category: string(group.Name),
			Type:     "group",
		})
		for _, sub := range group.Subcategories {
			if sub.Name != "" {
				items = append(items, searchItem{
					Slug:     "group/" + SlugifyCategory(string(group.Name)) + "/" + Slugify(sub.Name),
					Name:     sub.Name,
					Category: string(group.Name),
					Type:     "subgroup",
				})
			}
			for _, comp := range sub.Components {
				items = append(items, searchItem{
					Slug:        comp.Slug,
					Name:        comp.Name,
					Category:    string(group.Name),
					Subcategory: sub.Name,
					Type:        "component",
				})
			}
		}
	}
	b, _ := json.Marshal(items)
	return string(b)
}

// GalleryPage renders the full gallery shell with sidebar and content area.
// Use for direct browser navigation (non-HTMX requests).
templ GalleryPage(title string, activeSlug string, categories []CategoryGroup, logo templ.Component, content templ.Component) {
	@layout.Page(title + " · Gallery", "") {
		@layout.AppShell(title) {
			<!-- Sidebar -->
			<div id="_layout-sidebar" class="flex flex-col bg-base-100">
				<!-- Header: logo or title -->
				<div class="flex min-h-10 items-center justify-between gap-3 px-5 py-3 shrink-0">
					<a href="/gallery" class="truncate">
						if logo != nil {
							@logo
						} else {
							<span class="text-xl font-semibold">{ title }</span>
						}
					</a>
					<!-- Fold / unfold toggle (desktop only) -->
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeLabel, Variant: ui.ButtonGhost, Size: ui.ButtonSM, Shape: ui.ButtonShapeCircle, ExtraClass: "text-base-content/50 max-lg:hidden", Attrs: templ.Attributes{"for": "_layout-sidebar-toggle-trigger", "title": "Toggle sidebar"}}) {
						@ui.IconSpan("lucide--panel-left-close", "size-4.5")
					}
				</div>
				<!-- Nav menu: 3-level hierarchy (Category > Subcategory > Component) -->
				<div class="sidebar-menu grow overflow-y-auto px-2.5 py-2">
					for _, group := range categories {
						<div class="mb-2">
							<a
								href={ templ.URL("/gallery/group/" + SlugifyCategory(string(group.Name))) }
								hx-get={ "/gallery/group/" + SlugifyCategory(string(group.Name)) }
								hx-target="#gallery-content"
								hx-swap="innerHTML"
								hx-push-url="true"
								class="menu-label px-2.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-base-content/50 hover:text-base-content/80 transition-colors duration-150 block"
							>
								{ string(group.Name) }
							</a>
							<div class="space-y-0.5 ms-2">
							for _, sub := range group.Subcategories {
								if sub.Name != "" {
									<a
										href={ templ.URL("/gallery/group/" + SlugifyCategory(string(group.Name)) + "/" + Slugify(sub.Name)) }
										hx-get={ "/gallery/group/" + SlugifyCategory(string(group.Name)) + "/" + Slugify(sub.Name) }
										hx-target="#gallery-content"
										hx-swap="innerHTML"
										hx-push-url="true"
										class="px-2.5 pt-2 pb-0.5 text-[11px] font-medium uppercase tracking-wide text-base-content/50 hover:text-primary transition-colors duration-150 block"
									>
										{ sub.Name }
									</a>
									<div class="pl-3 space-y-0.5">
										for _, comp := range sub.Components {
											<a
												href={ templ.URL("/gallery/" + comp.Slug) }
												hx-get={ "/gallery/" + comp.Slug }
												hx-target="#gallery-content"
												hx-swap="innerHTML"
												hx-push-url="true"
												class={ "menu-item text-sm",
													templ.KV("active", comp.Slug == activeSlug) }
											>
												{ comp.Name }
											</a>
										}
									</div>
								} else {
									for _, comp := range sub.Components {
										<a
											href={ templ.URL("/gallery/" + comp.Slug) }
											hx-get={ "/gallery/" + comp.Slug }
											hx-target="#gallery-content"
											hx-swap="innerHTML"
											hx-push-url="true"
											class={ "menu-item text-sm",
												templ.KV("active", comp.Slug == activeSlug) }
										>
											{ comp.Name }
										</a>
									}
								}
							}
							</div>
						</div>
					}
					<!-- SDK Documentation link -->
					<div class="border-base-200 border-t pt-2 mt-2">
						<a
							href="/gallery/docs"
							hx-get="/gallery/docs"
							hx-target="#gallery-content"
							hx-swap="innerHTML"
							hx-push-url="true"
							class={ "menu-item text-sm",
								templ.KV("active", activeSlug == "docs") }
						>
							@ui.IconSpan("lucide--book-open", "size-4 mr-2")
							SDK Reference
						</a>
					</div>
				</div>
				<!-- Footer note -->
				<div class="border-base-200 px-3 py-3 border-t shrink-0">
					<p class="text-xs text-base-content/40 text-center">DaisyUI component gallery</p>
				</div>
			</div>
			<!-- Right column: topbar + content -->
			<div class="flex min-w-0 grow flex-col overflow-hidden">
				@layout.Navbar("Gallery") {
					<!-- Search trigger (desktop) -->
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Style: ui.ButtonStyleOutline, Size: ui.ButtonSM, ExtraClass: "border-base-300 text-base-content/60 hidden h-9 w-72 justify-start gap-2 md:flex", Attrs: templ.Attributes{"id": "gallery-search-trigger", "aria-label": "Search components", "onclick": "gallerySearchOpen();"}}) {
						@ui.IconSpan("lucide--search", "size-4")
						<span class="grow text-left text-sm">Search components…</span>
						<kbd class="kbd kbd-xs shrink-0">⌘K</kbd>
					}
					<!-- Search trigger (mobile icon only) -->
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Variant: ui.ButtonGhost, Style: ui.ButtonStyleOutline, Size: ui.ButtonSM, Shape: ui.ButtonShapeSquare, ExtraClass: "border-base-300 text-base-content/60 flex size-9 md:hidden", Attrs: templ.Attributes{"aria-label": "Search components", "onclick": "gallerySearchOpen();"}}) {
						@ui.IconSpan("lucide--search", "size-4")
					}
					@ui.ThemeSwitcher()
				}
				<!-- Scrollable content area -->
				<main id="gallery-content" class="grow overflow-y-auto p-0 sm:p-4">
					@content
				</main>
			</div>
		}
		<!-- Gallery spotlight search modal -->
		@gallerySearchModal(categories)
		<!-- feedback-overlay: element-level feedback tool -->
		<script
			src="https://feedback.emergent-company.ai/feedback-overlay.js"
			data-api="https://feedback.emergent-company.ai"
			data-repo="emergent-company/go-daisy"
			data-label="gallery-feedback"
			async
		></script>
	}
}

// gallerySearchModal renders the spotlight-style search modal for the gallery shell.
templ gallerySearchModal(categories []CategoryGroup) {
	<dialog id="gallery-search-modal" class="modal p-0">
		<div class="modal-box p-0 max-w-xl overflow-hidden" role="dialog" aria-label="Search components">
			<!-- Search input row -->
			<div class="border-base-300 flex w-full items-center gap-2 border-b px-4 py-3">
				@ui.IconSpan("lucide--search", "size-4.5")
				<input
					id="gallery-search-input"
					class="grow bg-transparent outline-none focus:outline-none"
					placeholder="Search components…"
					aria-label="Search gallery components"
					type="search"
					autocomplete="off"
				/>
				<form method="dialog">
					@ui.Button(ui.ButtonProps{Type: ui.ButtonTypeButton, Size: ui.ButtonXS, Shape: ui.ButtonShapeCircle, Variant: ui.ButtonGhost, Attrs: templ.Attributes{"aria-label": "Close"}}) {
						@ui.IconSpan("lucide--x", "size-4")
					}
				</form>
			</div>
			<!-- Keyboard hint bar -->
			<div class="border-base-300 bg-base-200/50 flex items-center gap-4 border-b px-4 py-1.5 text-xs text-base-content/50">
				<span><kbd class="kbd kbd-xs">↑</kbd><kbd class="kbd kbd-xs ml-0.5">↓</kbd> Navigate</span>
				<span><kbd class="kbd kbd-xs">↵</kbd> Open</span>
				<span><kbd class="kbd kbd-xs">Esc</kbd> Close</span>
			</div>
			<!-- Results area -->
			<div id="gallery-search-results" class="max-h-[26rem] overflow-y-auto px-2 py-2">
				<ul class="menu w-full gap-0.5" id="gallery-search-list">
					<!-- populated by JS -->
				</ul>
			</div>
			<!-- Footer -->
			<div class="border-base-300 flex items-center justify-between border-t px-4 py-2">
				<span id="gallery-search-count" class="text-xs text-base-content/40"></span>
				<span class="text-xs text-base-content/30">go-daisy</span>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop"><button>close</button></form>
	</dialog>
	<div id="gallery-search-index" data-index={ gallerySearchIndex(categories) } hidden></div>
	<script>
	(function () {
		var INDEX = JSON.parse(document.getElementById('gallery-search-index').dataset.index);

		var modal   = document.getElementById('gallery-search-modal');
		var input   = document.getElementById('gallery-search-input');
		var list    = document.getElementById('gallery-search-list');
		var counter = document.getElementById('gallery-search-count');
		if (!modal) return;

		// Expose open function globally so onclick handlers and ⌘K can call it
		window.gallerySearchOpen = function () {
			render('');
			modal.showModal();
			setTimeout(function () { input.focus(); }, 50);
		};

		// ⌘K / Ctrl+K global shortcut
		document.addEventListener('keydown', function (e) {
			if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
				e.preventDefault();
				window.gallerySearchOpen();
			}
		});

		// Filter on input
		input.addEventListener('input', function () { render(input.value.trim()); });

		// Keyboard navigation inside modal
		modal.addEventListener('keydown', function (e) {
			var items = Array.from(list.querySelectorAll('[data-si]'));
			var cur = items.findIndex(function (el) { return el.classList.contains('si-active'); });
			if (e.key === 'ArrowDown') {
				e.preventDefault();
				activate(items, cur < items.length - 1 ? cur + 1 : 0);
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				activate(items, cur > 0 ? cur - 1 : items.length - 1);
			} else if (e.key === 'Enter' && cur >= 0) {
				e.preventDefault();
				items[cur].querySelector('a').click();
			}
		});

		// Reset on close
		modal.addEventListener('close', function () {
			input.value = '';
			list.innerHTML = '';
			counter.textContent = '';
		});

		function render(query) {
			var q = query.toLowerCase();
			var allResults = q === ''
				? INDEX
				: INDEX.filter(function (c) {
					return c.name.toLowerCase().includes(q)
						|| c.category.toLowerCase().includes(q)
						|| (c.sub || '').toLowerCase().includes(q);
				});

			// Split groups, subgroups, and components
			var groups = allResults.filter(function (c) { return c.type === 'group'; });
			var subgroups = allResults.filter(function (c) { return c.type === 'subgroup'; });
			var comps = allResults.filter(function (c) { return c.type === 'component'; });

			// Group components by category
			var grouped = {};
			var order = [];
			comps.forEach(function (c) {
				if (!grouped[c.category]) { grouped[c.category] = []; order.push(c.category); }
				grouped[c.category].push(c);
			});

			var html = '';

			// Render groups section
			if (groups.length > 0) {
				html += '<li class="menu-title text-xs tracking-wide pb-0.5">Groups</li>';
				groups.forEach(function (g) {
					html += '<li data-si>'
						+ '<a class="flex items-center gap-3 rounded-lg px-2 py-2 hover:bg-base-200"'
						+ ' href="/gallery/' + esc(g.slug) + '"'
						+ ' hx-get="/gallery/' + esc(g.slug) + '"'
						+ ' hx-target="#gallery-content" hx-swap="innerHTML" hx-push-url="true"'
						+ ' onclick="document.getElementById(\'gallery-search-modal\').close();"'
						+ '>'
						+ '<div class="border-base-300 bg-base-100 rounded-box flex size-8 shrink-0 items-center justify-center border">'
						+ '<span class="iconify lucide--layers size-4 text-primary"></span>'
						+ '</div>'
						+ '<div class="grow min-w-0">'
						+ '<p class="truncate font-medium leading-none">' + esc(g.name) + '</p>'
						+ '</div>'
						+ '<span class="si-enter opacity-0 text-xs text-base-content/40 shrink-0">\u21B5</span>'
						+ '</a></li>';
				});
			}

			// Render subgroups section
			if (subgroups.length > 0) {
				html += '<li class="menu-title text-xs tracking-wide pb-0.5">Subcategories</li>';
				subgroups.forEach(function (sg) {
					html += '<li data-si>'
						+ '<a class="flex items-center gap-3 rounded-lg px-2 py-2 hover:bg-base-200"'
						+ ' href="/gallery/' + esc(sg.slug) + '"'
						+ ' hx-get="/gallery/' + esc(sg.slug) + '"'
						+ ' hx-target="#gallery-content" hx-swap="innerHTML" hx-push-url="true"'
						+ ' onclick="document.getElementById(\'gallery-search-modal\').close();"'
						+ '>'
						+ '<div class="border-base-300 bg-base-100 rounded-box flex size-8 shrink-0 items-center justify-center border">'
						+ '<span class="iconify lucide--folder size-4 text-primary"></span>'
						+ '</div>'
						+ '<div class="grow min-w-0">'
						+ '<p class="truncate font-medium leading-none">' + esc(sg.name) + '</p>'
						+ '<p class="mt-0.5 text-xs opacity-60 leading-none">' + esc(sg.category) + '</p>'
						+ '</div>'
						+ '<span class="si-enter opacity-0 text-xs text-base-content/40 shrink-0">\u21B5</span>'
						+ '</a></li>';
				});
			}

			// Render components grouped by category
			order.forEach(function (cat) {
				html += '<li class="menu-title text-xs tracking-wide pb-0.5">' + esc(cat) + '</li>';
				grouped[cat].forEach(function (c) {
					var sub = c.sub ? '<p class="mt-0.5 text-xs opacity-60 leading-none">' + esc(c.sub) + '</p>' : '';
					html += '<li data-si>'
						+ '<a class="flex items-center gap-3 rounded-lg px-2 py-2 hover:bg-base-200"'
						+ ' href="/gallery/' + esc(c.slug) + '"'
						+ ' hx-get="/gallery/' + esc(c.slug) + '"'
						+ ' hx-target="#gallery-content" hx-swap="innerHTML" hx-push-url="true"'
						+ ' onclick="document.getElementById(\'gallery-search-modal\').close();"'
						+ '>'
						+ '<div class="border-base-300 bg-base-100 rounded-box flex size-8 shrink-0 items-center justify-center border">'
						+ '<span class="iconify lucide--component size-4 text-primary"></span>'
						+ '</div>'
						+ '<div class="grow min-w-0">'
						+ '<p class="truncate font-medium leading-none">' + esc(c.name) + '</p>'
						+ sub
						+ '</div>'
						+ '<span class="si-enter opacity-0 text-xs text-base-content/40 shrink-0">\u21B5</span>'
						+ '</a></li>';
				});
			});

			if (!html) {
				html = '<li class="px-3 py-6 text-center text-sm text-base-content/40">No results found</li>';
			}
			list.innerHTML = html;
			counter.textContent = allResults.length + ' result' + (allResults.length === 1 ? '' : 's');
		}

		function activate(items, idx) {
			items.forEach(function (el, i) {
				var hint = el.querySelector('.si-enter');
				if (i === idx) {
					el.classList.add('si-active');
					el.querySelector('a').classList.add('bg-base-200');
					if (hint) { hint.classList.remove('opacity-0'); hint.classList.add('opacity-100'); }
					el.scrollIntoView({ block: 'nearest' });
				} else {
					el.classList.remove('si-active');
					el.querySelector('a').classList.remove('bg-base-200');
					if (hint) { hint.classList.remove('opacity-100'); hint.classList.add('opacity-0'); }
				}
			});
		}

		function esc(s) {
			return String(s)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}
	}());
	</script>
	<script>
	(function() {
		function syncSidebarActive() {
			var curPath = window.location.pathname;
			var found = null;
			document.querySelectorAll('#_layout-sidebar .menu-item').forEach(function(el) {
				var match = el.getAttribute('href') === curPath;
				el.classList.toggle('active', match);
				if (match) found = el;
			});
			if (found) {
				var sidebar = document.getElementById('_layout-sidebar');
				if (!sidebar) return;
				var sidebarRect = sidebar.getBoundingClientRect();
				var itemRect = found.getBoundingClientRect();
				var offset = itemRect.top - sidebarRect.top - 80;
				if (offset < 0 || itemRect.bottom > sidebarRect.bottom) {
					sidebar.scrollTop += offset - 20;
				}
			}
		}
		window.syncSidebarActive = syncSidebarActive;
		// Monkey-patch pushState so sidebar active class syncs on HTMX URL updates.
		var _pushState = history.pushState;
		history.pushState = function() { _pushState.apply(this, arguments); syncSidebarActive(); };
		document.addEventListener('htmx:afterSwap', syncSidebarActive);
		document.addEventListener('DOMContentLoaded', syncSidebarActive);
		window.addEventListener('popstate', syncSidebarActive);
		if (document.readyState !== 'loading') syncSidebarActive();
	})();
	</script>
}

// GalleryPageContent renders only the content area for HTMX partial swaps.
templ GalleryPageContent(title string, activeSlug string, categories []CategoryGroup, logo templ.Component, content templ.Component) {
	@content
}
